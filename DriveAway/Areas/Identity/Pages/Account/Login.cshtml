@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8" style="background-color: #F8FAFC;">
    <div class="max-w-md w-full">
        <!-- Login Card -->
        <div class="bg-white rounded-lg border border-gray-100 p-8">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="mx-auto h-14 w-14 rounded-full flex items-center justify-center mb-4" style="background-color: #1E3A5F;">
                    <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-semibold" style="color: #1E3A5F;">
                    Sign In
                </h2>
                <p class="text-sm mt-1" style="color: #64748B;">
                    DriveAway Rental System
                </p>
            </div>

            <!-- Login Form -->
            <form id="account" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded" role="alert"></div>

                <!-- Email Input -->
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium mb-1" style="color: #1E3A5F;">
                        Email
                    </label>
                    <input asp-for="Input.Email"
                           class="block w-full px-4 py-2.5 border rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors"
                           style="border-color: #E2E8F0;"
                           placeholder="your@email.com"
                           autocomplete="username"
                           aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <!-- Password Input -->
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium mb-1" style="color: #1E3A5F;">
                        Password
                    </label>
                    <input asp-for="Input.Password"
                           class="block w-full px-4 py-2.5 border rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors"
                           style="border-color: #E2E8F0;"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <!-- Remember Me and Forgot Password on same line -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input asp-for="Input.RememberMe"
                               type="checkbox"
                               class="h-4 w-4 rounded border-gray-300 focus:ring-1 focus:ring-[#1E3A5F]"
                               style="accent-color: #FF6B00;" />
                        <label asp-for="Input.RememberMe" class="ml-2 block text-sm" style="color: #475569;">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <a asp-page="./ForgotPassword"
                       class="text-xs transition-colors"
                       style="color: #1E3A5F;"
                       onmouseover="this.style.color='#FF6B00'"
                       onmouseout="this.style.color='#1E3A5F'">
                        Forgot password?
                    </a>
                </div>

                <!-- Submit Button -->
                <div>
                    <button id="login-submit"
                            type="submit"
                            class="w-full py-2.5 px-4 rounded-lg text-sm font-medium text-white transition-colors"
                            style="background-color: #1E3A5F;"
                            onmouseover="this.style.backgroundColor='#FF6B00'"
                            onmouseout="this.style.backgroundColor='#1E3A5F'">
                        Sign In
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}