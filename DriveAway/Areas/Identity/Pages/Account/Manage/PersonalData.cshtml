@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="max-w-5xl mx-auto">
    <h2 class="text-2xl font-semibold mb-6" style="color: #1E3A5F;">Manage Account</h2>

    <div class="flex flex-col md:flex-row gap-6">
        <!-- Main Content -->
        <div class="flex-1 w-full">
            <div class="bg-white rounded-lg border border-gray-100 p-6">
                <h3 class="text-lg font-semibold mb-4" style="color: #1E3A5F;">Personal Data</h3>

                <p class="text-sm text-gray-600 mb-6">
                    Your account contains personal data that you have given us. This page allows you to download or
                    delete that data.
                </p>

                <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 mb-6">
                    <p class="text-sm text-amber-800 font-medium">
                        <strong>Deleting this data will permanently remove your account, and this cannot be
                            recovered.</strong>
                        </p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">
                        <a asp-page="./DeletePersonalData"
                           class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-medium text-white transition-colors"
                           style="background-color: #dc2626;" onmouseover="this.style.backgroundColor='#b91c1c'"
                           onmouseout="this.style.backgroundColor='#dc2626'" onfocus="this.style.backgroundColor='#b91c1c'"
                           onblur="this.style.backgroundColor='#dc2626'">
                            Delete
                        </a>
                        <a asp-page="./DownloadPersonalData"
                           class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-medium text-white transition-colors"
                           style="background-color: #2563eb;" onmouseover="this.style.backgroundColor='#1d4ed8'"
                           onmouseout="this.style.backgroundColor='#2563eb'" onfocus="this.style.backgroundColor='#1d4ed8'"
                           onblur="this.style.backgroundColor='#2563eb'">
                            Download
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
