@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    <div class="mb-4 px-4 py-3 rounded-lg text-sm font-medium @(isError ? "bg-red-50 text-red-700 border border-red-200" : "bg-green-50 text-green-700 border border-green-200")" role="alert">
        @Model
    </div>
}
