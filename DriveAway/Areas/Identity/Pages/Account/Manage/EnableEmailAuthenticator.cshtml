@page
@model EnableEmailAuthenticatorModel
@{
    ViewData["Title"] = "Enable Email Authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="max-w-5xl mx-auto">
    <h2 class="text-2xl font-semibold mb-6" style="color: #1E3A5F;">@ViewData["Title"]</h2>

    <div class="flex flex-col md:flex-row gap-6">
        <div class="flex-1 w-full">
            <div class="bg-white rounded-lg border border-gray-100 p-6">
                <partial name="_StatusMessage" for="StatusMessage" />
                <p class="mb-4 text-gray-700">
                    To proceed, please enter the 6-digit verification code we just sent to your email address.
                    The code will expire in 5 minutes.
                </p>

                <div class="row">
                    <div class="col-md-6">
                        <form id="send-code" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Code" class="form-control" autocomplete="off"
                                       placeholder="Please enter the code." />
                                <label asp-for="Input.Code" class="form-label">Verification Code</label>
                                <span asp-validation-for="Input.Code" class="text-danger"></span>
                            </div>
                            <button type="submit" class="w-100 btn btn-lg text-white" style="background-color: #1E3A5F;"
                                    onmouseover="this.style.backgroundColor='#FF6B00'"
                                    onmouseout="this.style.backgroundColor='#1E3A5F'"
                                    onfocus="this.style.backgroundColor='#FF6B00'"
                                    onblur="this.style.backgroundColor='#1E3A5F'">Verify and Enable</button>
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
