@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="max-w-5xl mx-auto">
    <h2 class="text-2xl font-semibold mb-6" style="color: #1E3A5F;">Manage Account</h2>

    <div class="flex flex-col md:flex-row gap-6">
        <!-- Main Content -->
        <div class="flex-1 w-full">
            <div class="bg-white rounded-lg border border-gray-100 p-6">
                <h3 class="text-lg font-semibold mb-4" style="color: #1E3A5F;">Change Password</h3>

                <partial name="_StatusMessage" for="StatusMessage" />

                <form id="change-password-form" method="post" class="space-y-5">
                    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded" role="alert"></div>

                    <!-- Current Password -->
                    <div>
                        <label asp-for="Input.OldPassword" class="block text-sm font-medium mb-1" style="color: #1E3A5F;">Current password</label>
                        <input asp-for="Input.OldPassword"
                               class="block w-full px-4 py-2.5 border rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors"
                               style="border-color: #E2E8F0;"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                        <span asp-validation-for="Input.OldPassword" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label asp-for="Input.NewPassword" class="block text-sm font-medium mb-1" style="color: #1E3A5F;">New password</label>
                        <input asp-for="Input.NewPassword"
                               class="block w-full px-4 py-2.5 border rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors"
                               style="border-color: #E2E8F0;"
                               placeholder="••••••••"
                               autocomplete="new-password" />
                        <span asp-validation-for="Input.NewPassword" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <!-- Confirm New Password -->
                    <div>
                        <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium mb-1" style="color: #1E3A5F;">Confirm new password</label>
                        <input asp-for="Input.ConfirmPassword"
                               class="block w-full px-4 py-2.5 border rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors"
                               style="border-color: #E2E8F0;"
                               placeholder="••••••••"
                               autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <!-- Submit -->
                    <div>
                        <button id="change-password-button" type="submit"
                                class="px-6 py-2.5 rounded-lg text-sm font-medium text-white transition-colors"
                                style="background-color: #1E3A5F;"
                                onmouseover="this.style.backgroundColor='#FF6B00'"
                                onmouseout="this.style.backgroundColor='#1E3A5F'">
                            Update password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
