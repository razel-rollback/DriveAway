@model IEnumerable<DriveAway.Models.Branch>

@{
    ViewData["Title"] = "Branch Management";
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">

    <!-- Page header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
        <div class="mb-4 sm:mb-0">
            <h1 class="text-2xl md:text-3xl text-gray-800 font-bold">Branch Management</h1>
            <p class="text-gray-500 mt-1">Manage corporate and franchise locations</p>
        </div>
        <div class="grid grid-flow-col sm:auto-cols-max justify-start sm:justify-end gap-2">
            <a asp-action="Create" class="inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2" style="background-color: #FF6B00; hover:background-color: #e66100;">
                <svg class="w-4 h-4 fill-current opacity-50 shrink-0" viewBox="0 0 16 16">
                    <path d="M15 7H9V1c0-.6-.4-1-1-1S7 .4 7 1v6H1c-.6 0-1 .4-1 1s.4 1 1 1h6v6c0 .6.4 1 1 1s1-.4 1-1V9h6c.6 0 1-.4 1-1s-.4-1-1-1z" />
                </svg>
                <span class="ml-2 w-max">Add Branch</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 bg-green-50 border-l-4 border-green-400 p-4">
            <div class="flex">
                <div class="shrink-0">
                    <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-green-700">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        </div>
    }

    <!-- Table container -->
    <div class="bg-white shadow-lg rounded-sm border border-gray-200">
        <header class="px-5 py-4 border-b border-gray-100">
            <h2 class="font-semibold text-gray-800">All Branches <span class="text-gray-400 font-medium">@Model.Count()</span></h2>
        </header>
        <div class="p-3">

            <div class="overflow-x-auto">
                <table class="table-auto w-full text-slate-500">
                    <!-- Table header -->
                    <thead class="text-xs font-semibold uppercase text-slate-400 bg-slate-50 border-t border-b border-slate-200">
                        <tr>
                            <th class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-left">
                                <div class="font-semibold">Branch Name</div>
                            </th>
                            <th class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-left">
                                <div class="font-semibold">Location</div>
                            </th>
                            <th class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-left">
                                <div class="font-semibold">Contact</div>
                            </th>
                            <th class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-center">
                                <div class="font-semibold">Status</div>
                            </th>
                            <th class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-right">
                                <div class="font-semibold">Actions</div>
                            </th>
                        </tr>
                    </thead>
                    <!-- Table body -->
                    <tbody class="text-sm divide-y divide-slate-200">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap">
                                    <div class="font-medium text-gray-800">@item.Name</div>
                                    <div class="text-xs text-gray-500">Created: @item.CreatedAt.ToShortDateString()</div>
                                </td>
                                <td class="px-2 first:pl-5 last:pr-5 py-3">
                                    <div class="text-gray-800">@item.City</div>
                                    <div class="text-xs text-gray-500 truncate mt-0.5">@item.Address</div>
                                </td>
                                <td class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap">
                                    <div class="text-gray-800">@item.ContactNumber</div>
                                </td>
                                <td class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-center">
                                    @if (item.IsActive)
                                    {
                                        <div class="inline-flex font-medium rounded-full text-center px-2.5 py-0.5 bg-emerald-100 text-emerald-600">Active</div>
                                    }
                                    else
                                    {
                                        <div class="inline-flex font-medium rounded-full text-center px-2.5 py-0.5 bg-rose-100 text-rose-600">Inactive</div>
                                    }
                                </td>
                                <td class="px-2 first:pl-5 last:pr-5 py-3 whitespace-nowrap text-right">
                                    <div class="flex items-center justify-end space-x-2">
                                        <a asp-action="Performance" asp-route-id="@item.Id" class="text-[#0B1E3D] hover:text-[#FF6B00]" title="View Performance">
                                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                                <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                                            </svg>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-slate-400 hover:text-slate-500" title="Edit">
                                            <svg class="w-5 h-5 fill-current" viewBox="0 0 16 16">
                                                <path d="M11.7.3c-.4-.4-1-.4-1.4 0l-10 10c-.2.2-.3.4-.3.7v4c0 .6.4 1 1 1h4c.3 0 .5-.1.7-.3l10-10c.4-.4.4-1 0-1.4l-4-4zM4.6 14H2v-2.6l6-6L10.6 8l-6 6zM12 6.6L9.4 4 11 2.4 13.6 5 12 6.6z" />
                                            </svg>
                                        </a>
                                        <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="inline">
                                            <button type="submit" class="@(item.IsActive ? "text-rose-500 hover:text-rose-600" : "text-emerald-500 hover:text-emerald-600")" title="@(item.IsActive ? "Deactivate" : "Activate")" onclick="return confirm('Are you sure you want to change the status of this branch?');">
                                                @if (item.IsActive)
                                                {
                                                    <svg class="w-5 h-5 fill-current" viewBox="0 0 16 16">
                                                        <path d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8zm0 14c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z" />
                                                        <path d="M5 8a1 1 0 001 1h4a1 1 0 100-2H6a1 1 0 00-1 1z" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-5 h-5 fill-current" viewBox="0 0 16 16">
                                                        <path d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8zm0 14c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z" />
                                                        <path d="M11.7 5.3a1 1 0 00-1.4 0L8 7.6 5.7 5.3a1 1 0 00-1.4 1.4L6.6 9l-2.3 2.3a1 1 0 101.4 1.4L8 10.4l2.3 2.3a1 1 0 001.4-1.4L9.4 9l2.3-2.3a1 1 0 000-1.4z" />
                                                    </svg>
                                                }
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-8">
                    <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-1">No branches found</h3>
                    <p class="text-gray-500 text-sm">Get started by creating a new corporate or franchise branch.</p>
                </div>
            }

        </div>
    </div>
</div>
