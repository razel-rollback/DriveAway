@using DriveAway.Models
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Maintenance Jobs";
    var jobs = (List<MaintenanceJob>)Model;
    var mechanics = (IList<IdentityUser>)ViewBag.Mechanics;

    var pending = jobs.Where(j => j.JobStatus == MaintenanceJobStatus.Pending).ToList();
    var assigned = jobs.Where(j => j.JobStatus == MaintenanceJobStatus.Assigned).ToList();
    var inProgress = jobs.Where(j => j.JobStatus == MaintenanceJobStatus.InProgress).ToList();
    var completed = jobs.Where(j => j.JobStatus == MaintenanceJobStatus.Completed).ToList();

    string SeverityBadge(DamageSeverity s) => s switch
    {
        DamageSeverity.Minor => "bg-amber-100 text-amber-700",
        DamageSeverity.Major => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-gray-500"
    };

    string StatusBadge(MaintenanceJobStatus s) => s switch
    {
        MaintenanceJobStatus.Pending => "bg-amber-100 text-amber-700",
        MaintenanceJobStatus.Assigned => "bg-blue-100 text-blue-700",
        MaintenanceJobStatus.InProgress => "bg-purple-100 text-purple-700",
        MaintenanceJobStatus.Completed => "bg-green-100 text-green-700",
        _ => "bg-gray-100 text-gray-500"
    };

    string TypeBadge(MaintenanceType t) => t switch
    {
        MaintenanceType.MinorService => "bg-blue-50 text-blue-600 border-blue-200",
        MaintenanceType.MajorService => "bg-amber-50 text-amber-600 border-amber-200",
        MaintenanceType.GeneralInspection => "bg-purple-50 text-purple-600 border-purple-200",
        _ => "bg-gray-50 text-gray-600 border-gray-200"
    };
}

@model List<MaintenanceJob>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Maintenance Jobs</h1>
            <p class="text-sm text-gray-500 mt-0.5">Manage scheduled maintenance, damage repairs, and assign mechanics
            </p>
        </div>
        <form asp-action="ScanFleet" method="post">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-white transition-all shadow-sm hover:shadow-md"
                    style="background: linear-gradient(135deg, #0B1E3D 0%, #1E3A5F 100%);"
                    onmouseover="this.style.background='linear-gradient(135deg, #FF6B00 0%, #FF8C33 100%)'"
                    onmouseout="this.style.background='linear-gradient(135deg, #0B1E3D 0%, #1E3A5F 100%)'" onfocus="this.style.background='linear-gradient(135deg, #FF6B00 0%, #FF8C33 100%)'">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Scan Fleet
            </button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div
            class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 text-sm px-4 py-3 rounded-lg">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            @TempData["Success"]
        </div>
    }

    <!-- Info Banner -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="text-sm text-blue-800">
                <p class="font-medium mb-1">Preventive Maintenance Rules — Click "Scan Fleet" to detect eligible
                    vehicles</p>
                    <ul class="list-disc list-inside text-xs text-blue-700 space-y-0.5">
                        <li>Every <strong>5,000 km</strong> — Minor Service</li>
                        <li>Every <strong>10,000 km</strong> — Major Service</li>
                        <li>Every <strong>6 months</strong> — General Inspection</li>
                        <li>Overdue schedules are automatically flagged</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium">Pending</p>
                <p class="text-2xl font-bold mt-1 text-amber-600">@pending.Count</p>
            </div>
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium">Assigned</p>
                <p class="text-2xl font-bold mt-1 text-blue-600">@assigned.Count</p>
            </div>
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium">In Progress</p>
                <p class="text-2xl font-bold mt-1 text-purple-600">@inProgress.Count</p>
            </div>
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium">Completed</p>
                <p class="text-2xl font-bold mt-1 text-green-600">@completed.Count</p>
            </div>
        </div>

        <!-- Tabs -->
        <div x-data="{ tab: 'pending' }">
            <div class="flex gap-1 border-b border-gray-200 mb-4">
                <button @@click="tab='pending'"
                    :class="tab==='pending' ? 'border-b-2 border-[#FF6B00] text-[#FF6B00]' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors">
                    Pending <span
                    class="ml-1 px-1.5 py-0.5 rounded-full text-xs bg-amber-100 text-amber-700">@pending.Count</span>
                </button>
                <button @@click="tab='assigned'"
                    :class="tab==='assigned' ? 'border-b-2 border-[#FF6B00] text-[#FF6B00]' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors">
                    Assigned <span
                    class="ml-1 px-1.5 py-0.5 rounded-full text-xs bg-blue-100 text-blue-700">@assigned.Count</span>
                </button>
                <button @@click="tab='inprogress'"
                    :class="tab==='inprogress' ? 'border-b-2 border-[#FF6B00] text-[#FF6B00]' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors">
                    In Progress <span
                    class="ml-1 px-1.5 py-0.5 rounded-full text-xs bg-purple-100 text-purple-700">@inProgress.Count</span>
                </button>
                <button @@click="tab='completed'"
                    :class="tab==='completed' ? 'border-b-2 border-[#FF6B00] text-[#FF6B00]' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-2.5 text-sm font-semibold transition-colors">
                    Completed <span
                    class="ml-1 px-1.5 py-0.5 rounded-full text-xs bg-green-100 text-green-700">@completed.Count</span>
                </button>
            </div>

            @* ── Pending Tab ── *@
            <div x-show="tab==='pending'" class="space-y-3">
                @if (!pending.Any())
                {
                    <div class="text-center py-12 text-gray-400">
                        <svg class="h-12 w-12 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        <p class="text-sm font-medium text-gray-500">No pending jobs</p>
                        <p class="text-xs text-gray-400 mt-1">Click "Scan Fleet" to check for vehicles needing maintenance.</p>
                    </div>
                }
                @foreach (var job in pending)
                {
                    <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-5">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-2 flex-wrap">
                                    <span class="font-bold text-gray-800">@job.Vehicle.PlateNumber</span>
                                    <span class="text-xs text-gray-500">@job.Vehicle.Year @job.Vehicle.Make
                                        @job.Vehicle.Model</span>
                                        @if (job.MaintenanceType.HasValue)
                                        {
                                            <span
                                            class="inline-flex items-center px-2 py-0.5 rounded border text-xs font-medium @TypeBadge(job.MaintenanceType.Value)">@job.MaintenanceType</span>
                                        }
                                        else
                                        {
                                            <span
                                            class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @SeverityBadge(job.DamageSeverity)">@job.DamageSeverity</span>
                                        }
                                        @if (job.Vehicle.Branch != null)
                                        {
                                            <span class="text-xs text-gray-400">• @job.Vehicle.Branch.Name</span>
                                        }
                                    </div>
                                    <p class="text-sm text-gray-600 mb-1">@(job.DamageDescription ?? "No description")</p>
                                    @if (job.ScheduledAtMileage.HasValue)
                                    {
                                        <p class="text-xs text-gray-500 mb-1">Target: <span
                                            class="font-medium">@job.ScheduledAtMileage.Value.ToString("N0") km</span> · Current:
                                            @job.Vehicle.CurrentMileage.ToString("N0") km</p>
                                        }
                                        <p class="text-xs text-gray-400">Reported by @(job.CreatedByEmail ?? "—") on
                                            @job.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                            @if (job.RentalContract != null)
                                            {
                                                <p class="text-xs text-gray-400">Contract: @job.RentalContract.ContractNumber</p>
                                            }
                                        </div>
                                        <div class="flex-shrink-0">
                                            <form asp-action="AssignMechanic" method="post" class="flex items-end gap-2">
                                                <input type="hidden" name="jobId" value="@job.Id" />
                                                <div>
                                                    <label class="block text-xs font-medium text-gray-500 mb-1">Assign Mechanic</label>
                                                    <select name="mechanicId" required
                                                            class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00]">
                                                        <option value="">Select…</option>
                                                        @foreach (var m in mechanics)
                                                        {
                                                            <option value="@m.Id">@m.Email</option>
                                                        }
                                                    </select>
                                                </div>
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="inline-flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-semibold text-white transition-colors"
                                                        style="background-color: #0B1E3D;" onmouseover="this.style.backgroundColor='#FF6B00'"
                                                    onmouseout="this.style.backgroundColor='#0B1E3D'" onfocus="this.style.backgroundColor='#FF6B00'">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                    </svg>
                                                    Assign
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @* ── Assigned / InProgress / Completed Tabs ── *@
                        @foreach (var (tabName, tabJobs) in new[] { ("assigned", assigned), ("inprogress", inProgress), ("completed",
        completed) })
                        {
                            <div x-show="tab==='@tabName'" class="space-y-3">
                                @if (!tabJobs.Any())
                                {
                                    <div class="text-center py-12 text-gray-400">
                                        <p class="text-sm">No @tabName jobs</p>
                                    </div>
                                }
                                @foreach (var job in tabJobs)
                                {
                                    <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-5">
                                        <div class="flex items-center gap-2 mb-2 flex-wrap">
                                            <span class="font-bold text-gray-800">@job.Vehicle.PlateNumber</span>
                                            <span class="text-xs text-gray-500">@job.Vehicle.Year @job.Vehicle.Make @job.Vehicle.Model</span>
                                            @if (job.MaintenanceType.HasValue)
                                            {
                                                <span
                                                class="inline-flex items-center px-2 py-0.5 rounded border text-xs font-medium @TypeBadge(job.MaintenanceType.Value)">@job.MaintenanceType</span>
                                            }
                                            else
                                            {
                                                <span
                                                class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @SeverityBadge(job.DamageSeverity)">@job.DamageSeverity</span>
                                            }
                                            <span
                                            class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @StatusBadge(job.JobStatus)">@job.JobStatus</span>
                                            @if (job.Vehicle.Branch != null)
                                            {
                                                <span class="text-xs text-gray-400">• @job.Vehicle.Branch.Name</span>
                                            }
                                        </div>
                                        <p class="text-sm text-gray-600 mb-1">@(job.DamageDescription ?? "No description")</p>
                                        @if (job.ScheduledAtMileage.HasValue)
                                        {
                                            <p class="text-xs text-gray-500 mb-1">Target: <span
                                                class="font-medium">@job.ScheduledAtMileage.Value.ToString("N0") km</span></p>
                                            }
                                            @if (!string.IsNullOrEmpty(job.AssignedMechanicEmail))
                                            {
                                                <p class="text-xs text-gray-500">Mechanic: <span
                                                    class="font-medium text-gray-700">@job.AssignedMechanicEmail</span> · Assigned
                                                    @(job.AssignedAt?.ToString("MMM dd, yyyy") ?? "—")</p>
                                                }
                                                @if (job.JobStatus == MaintenanceJobStatus.Completed)
                                                {
                                                    <p class="text-xs text-gray-500 mt-1">Completed @(job.CompletedAt?.ToString("MMM dd, yyyy") ?? "—") ·
                                                        Cost: ₱@((job.RepairCost ?? 0).ToString("N2"))</p>
                                                        @if (!string.IsNullOrWhiteSpace(job.RepairNotes))
                                                        {
                                                            <p class="text-xs text-gray-500 mt-1">Notes: @job.RepairNotes</p>
                                                        }
                                                        @if (job.RepairParts.Any())
                                                        {
                                                            <div class="mt-2 border border-gray-100 rounded-lg overflow-hidden">
                                                                <table class="w-full text-xs">
                                                                    <thead class="bg-gray-50">
                                                                        <tr>
                                                                            <th class="px-3 py-1.5 text-left text-gray-500 font-semibold">Part</th>
                                                                            <th class="px-3 py-1.5 text-left text-gray-500 font-semibold">Qty</th>
                                                                            <th class="px-3 py-1.5 text-right text-gray-500 font-semibold">Unit Cost</th>
                                                                            <th class="px-3 py-1.5 text-right text-gray-500 font-semibold">Total</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody class="divide-y divide-gray-50">
                                                                        @foreach (var part in job.RepairParts)
                                                                        {
                                                                            <tr>
                                                                                <td class="px-3 py-1.5 text-gray-700">@part.PartName</td>
                                                                                <td class="px-3 py-1.5 text-gray-600">@part.Quantity</td>
                                                                                <td class="px-3 py-1.5 text-right text-gray-600">₱@part.UnitCost.ToString("N2")</td>
                                                                                <td class="px-3 py-1.5 text-right font-medium text-gray-800">
                                                                                    ₱@part.TotalCost.ToString("N2")</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                @section Scripts {
                                    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"
                                            integrity="sha384-9Ax3MmS9AClxJyd5/zafcXXjxmwFhZCdsT6HJoJjarvCaAkJlk5QDzjLJm+Wdx5F" defer
                                            crossorigin="anonymous"></script>
                                }
