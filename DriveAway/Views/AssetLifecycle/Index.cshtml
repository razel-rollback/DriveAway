@using DriveAway.Models
@{
    ViewData["Title"] = "Lifecycle Tracking";
    var vehicles = (List<Vehicle>)ViewBag.Vehicles;
    var selected = ViewBag.SelectedVehicle as Vehicle;
    var events = (List<VehicleLifecycleEvent>)ViewBag.Events;

    string BadgeClass(VehicleStatus s) => s switch
    {
        VehicleStatus.Available       => "bg-green-100 text-green-700",
        VehicleStatus.Rented          => "bg-blue-100 text-blue-700",
        VehicleStatus.Reserved        => "bg-purple-100 text-purple-700",
        VehicleStatus.UnderMaintenance => "bg-amber-100 text-amber-700",
        VehicleStatus.OutOfService    => "bg-red-100 text-red-700",
        VehicleStatus.Retired         => "bg-gray-100 text-gray-500",
        _                             => "bg-gray-100 text-gray-500"
    };

    string StatusLabel(VehicleStatus s) => s switch
    {
        VehicleStatus.UnderMaintenance => "Under Maintenance",
        VehicleStatus.OutOfService     => "Out of Service",
        _                              => s.ToString()
    };

    (string dot, string label) EventStyle(LifecycleEventType t) => t switch
    {
        LifecycleEventType.Acquired         => ("bg-green-500",  "Acquired"),
        LifecycleEventType.Available        => ("bg-green-400",  "Available"),
        LifecycleEventType.Rented           => ("bg-blue-500",   "Rented"),
        LifecycleEventType.Returned         => ("bg-blue-300",   "Returned"),
        LifecycleEventType.MaintenanceStart => ("bg-amber-500",  "Maintenance Started"),
        LifecycleEventType.MaintenanceEnd   => ("bg-amber-300",  "Maintenance Completed"),
        LifecycleEventType.Reserved         => ("bg-purple-500", "Reserved"),
        LifecycleEventType.StatusChanged    => ("bg-gray-400",   "Status Changed"),
        LifecycleEventType.Retired          => ("bg-gray-600",   "Retired"),
        LifecycleEventType.Disposed         => ("bg-red-500",    "Disposed"),
        _                                   => ("bg-gray-400",   t.ToString())
    };
}

<div class="space-y-4">

    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Lifecycle Tracking</h1>
        <p class="text-sm text-gray-500 mt-0.5">Complete asset history — from acquisition to disposal</p>
    </div>

    <div class="flex gap-5 items-start">

        <!-- Left panel: vehicle selector -->
        <div class="w-72 flex-shrink-0 bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-100">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Fleet Vehicles</p>
                <input id="vehicleSearch" type="text" placeholder="Search plate or model…"
                       class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
            </div>
            <div class="overflow-y-auto max-h-[600px]">
                @if (!vehicles.Any())
                {
                    <p class="text-xs text-gray-400 text-center py-8">No vehicles registered.</p>
                }
                else
                {
                    @foreach (var v in vehicles)
                    {
                        var isActive = selected?.Id == v.Id;
                        <a asp-action="Index" asp-route-vehicleId="@v.Id"
                           class="vehicle-item flex items-center gap-3 px-4 py-3 border-b border-gray-50 transition-colors @(isActive ? "bg-[#0B1E3D] text-white" : "hover:bg-gray-50 text-gray-700")"
                           data-search="@($"{v.PlateNumber} {v.Make} {v.Model}".ToLower())">
                            <div class="flex-shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-xs font-bold
                                        @(isActive ? "bg-white/20 text-white" : "bg-gray-100 text-gray-500")">
                                @v.Make.Substring(0, Math.Min(2, v.Make.Length)).ToUpper()
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs font-semibold truncate @(isActive ? "text-white" : "text-gray-800")">@v.PlateNumber</p>
                                <p class="text-xs truncate @(isActive ? "text-white/70" : "text-gray-400")">@v.Year @v.Make @v.Model</p>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Right panel: timeline -->
        <div class="flex-1 min-w-0">
            @if (selected == null)
            {
                <div class="bg-white rounded-lg border border-gray-100 shadow-sm flex flex-col items-center justify-center py-24 text-gray-400">
                    <svg class="h-14 w-14 mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <p class="text-sm font-medium text-gray-500">Select a vehicle to view its lifecycle history</p>
                </div>
            }
            else
            {
                <!-- Vehicle summary header -->
                <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-5 mb-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                            <div class="flex items-center gap-3">
                                <h2 class="text-lg font-bold text-gray-900">@selected.Year @selected.Make @selected.Model</h2>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @BadgeClass(selected.Status)">
                                    @StatusLabel(selected.Status)
                                </span>
                            </div>
                            <p class="text-sm text-gray-500 mt-0.5">
                                Plate: <span class="font-medium text-gray-700">@selected.PlateNumber</span>
                                &nbsp;·&nbsp; VIN: <span class="font-mono text-xs text-gray-600">@selected.VIN</span>
                            </p>
                        </div>
                        <button type="button" onclick="openDetailsModal()"
                           class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium border border-gray-200 text-gray-600 hover:border-[#0B1E3D] hover:text-[#0B1E3D] transition-colors flex-shrink-0">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            View Details
                        </button>
                    </div>

                    <!-- Summary stats -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-4 border-t border-gray-100">
                        @{
                            var rentalCount = events.Count(e => e.EventType == LifecycleEventType.Rented);
                            var maintCount  = events.Count(e => e.EventType == LifecycleEventType.MaintenanceStart);
                            var bookValue   = selected.PurchaseCost - (selected.UsefulLifeYears > 0
                                ? (selected.PurchaseCost - selected.SalvageValue) / selected.UsefulLifeYears
                                  * (decimal)(DateTime.Today - selected.AcquisitionDate).TotalDays / 365m
                                : 0);
                            bookValue = Math.Max(bookValue, selected.SalvageValue);
                        }
                        <div>
                            <p class="text-xs text-gray-400">Total Rentals</p>
                            <p class="text-xl font-bold text-gray-800 mt-0.5">@rentalCount</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Current Mileage</p>
                            <p class="text-xl font-bold text-gray-800 mt-0.5">@selected.CurrentMileage.ToString("N0") <span class="text-xs font-normal text-gray-400">km</span></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Maintenance Count</p>
                            <p class="text-xl font-bold text-gray-800 mt-0.5">@maintCount</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Est. Book Value</p>
                            <p class="text-xl font-bold text-gray-800 mt-0.5">₱@bookValue.ToString("N0")</p>
                        </div>
                    </div>
                </div>

                <!-- Vehicle Details Modal -->
                <div id="vehicleDetailsModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                        <!-- Background overlay -->
                        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeDetailsModal()"></div>

                        <!-- Modal panel -->
                        <div class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full border border-gray-100">
                            <div class="bg-white px-6 py-5 border-b border-gray-100 flex items-center justify-between">
                                <h3 class="text-lg font-bold text-[#0B1E3D]" id="modal-title">Vehicle Specifications</h3>
                                <button type="button" onclick="closeDetailsModal()" class="text-gray-400 hover:text-gray-500 transition-colors">
                                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                </button>
                            </div>
                            <div class="px-6 py-6 space-y-8 max-h-[70vh] overflow-y-auto">
                                <!-- Vehicle Identity -->
                                <section>
                                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Core Identity</h4>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Plate Number</p>
                                            <p class="text-sm font-semibold text-gray-900 bg-gray-50 px-3 py-2 rounded-lg border border-gray-100">@selected.PlateNumber</p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">VIN / Chassis</p>
                                            <p class="text-xs font-mono text-gray-900 bg-gray-50 px-3 py-2 rounded-lg border border-gray-100">@selected.VIN</p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Make & Model</p>
                                            <p class="text-sm font-medium text-gray-900">@selected.Year @selected.Make @selected.Model</p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Category & Class</p>
                                            <p class="text-sm font-medium text-gray-900">@(selected.Category ?? "—") &bull; @(selected.BodyClass ?? "—")</p>
                                        </div>
                                    </div>
                                </section>

                                <!-- Operational Info -->
                                <section>
                                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Operational Status</h4>
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Current Mileage</p>
                                            <p class="text-sm font-bold text-[#0B1E3D]">@selected.CurrentMileage.ToString("N0") <span class="text-xs font-normal text-gray-500">km</span></p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Current Status</p>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @BadgeClass(selected.Status)">
                                                @StatusLabel(selected.Status)
                                            </span>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Assigned Branch</p>
                                            <p class="text-sm font-medium text-gray-900">@(selected.Branch?.Name ?? "Unassigned")</p>
                                        </div>
                                    </div>
                                </section>

                                <!-- Financial Data -->
                                <section class="bg-blue-50/50 p-5 rounded-xl border border-blue-100/50">
                                    <h4 class="text-xs font-bold text-blue-900 uppercase tracking-widest mb-4">Asset Financials</h4>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                        <div class="space-y-4">
                                            <div>
                                                <p class="text-[10px] text-blue-600 uppercase font-bold mb-1">Acquisition Cost</p>
                                                <p class="text-lg font-bold text-blue-900">₱@selected.PurchaseCost.ToString("N2")</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] text-blue-600 uppercase font-bold mb-1">Acquisition Date</p>
                                                <p class="text-sm font-medium text-blue-900">@selected.AcquisitionDate.ToString("MMMM dd, yyyy")</p>
                                            </div>
                                        </div>
                                        <div class="space-y-4">
                                            <div>
                                                <p class="text-[10px] text-blue-600 uppercase font-bold mb-1">Current Book Value</p>
                                                <p class="text-lg font-bold text-blue-900">₱@selected.CurrentBookValue.ToString("N2")</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] text-blue-600 uppercase font-bold mb-1">Salvage Value</p>
                                                <p class="text-sm font-medium text-blue-900">₱@selected.SalvageValue.ToString("N2") (@selected.UsefulLifeYears-yr Life)</p>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <!-- Compliance -->
                                <section>
                                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Compliance & Documentation</h4>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Insurance Expiry</p>
                                            <p class="text-sm font-medium @(selected.InsuranceExpiry < DateTime.Today ? "text-red-600" : "text-gray-900")">
                                                @(selected.InsuranceExpiry?.ToString("MMM dd, yyyy") ?? "—")
                                            </p>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-gray-400 uppercase font-bold mb-1">Registration Expiry</p>
                                            <p class="text-sm font-medium @(selected.RegistrationExpiry < DateTime.Today ? "text-red-600" : "text-gray-900")">
                                                @(selected.RegistrationExpiry?.ToString("MMM dd, yyyy") ?? "—")
                                            </p>
                                        </div>
                                    </div>
                                </section>
                            </div>
                            <div class="bg-gray-50 px-6 py-4 flex justify-between items-center border-t border-gray-100">
                                <button type="button" onclick="cloeDetailsModal()" class="inline-flex justify-center px-4 py-2 text-sm font-bold text-white bg-[#0B1E3D] hover:bg-[#1E3A5F] rounded-lg transition-all shadow-sm">
                                    Close Profile
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-5">
                    <h3 class="text-sm font-semibold text-gray-700 mb-5">Lifecycle History</h3>

                    @if (!events.Any())
                    {
                        <p class="text-sm text-gray-400 py-6 text-center">No lifecycle events recorded yet.</p>
                    }
                    else
                    {
                        <div class="overflow-y-auto max-h-[500px] pr-1">
                        <ol class="relative border-l border-gray-200 ml-3 space-y-6">
                            @foreach (var ev in events)
                            {
                                var (dot, label) = EventStyle(ev.EventType);
                                <li class="ml-5">
                                    <span class="absolute -left-2 flex h-4 w-4 items-center justify-center rounded-full ring-4 ring-white @dot"></span>
                                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                                        <p class="text-sm font-semibold text-gray-800">@label</p>
                                        <time class="text-xs text-gray-400 flex-shrink-0">@ev.EventDate.ToString("MMM d, yyyy · h:mm tt")</time>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ev.Notes))
                                    {
                                        <p class="text-sm text-gray-500 mt-0.5">@ev.Notes</p>
                                    }
                                    @if (ev.Mileage.HasValue)
                                    {
                                        <p class="text-xs text-gray-400 mt-0.5">Mileage: @ev.Mileage.Value.ToString("N0") km</p>
                                    }
                                </li>
                            }
                        </ol>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openDetailsModal() {
        document.getElementById('vehicleDetailsModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDetailsModal() {
        document.getElementById('vehicleDetailsModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            closeDetailsModal();
        }
    });

    document.getElementById('vehicleSearch').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.vehicle-item').forEach(item => {
            item.style.display = item.dataset.search.includes(q) ? '' : 'none';
        });
    });
</script>
}
