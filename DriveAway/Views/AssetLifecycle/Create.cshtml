@model DriveAway.Models.Vehicle
@{
    ViewData["Title"] = "Register New Vehicle";
}

<div class="max-w-3xl mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center gap-4">
        <a asp-action="Registration"
           class="text-gray-400 hover:text-gray-600 transition-colors">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Register New Vehicle</h1>
            <p class="text-sm text-gray-500 mt-0.5">Add a new vehicle to the enterprise fleet registry</p>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-5">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg"></div>

        <!-- Section 1: VIN Lookup -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center justify-center h-6 w-6 rounded-full text-xs font-bold text-white" style="background-color: #0B1E3D;">1</span>
                <h2 class="text-sm font-semibold text-gray-800">VIN Lookup <span class="text-gray-400 font-normal ml-1">— powered by NHTSA API</span></h2>
            </div>
            <div class="flex gap-3">
                <div class="flex-1">
                    <input asp-for="VIN" id="VIN" maxlength="17"
                           class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm font-mono uppercase focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]"
                           placeholder="Enter 17-character VIN" />
                    <span asp-validation-for="VIN" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <button type="button" id="fetchVinBtn"
                        class="px-4 py-2.5 rounded-lg text-sm font-semibold text-white transition-colors flex items-center gap-2 flex-shrink-0"
                        style="background-color: #0B1E3D;"
                        onmouseover="this.style.backgroundColor='#FF6B00'"
                        onmouseout="this.style.backgroundColor='#0B1E3D'">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    Fetch from NHTSA
                </button>
            </div>
            <div id="vinStatus" class="hidden"></div>
        </div>

        <!-- Section 2: Vehicle Information -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center justify-center h-6 w-6 rounded-full text-xs font-bold text-white" style="background-color: #0B1E3D;">2</span>
                <h2 class="text-sm font-semibold text-gray-800">Vehicle Information <span class="text-gray-400 font-normal ml-1">— auto-filled from NHTSA, editable</span></h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Make" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="Make" id="Make" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. Toyota" />
                    <span asp-validation-for="Make" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Model" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="Model" id="Model" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. Corolla" />
                    <span asp-validation-for="Model" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Year" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="Year" id="Year" type="number" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. 2023" />
                    <span asp-validation-for="Year" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="BodyClass" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="BodyClass" id="BodyClass" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. Sedan/Saloon" />
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="Manufacturer" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="Manufacturer" id="Manufacturer" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. Toyota Motor Manufacturing" />
                </div>
            </div>
        </div>

        <!-- Section 3: Classification -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center justify-center h-6 w-6 rounded-full text-xs font-bold text-white" style="background-color: #0B1E3D;">3</span>
                <h2 class="text-sm font-semibold text-gray-800">Classification &amp; Branch</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Category" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <select asp-for="Category" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                        <option value="">— Select Category —</option>
                        <option>Economy</option>
                        <option>Compact</option>
                        <option>Intermediate</option>
                        <option>Standard</option>
                        <option>SUV/Crossover</option>
                        <option>Van/Minivan</option>
                        <option>Premium/Luxury</option>
                        <option>Pickup</option>
                        <option>Other</option>
                    </select>
                </div>
                <div>
                    <label asp-for="BranchId" class="block text-xs font-medium text-gray-600 mb-1">Branch</label>
                    <select asp-for="BranchId" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                        <option value="">— Unassigned —</option>
                        @if (ViewBag.Branches != null)
                        {
                            foreach (var b in (List<DriveAway.Models.Branch>)ViewBag.Branches)
                            {
                                <option value="@b.Id">@b.Name (@b.City)</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Section 4: Acquisition Details -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center justify-center h-6 w-6 rounded-full text-xs font-bold text-white" style="background-color: #0B1E3D;">4</span>
                <h2 class="text-sm font-semibold text-gray-800">Acquisition Details</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="PlateNumber" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="PlateNumber" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm uppercase focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. ABC 1234" />
                    <span asp-validation-for="PlateNumber" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="AcquisitionDate" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="AcquisitionDate" type="date" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
                    <span asp-validation-for="AcquisitionDate" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="PurchaseCost" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm">₱</span>
                        <input asp-for="PurchaseCost" type="number" step="0.01" class="w-full pl-7 pr-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="PurchaseCost" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Supplier" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="Supplier" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="Supplier or dealer name" />
                </div>
                <div>
                    <label asp-for="UsefulLifeYears" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <div class="relative">
                        <input asp-for="UsefulLifeYears" type="number" min="1" max="50" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="e.g. 10" />
                        <span class="absolute inset-y-0 right-3 flex items-center text-gray-400 text-xs pointer-events-none">yrs</span>
                    </div>
                    <span asp-validation-for="UsefulLifeYears" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="SalvageValue" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm">₱</span>
                        <input asp-for="SalvageValue" type="number" step="0.01" class="w-full pl-7 pr-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="SalvageValue" class="text-xs text-red-600 mt-1 block"></span>
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="InitialMileage" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <div class="relative max-w-xs">
                        <input asp-for="InitialMileage" type="number" min="0" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" placeholder="0" />
                        <span class="absolute inset-y-0 right-3 flex items-center text-gray-400 text-xs pointer-events-none">km</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 5: Compliance -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center justify-center h-6 w-6 rounded-full text-xs font-bold text-white" style="background-color: #0B1E3D;">5</span>
                <h2 class="text-sm font-semibold text-gray-800">Compliance Dates</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="InsuranceExpiry" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="InsuranceExpiry" type="date" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
                </div>
                <div>
                    <label asp-for="RegistrationExpiry" class="block text-xs font-medium text-gray-600 mb-1"></label>
                    <input asp-for="RegistrationExpiry" type="date" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
                </div>
            </div>
        </div>

        <!-- Section 6: Vehicle Photo -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center justify-center h-6 w-6 rounded-full text-xs font-bold text-white" style="background-color: #0B1E3D;">6</span>
                <h2 class="text-sm font-semibold text-gray-800">Vehicle Photo</h2>
            </div>
            <div class="max-w-md">
                <div id="dropZone" class="border-2 border-dashed border-gray-200 rounded-lg p-6 text-center cursor-pointer hover:border-[#FF6B00] transition-colors">
                    <img id="imagePreview" src="" alt="" class="hidden mx-auto mb-3 max-h-48 rounded-lg object-cover" />
                    <div id="dropText">
                        <svg class="mx-auto h-10 w-10 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <p class="text-sm text-gray-500">Click or drag an image here</p>
                        <p class="text-xs text-gray-400 mt-1">JPEG, PNG — max 5 MB</p>
                    </div>
                </div>
                <input type="file" name="vehicleImage" id="vehicleImage" accept="image/*" class="hidden" />
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 pb-4">
            <button type="submit"
                    class="px-6 py-2.5 rounded-lg text-sm font-semibold text-white transition-colors"
                    style="background-color: #0B1E3D;"
                    onmouseover="this.style.backgroundColor='#FF6B00'"
                    onmouseout="this.style.backgroundColor='#0B1E3D'">
                Save Vehicle
            </button>
            <a asp-action="Registration"
               class="px-6 py-2.5 rounded-lg text-sm font-medium border border-gray-200 text-gray-600 hover:border-gray-300 hover:text-gray-800 transition-colors">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    document.getElementById('fetchVinBtn').addEventListener('click', async function () {
        const vinInput = document.getElementById('VIN');
        const vin = vinInput.value.trim().toUpperCase();
        vinInput.value = vin;

        if (vin.length !== 17) {
            showVinStatus('error', 'VIN must be exactly 17 characters.');
            return;
        }

        showVinStatus('loading', 'Fetching vehicle data from NHTSA…');

        try {
            const res = await fetch(`/AssetLifecycle/FetchVin?vin=${encodeURIComponent(vin)}`);
            const data = await res.json();

            if (!res.ok) {
                showVinStatus('error', data.error || 'Could not fetch vehicle data.');
                return;
            }

            if (!data.isValid) {
                showVinStatus('warning', `NHTSA warning: ${data.errorText || 'VIN not fully recognized.'}`);
            } else {
                showVinStatus('success', 'Vehicle data fetched successfully from NHTSA.');
            }

            if (data.make)         document.getElementById('Make').value = titleCase(data.make);
            if (data.model)        document.getElementById('Model').value = titleCase(data.model);
            if (data.year)         document.getElementById('Year').value = data.year;
            if (data.bodyClass)    document.getElementById('BodyClass').value = data.bodyClass;
            if (data.manufacturer) document.getElementById('Manufacturer').value = titleCase(data.manufacturer);

        } catch (e) {
            showVinStatus('error', 'Network error. Please check your connection and try again.');
        }
    });

    function titleCase(str) {
        return str.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
    }

    function showVinStatus(type, message) {
        const el = document.getElementById('vinStatus');
        const cfg = {
            loading: {
                cls: 'bg-blue-50 border-blue-200 text-blue-700',
                icon: '<svg class="animate-spin h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>'
            },
            success: {
                cls: 'bg-green-50 border-green-200 text-green-700',
                icon: '<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
            },
            error: {
                cls: 'bg-red-50 border-red-200 text-red-700',
                icon: '<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
            },
            warning: {
                cls: 'bg-amber-50 border-amber-200 text-amber-700',
                icon: '<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>'
            }
        };
        const c = cfg[type];
        el.innerHTML = `<div class="flex items-center gap-2 px-3 py-2.5 rounded-lg border text-sm ${c.cls}">${c.icon}<span>${message}</span></div>`;
        el.classList.remove('hidden');
    }

    // Image upload with drag-and-drop
    (function() {
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('vehicleImage');
        const preview = document.getElementById('imagePreview');
        const dropText = document.getElementById('dropText');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-[#FF6B00]', 'bg-orange-50/50');
        });
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-[#FF6B00]', 'bg-orange-50/50');
        });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-[#FF6B00]', 'bg-orange-50/50');
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                showPreview(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            if (!file.type.startsWith('image/')) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                preview.src = e.target.result;
                preview.classList.remove('hidden');
                dropText.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
    })();
</script>
}
