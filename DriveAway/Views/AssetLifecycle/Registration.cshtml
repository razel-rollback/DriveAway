@model IEnumerable<DriveAway.Models.Vehicle>
@using DriveAway.Models
@{
    ViewData["Title"] = "Asset Registration";

    string BadgeClass(VehicleStatus s) => s switch
    {
        VehicleStatus.Available => "bg-green-100 text-green-700",
        VehicleStatus.Rented => "bg-blue-100 text-blue-700",
        VehicleStatus.Reserved => "bg-purple-100 text-purple-700",
        VehicleStatus.UnderMaintenance => "bg-amber-100 text-amber-700",
        VehicleStatus.OutOfService => "bg-red-100 text-red-700",
        VehicleStatus.Retired => "bg-gray-100 text-gray-500",
        _ => "bg-gray-100 text-gray-500"
    };

    string DotClass(VehicleStatus s) => s switch
    {
        VehicleStatus.Available => "bg-green-500",
        VehicleStatus.Rented => "bg-blue-500",
        VehicleStatus.Reserved => "bg-purple-500",
        VehicleStatus.UnderMaintenance => "bg-amber-500",
        VehicleStatus.OutOfService => "bg-red-500",
        VehicleStatus.Retired => "bg-gray-400",
        _ => "bg-gray-400"
    };

    string StatusLabel(VehicleStatus s) => s switch
    {
        VehicleStatus.UnderMaintenance => "Under Maintenance",
        VehicleStatus.OutOfService => "Out of Service",
        _ => s.ToString()
    };

    var total = Model.Count();
    var available = Model.Count(v => v.Status == VehicleStatus.Available);
    var rented = Model.Count(v => v.Status == VehicleStatus.Rented);
    var maintenance = Model.Count(v => v.Status == VehicleStatus.UnderMaintenance);
    var outOfService = Model.Count(v => v.Status == VehicleStatus.OutOfService);
    var retired = Model.Count(v => v.Status == VehicleStatus.Retired);
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Asset Registration</h1>
            <p class="text-sm text-gray-500 mt-0.5">Official fleet registry — all enterprise vehicles</p>
        </div>
        @if (!User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white transition-colors"
               style="background-color: #0B1E3D;"
               onmouseover="this.style.backgroundColor='#FF6B00'"
               onmouseout="this.style.backgroundColor='#0B1E3D'">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Register New Vehicle
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 text-sm px-4 py-3 rounded-lg">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            @TempData["Success"]
        </div>
    }

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        @foreach (var (label, count, colorClass) in new (string, int, string)[]
        {
            ("Total Fleet",    total,       "text-gray-800"),
            ("Available",      available,   "text-green-600"),
            ("Rented",         rented,      "text-blue-600"),
            ("Maintenance",    maintenance, "text-amber-600"),
            ("Out of Service", outOfService,"text-red-600"),
            ("Retired",        retired,     "text-gray-400"),
        })
        {
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium">@label</p>
                <p class="text-2xl font-bold mt-1 @colorClass">@count</p>
            </div>
        }
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">Vehicle Registry</h2>
            <input id="tableSearch" type="text"
                   placeholder="Search plate, VIN, make, model…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-64 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <svg class="h-12 w-12 mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
                </svg>
                <p class="text-sm font-medium text-gray-500">No vehicles registered yet.</p>
                <a asp-action="Create" class="mt-3 text-sm font-semibold" style="color: #FF6B00;">Register your first vehicle →</a>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm" id="vehicleTable">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">Plate No.</th>
                            <th class="px-5 py-3 text-left">VIN</th>
                            <th class="px-5 py-3 text-left">Make / Model</th>
                            <th class="px-5 py-3 text-left">Year</th>
                            <th class="px-5 py-3 text-left">Category</th>
                            <th class="px-5 py-3 text-left">Branch</th>
                            <th class="px-5 py-3 text-right">Book Value</th>
                            <th class="px-5 py-3 text-left">Status</th>
                            <th class="px-5 py-3 text-left">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var v in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors vehicle-row"
                                data-search="@($"{v.PlateNumber} {v.VIN} {v.Make} {v.Model} {v.Category}".ToLower())">
                                <td class="px-5 py-3.5 font-semibold text-gray-800">@v.PlateNumber</td>
                                <td class="px-5 py-3.5 font-mono text-xs text-gray-500">@v.VIN</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-medium text-gray-800">@v.Make</span>
                                    <span class="text-gray-500"> @v.Model</span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@v.Year</td>
                                <td class="px-5 py-3.5 text-gray-500">@(v.Category ?? "—")</td>
                                <td class="px-5 py-3.5 text-gray-500">@(v.Branch?.Name ?? "—")</td>
                                <td class="px-5 py-3.5 text-right font-medium text-gray-700">₱@v.CurrentBookValue.ToString("N0")</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium @BadgeClass(v.Status)">
                                        <span class="h-1.5 w-1.5 rounded-full @DotClass(v.Status)"></span>
                                        @StatusLabel(v.Status)
                                    </span>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex flex-col gap-2">
                                        <div class="flex items-center gap-2">
                                        @if (!User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@v.Id"
                                               class="text-xs font-medium px-2.5 py-1 rounded border border-gray-200 text-gray-600 hover:border-[#0B1E3D] hover:text-[#0B1E3D] transition-colors">
                                                Edit
                                            </a>
                                        }else{
                                            <p class="text-xs font-medium px-2.5 py-1 rounded text-gray-600">-</p>
                                        }
                                           
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No vehicles match your search.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    const searchInput = document.getElementById('tableSearch');
    const noResults = document.getElementById('noResults');
    if (searchInput) {
        searchInput.addEventListener('input', function () {
            const q = this.value.toLowerCase();
            let visible = 0;
            document.querySelectorAll('.vehicle-row').forEach(row => {
                const show = row.dataset.search.includes(q);
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            if (noResults) noResults.classList.toggle('hidden', visible > 0);
        });
    function toggleTransfer(id) {
        const el = document.getElementById(`transferForm_${id}`);
        if (el) el.classList.toggle('hidden');
    }
</script>
}
