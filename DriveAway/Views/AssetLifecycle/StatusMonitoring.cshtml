@model IEnumerable<DriveAway.Models.Vehicle>
@using DriveAway.Models
@{
    ViewData["Title"] = "Asset Status Monitoring";

    var today = DateTime.Today;
    var soon  = today.AddDays(30);

    string BadgeClass(VehicleStatus s) => s switch
    {
        VehicleStatus.Available        => "bg-green-100 text-green-700",
        VehicleStatus.Rented           => "bg-blue-100 text-blue-700",
        VehicleStatus.Reserved         => "bg-purple-100 text-purple-700",
        VehicleStatus.UnderMaintenance => "bg-amber-100 text-amber-700",
        VehicleStatus.OutOfService     => "bg-red-100 text-red-700",
        VehicleStatus.Retired          => "bg-gray-100 text-gray-500",
        _                              => "bg-gray-100 text-gray-500"
    };

    string DotClass(VehicleStatus s) => s switch
    {
        VehicleStatus.Available        => "bg-green-500",
        VehicleStatus.Rented           => "bg-blue-500",
        VehicleStatus.Reserved         => "bg-purple-500",
        VehicleStatus.UnderMaintenance => "bg-amber-500",
        VehicleStatus.OutOfService     => "bg-red-500",
        VehicleStatus.Retired          => "bg-gray-400",
        _                              => "bg-gray-400"
    };

    string StatusLabel(VehicleStatus s) => s switch
    {
        VehicleStatus.UnderMaintenance => "Under Maintenance",
        VehicleStatus.OutOfService     => "Out of Service",
        _                              => s.ToString()
    };

    bool InsuranceExpired(Vehicle v)     => v.InsuranceExpiry.HasValue     && v.InsuranceExpiry < today    && v.Status != VehicleStatus.Retired;
    bool RegistrationExpired(Vehicle v)  => v.RegistrationExpiry.HasValue  && v.RegistrationExpiry < today && v.Status != VehicleStatus.Retired;
    bool InsuranceExpiringSoon(Vehicle v) => v.InsuranceExpiry.HasValue    && v.InsuranceExpiry >= today   && v.InsuranceExpiry <= soon;
    bool RegistrationExpiringSoon(Vehicle v) => v.RegistrationExpiry.HasValue && v.RegistrationExpiry >= today && v.RegistrationExpiry <= soon;
}

<div class="space-y-6">

    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Asset Status Monitoring</h1>
        <p class="text-sm text-gray-500 mt-0.5">Real-time fleet availability and compliance overview</p>
    </div>

    <!-- Alerts -->
    @{
        var expiredReg  = (int)ViewBag.ExpiredRegistration;
        var expiredIns  = (int)ViewBag.ExpiredInsurance;
        var soonReg     = (int)ViewBag.ExpiringSoonRegistration;
        var soonIns     = (int)ViewBag.ExpiringSoonInsurance;
        bool hasAlerts  = expiredReg > 0 || expiredIns > 0 || soonReg > 0 || soonIns > 0;
    }
    @if (hasAlerts)
    {
        <div class="bg-white rounded-lg border border-amber-200 shadow-sm p-4 space-y-2">
            <div class="flex items-center gap-2 mb-1">
                <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                </svg>
                <p class="text-sm font-semibold text-amber-700">Compliance Alerts</p>
            </div>
            @if (expiredReg > 0)
            {
                <div class="flex items-center gap-2 text-sm text-red-700 bg-red-50 rounded-lg px-3 py-2">
                    <span class="h-2 w-2 rounded-full bg-red-500 flex-shrink-0"></span>
                    <strong>@expiredReg</strong> vehicle@(expiredReg > 1 ? "s" : "") with <strong>expired registration</strong>
                </div>
            }
            @if (expiredIns > 0)
            {
                <div class="flex items-center gap-2 text-sm text-red-700 bg-red-50 rounded-lg px-3 py-2">
                    <span class="h-2 w-2 rounded-full bg-red-500 flex-shrink-0"></span>
                    <strong>@expiredIns</strong> vehicle@(expiredIns > 1 ? "s" : "") with <strong>expired insurance</strong>
                </div>
            }
            @if (soonReg > 0)
            {
                <div class="flex items-center gap-2 text-sm text-amber-700 bg-amber-50 rounded-lg px-3 py-2">
                    <span class="h-2 w-2 rounded-full bg-amber-500 flex-shrink-0"></span>
                    <strong>@soonReg</strong> vehicle@(soonReg > 1 ? "s" : "") with registration <strong>expiring within 30 days</strong>
                </div>
            }
            @if (soonIns > 0)
            {
                <div class="flex items-center gap-2 text-sm text-amber-700 bg-amber-50 rounded-lg px-3 py-2">
                    <span class="h-2 w-2 rounded-full bg-amber-500 flex-shrink-0"></span>
                    <strong>@soonIns</strong> vehicle@(soonIns > 1 ? "s" : "") with insurance <strong>expiring within 30 days</strong>
                </div>
            }
        </div>
    }

    <!-- Fleet Overview Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
        @foreach (var (label, count, colorClass) in new (string, int, string)[]
        {
            ("Total Fleet",      (int)ViewBag.Total,            "text-gray-800"),
            ("Available",        (int)ViewBag.Available,        "text-green-600"),
            ("Rented",           (int)ViewBag.Rented,           "text-blue-600"),
            ("Reserved",         (int)ViewBag.Reserved,         "text-purple-600"),
            ("Maintenance",      (int)ViewBag.UnderMaintenance, "text-amber-600"),
            ("Out of Service",   (int)ViewBag.OutOfService,     "text-red-600"),
            ("Retired",          (int)ViewBag.Retired,          "text-gray-400"),
        })
        {
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium leading-snug">@label</p>
                <p class="text-2xl font-bold mt-1 @colorClass">@count</p>
            </div>
        }
    </div>

    <!-- Vehicle Table -->
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Live Fleet Status</h2>
            <select id="statusFilter"
                    class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                <option value="">All Statuses</option>
                <option value="available">Available</option>
                <option value="rented">Rented</option>
                <option value="reserved">Reserved</option>
                <option value="undermaintenance">Under Maintenance</option>
                <option value="outofservice">Out of Service</option>
                <option value="retired">Retired</option>
            </select>
            <input id="tableSearch" type="text" placeholder="Search plate, make, model…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No vehicles registered yet.</p>
                <a asp-action="Registration" class="mt-2 text-sm font-semibold" style="color: #FF6B00;">Go to Asset Registration →</a>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">Plate No.</th>
                            <th class="px-5 py-3 text-left">Make / Model</th>
                            <th class="px-5 py-3 text-left">Year</th>
                            <th class="px-5 py-3 text-left">Branch</th>
                            <th class="px-5 py-3 text-left">Status</th>
                            <th class="px-5 py-3 text-left">Mileage</th>
                            <th class="px-5 py-3 text-left">Insurance Expiry</th>
                            <th class="px-5 py-3 text-left">Reg. Expiry</th>
                            <th class="px-5 py-3 text-left">Alerts</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var v in Model)
                        {
                            var alerts = new List<string>();
                            if (InsuranceExpired(v))         alerts.Add("Insurance Expired");
                            if (RegistrationExpired(v))      alerts.Add("Registration Expired");
                            if (InsuranceExpiringSoon(v))    alerts.Add("Insurance Expiring Soon");
                            if (RegistrationExpiringSoon(v)) alerts.Add("Registration Expiring Soon");

                            var statusKey = StatusLabel(v.Status).ToLower().Replace(" ", "");

                            <tr class="hover:bg-gray-50 transition-colors monitor-row"
                                data-search="@($"{v.PlateNumber} {v.Make} {v.Model}".ToLower())"
                                data-status="@statusKey">
                                <td class="px-5 py-3.5 font-semibold text-gray-800">@v.PlateNumber</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-medium text-gray-800">@v.Make</span>
                                    <span class="text-gray-500"> @v.Model</span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@v.Year</td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Branch?.Name ?? "Unassigned")</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium @BadgeClass(v.Status)">
                                        <span class="h-1.5 w-1.5 rounded-full @DotClass(v.Status)"></span>
                                        @StatusLabel(v.Status)
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@v.CurrentMileage.ToString("N0") km</td>
                                <td class="px-5 py-3.5">
                                    @if (v.InsuranceExpiry.HasValue)
                                    {
                                        <span class="@(InsuranceExpired(v) ? "text-red-600 font-semibold" : InsuranceExpiringSoon(v) ? "text-amber-600 font-medium" : "text-gray-600")">
                                            @v.InsuranceExpiry.Value.ToString("MMM d, yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300">—</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (v.RegistrationExpiry.HasValue)
                                    {
                                        <span class="@(RegistrationExpired(v) ? "text-red-600 font-semibold" : RegistrationExpiringSoon(v) ? "text-amber-600 font-medium" : "text-gray-600")">
                                            @v.RegistrationExpiry.Value.ToString("MMM d, yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300">—</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (alerts.Any())
                                    {
                                        <div class="flex flex-col gap-1">
                                            @foreach (var alert in alerts)
                                            {
                                                var isExpired = alert.Contains("Expired") && !alert.Contains("Soon");
                                                <span class="inline-flex items-center gap-1 text-xs font-medium @(isExpired ? "text-red-600" : "text-amber-600")">
                                                    <svg class="h-3 w-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                                                    </svg>
                                                    @alert
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300 text-xs">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No vehicles match your filter.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    function applyFilters() {
        const q      = document.getElementById('tableSearch').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        let visible  = 0;

        document.querySelectorAll('.monitor-row').forEach(row => {
            const matchSearch = row.dataset.search.includes(q);
            const matchStatus = !status || row.dataset.status === status;
            const show = matchSearch && matchStatus;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const noResults = document.getElementById('noResults');
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    document.getElementById('tableSearch').addEventListener('input', applyFilters);
    document.getElementById('statusFilter').addEventListener('change', applyFilters);
</script>
}
