@model DriveAway.Models.RentalContract
@using DriveAway.Models
@{
    ViewData["Title"] = "Return Vehicle";
    var days = Math.Max(1, (int)Math.Ceiling((Model.RentalEnd - Model.RentalStart).TotalDays));
    var rentalTotal = Model.DailyRate * days;
    var rentalPayment = Model.Payments?.FirstOrDefault(p => p.PaymentType == PaymentType.Rental);
    var depositPayment = Model.Payments?.FirstOrDefault(p => p.PaymentType == PaymentType.SecurityDeposit);
}

<div class="max-w-3xl mx-auto space-y-6">

    @* ── Header ── *@
    <div>
        <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Return Vehicle</h1>
        <p class="text-sm text-gray-500 mt-0.5">Complete the check-in process for contract <strong>@Model.ContractNumber</strong></p>
    </div>

    <form asp-action="CheckIn" method="post" class="bg-white rounded-lg border border-gray-100 shadow-sm divide-y divide-gray-100">
        <input type="hidden" name="id" value="@Model.Id" />

        @* ── Contract Summary (read-only) ── *@
        <div class="px-6 py-5 space-y-3">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Contract Summary</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
                <div>
                    <p class="text-gray-500 text-xs">Contract</p>
                    <p class="font-semibold text-gray-800">@Model.ContractNumber</p>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Vehicle</p>
                    <p class="font-semibold text-gray-800">@Model.Vehicle.PlateNumber</p>
                    <p class="text-gray-500 text-xs">@Model.Vehicle.Make @Model.Vehicle.Model</p>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Customer</p>
                    <p class="font-semibold text-gray-800">@Model.CustomerName</p>
                    @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                    {
                        <p class="text-gray-500 text-xs">@Model.CustomerEmail</p>
                    }
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Rental Period</p>
                    <p class="font-medium text-gray-800">@Model.RentalStart.ToString("MMM d") → @Model.RentalEnd.ToString("MMM d, yyyy")</p>
                    <p class="text-gray-500 text-xs">@days day@(days > 1 ? "s" : "") · ₱@rentalTotal.ToString("N2")</p>
                </div>
            </div>

            @* Vehicle Image *@
            @if (!string.IsNullOrEmpty(Model.Vehicle.ImagePath))
            {
                <div class="mt-3">
                    <img src="@Model.Vehicle.ImagePath" alt="Vehicle" class="h-32 rounded-lg object-cover border border-gray-200" />
                </div>
            }
        </div>

        @* ── Payment Summary (from Payments table) ── *@
        <div class="px-6 py-5 space-y-3">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Payment Summary</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
                <div>
                    <p class="text-gray-500 text-xs">Daily Rate</p>
                    <p class="font-semibold text-gray-800">₱@Model.DailyRate.ToString("N2") × @days day@(days > 1 ? "s" : "")</p>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Rental Total</p>
                    <p class="font-semibold text-gray-800">₱@rentalTotal.ToString("N2")</p>
                    @if (rentalPayment != null)
                    {
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium @(rentalPayment.PaymentStatus == PaymentStatus.Paid ? "bg-green-100 text-green-700" : "bg-amber-100 text-amber-700")">
                            @rentalPayment.PaymentStatus
                        </span>
                    }
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Security Deposit</p>
                    <p class="font-semibold text-green-700">₱@Model.SecurityDeposit.ToString("N2")</p>
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">
                        @Model.DepositStatus
                    </span>
                </div>
                <div>
                    <p class="text-gray-500 text-xs">Payment Method</p>
                    <p class="font-semibold text-gray-800">@(rentalPayment?.PaymentMethod.ToString() ?? "N/A")</p>
                    @if (rentalPayment?.PaymentMethod == PaymentMethodType.Online)
                    {
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">
                            Refund goes to same account
                        </span>
                    }
                </div>
            </div>
        </div>

        @* ── Return Details ── *@
        <div class="px-6 py-5 space-y-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Return Details</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="actualReturn" class="block text-sm font-medium text-gray-700 mb-1">Actual Return Date & Time</label>
                    <input type="datetime-local" name="actualReturn" id="actualReturn"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00]" required />
                </div>
                <div>
                    <label for="returnMileage" class="block text-sm font-medium text-gray-700 mb-1">Return Mileage (km)</label>
                    <input type="number" name="returnMileage" id="returnMileage" min="@Model.Vehicle.CurrentMileage"
                           value="@Model.Vehicle.CurrentMileage"
                           class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00]" />
                </div>
            </div>

            <div>
                <label for="returnFuelLevel" class="block text-sm font-medium text-gray-700 mb-1">Fuel Level</label>
                <select name="returnFuelLevel" id="returnFuelLevel"
                        class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00]">
                    <option value="Full">Full</option>
                    <option value="3/4">3/4</option>
                    <option value="1/2">1/2</option>
                    <option value="1/4">1/4</option>
                    <option value="Empty">Empty</option>
                </select>
            </div>
        </div>

        @* ── Damage Assessment ── *@
        <div class="px-6 py-5 space-y-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Damage Assessment</h2>

            <div class="grid grid-cols-3 gap-3">
                <label class="relative cursor-pointer">
                    <input type="radio" name="damageSeverity" value="None" class="peer sr-only" checked />
                    <div class="flex flex-col items-center gap-2 p-4 rounded-lg border-2 border-gray-200 peer-checked:border-green-500 peer-checked:bg-green-50 transition-all">
                        <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center">
                            <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <span class="text-sm font-semibold text-gray-700">No Damage</span>
                        <span class="text-xs text-gray-400">Vehicle in good condition</span>
                    </div>
                </label>
                <label class="relative cursor-pointer">
                    <input type="radio" name="damageSeverity" value="Minor" class="peer sr-only" />
                    <div class="flex flex-col items-center gap-2 p-4 rounded-lg border-2 border-gray-200 peer-checked:border-amber-500 peer-checked:bg-amber-50 transition-all">
                        <div class="h-10 w-10 rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        </div>
                        <span class="text-sm font-semibold text-gray-700">Minor Damage</span>
                        <span class="text-xs text-gray-400">Scratches, dents, etc.</span>
                    </div>
                </label>
                <label class="relative cursor-pointer">
                    <input type="radio" name="damageSeverity" value="Major" class="peer sr-only" />
                    <div class="flex flex-col items-center gap-2 p-4 rounded-lg border-2 border-gray-200 peer-checked:border-red-500 peer-checked:bg-red-50 transition-all">
                        <div class="h-10 w-10 rounded-full bg-red-100 flex items-center justify-center">
                            <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </div>
                        <span class="text-sm font-semibold text-gray-700">Major Damage</span>
                        <span class="text-xs text-gray-400">Requires immediate repair</span>
                    </div>
                </label>
            </div>

            <div id="damageNotesSection" class="hidden">
                <label for="returnDamageNotes" class="block text-sm font-medium text-gray-700 mb-1">Damage Description</label>
                <textarea name="returnDamageNotes" id="returnDamageNotes" rows="3"
                          placeholder="Describe the damage in detail — location, type, severity…"
                          class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00]"></textarea>
            </div>
        </div>

        @* ── Fee Breakdown ── *@
        <div class="px-6 py-5 space-y-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Fee Assessment</h2>

            <div class="space-y-3">
                @* Fuel Fee *@
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <div>
                        <label for="fuelFee" class="text-sm text-gray-600">Fuel Fee</label>
                        <p class="text-xs text-gray-400">Charged if fuel is not full</p>
                    </div>
                    <div class="relative w-40">
                        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm">₱</span>
                        <input type="number" name="fuelFee" id="fuelFee" step="0.01" min="0" value="0"
                               class="w-full pl-7 pr-3 py-2 border border-gray-200 rounded-lg text-sm text-right focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00] fee-input" />
                    </div>
                </div>

                @* Late Fee *@
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <div>
                        <label for="lateFee" class="text-sm text-gray-600">Late Fee</label>
                        <p class="text-xs text-gray-400">Charged for late return</p>
                    </div>
                    <div class="relative w-40">
                        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm">₱</span>
                        <input type="number" name="lateFee" id="lateFee" step="0.01" min="0" value="0"
                               class="w-full pl-7 pr-3 py-2 border border-gray-200 rounded-lg text-sm text-right focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00] fee-input" />
                    </div>
                </div>

                @* Damage Fee *@
                <div class="flex items-center justify-between py-2 border-b border-gray-100">
                    <div>
                        <label for="damageFee" class="text-sm text-gray-600">Damage Fee</label>
                    </div>
                    <div class="relative w-40">
                        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm">₱</span>
                        <input type="number" name="damageFee" id="damageFee" step="0.01" min="0" value="0"
                               class="w-full pl-7 pr-3 py-2 border border-gray-200 rounded-lg text-sm text-right focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00] fee-input" />
                    </div>
                </div>
            </div>

            @* Deposit deduction summary *@
            <div id="depositStatus" class="rounded-lg border px-4 py-3 text-sm flex items-center gap-2 bg-green-50 border-green-200 text-green-700">
                <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>No extra fees — security deposit of ₱@Model.SecurityDeposit.ToString("N2") will be fully refunded</span>
            </div>

            @* Refund / Amount Due summary *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="bg-green-50 rounded-lg p-4 border border-green-200">
                    <span class="text-xs font-medium text-green-600 uppercase">Deposit Refund</span>
                    <p class="text-xl font-bold text-green-700 mt-1" id="depositRefundDisplay">₱@Model.SecurityDeposit.ToString("N2")</p>
                </div>
                <div class="bg-[#0B1E3D] rounded-lg p-4">
                    <span class="text-xs font-medium text-gray-300 uppercase">Additional Amount Due</span>
                    <p class="text-xl font-bold text-white mt-1" id="grandTotal">₱0.00</p>
                </div>
            </div>

            @* Balance Payment Method *@
            <div id="balancePaymentSection" class="hidden mt-4 pt-4 border-t border-gray-100">
                <label for="balancePaymentMethod" class="block text-sm font-medium text-gray-700 mb-1">Payment Method for Balance Due</label>
                <select name="balancePaymentMethod" id="balancePaymentMethod"
                        class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00]">
                    <option value="Cash">Cash</option>
                    <option value="Online">Online</option>
                </select>
                <p class="text-xs text-gray-500 mt-1" id="balancePaymentNote">Select how the customer is paying the remaining balance. If online, a payment link will be generated.</p>
            </div>
        </div>

        @* ── Actions ── *@
        <div class="px-6 py-4 flex items-center justify-between bg-gray-50/50">
            <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors">← Back to Dashboard</a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:shadow-md"
                    style="background-color: #0B1E3D;">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Complete Check-In
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const securityDeposit = @Model.SecurityDeposit.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // Damage severity toggle
    const damageRadios = document.querySelectorAll('input[name="damageSeverity"]');
    const damageNotesSection = document.getElementById('damageNotesSection');

    damageRadios.forEach(r => r.addEventListener('change', () => {
        const val = document.querySelector('input[name="damageSeverity"]:checked').value;
        damageNotesSection.classList.toggle('hidden', val === 'None');
    }));

    function calcTotal() {
        const late = parseFloat(document.getElementById('lateFee').value) || 0;
        const damage = parseFloat(document.getElementById('damageFee').value) || 0;
        const fuel = parseFloat(document.getElementById('fuelFee').value) || 0;

        const extraFees = late + damage + fuel;
        const amountDue = Math.max(0, extraFees - securityDeposit);
        const depositRefund = Math.max(0, securityDeposit - extraFees);

        document.getElementById('grandTotal').textContent = '₱' + amountDue.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('depositRefundDisplay').textContent = '₱' + depositRefund.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        // Deposit status message
        const depositEl = document.getElementById('depositStatus');
        const balancePaymentSection = document.getElementById('balancePaymentSection');
        if (extraFees === 0) {
            depositEl.className = 'rounded-lg border px-4 py-3 text-sm flex items-center gap-2 bg-green-50 border-green-200 text-green-700';
            depositEl.innerHTML = '<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>No extra fees — security deposit of ₱' + securityDeposit.toLocaleString('en-PH', {minimumFractionDigits: 2}) + ' will be fully refunded</span>';
            balancePaymentSection.classList.add('hidden');
        } else if (depositRefund > 0) {
            depositEl.className = 'rounded-lg border px-4 py-3 text-sm flex items-center gap-2 bg-blue-50 border-blue-200 text-blue-700';
            depositEl.innerHTML = '<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Deposit covers all fees. ₱' + depositRefund.toLocaleString('en-PH', {minimumFractionDigits: 2}) + ' will be refunded to customer</span>';
            balancePaymentSection.classList.add('hidden');
        } else {
            depositEl.className = 'rounded-lg border px-4 py-3 text-sm flex items-center gap-2 bg-red-50 border-red-200 text-red-700';
            depositEl.innerHTML = '<svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg><span>Fees exceed deposit by ₱' + amountDue.toLocaleString('en-PH', {minimumFractionDigits: 2}) + '</span>';
            balancePaymentSection.classList.remove('hidden');
        }
    }

    document.querySelectorAll('.fee-input').forEach(el => el.addEventListener('input', calcTotal));
</script>
}
