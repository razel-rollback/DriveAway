@model DriveAway.Models.RentalContract
@using DriveAway.Models
@{
    ViewData["Title"] = $"Contract Details - {Model.ContractNumber}";
    var isOverdue = Model.RentalStatus == RentalStatus.Active && Model.RentalEnd.Date < DateTime.UtcNow.Date;
}

<div class="space-y-6 max-w-11xl mx-auto pb-10">
    @* ── Header Navigation ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-500 hover:text-gray-700">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-2xl font-bold" style="color: #0B1E3D;">@Model.ContractNumber</h1>
                    @{
                        var statusBadge = Model.RentalStatus switch
                        {
                            RentalStatus.Active    => "bg-blue-100 text-blue-700",
                            RentalStatus.Completed => "bg-green-100 text-green-700",
                            RentalStatus.Cancelled => "bg-gray-100 text-gray-500",
                            _                      => "bg-gray-100 text-gray-500"
                        };
                    }
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusBadge">
                        @Model.RentalStatus
                    </span>
                </div>
                <p class="text-sm text-gray-500 mt-0.5">Created on @Model.CreatedAt.ToString("MMM d, yyyy h:mm tt")</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            @if (Model.RentalStatus == RentalStatus.Active)
            {
                <a asp-action="CheckIn" asp-route-id="@Model.Id"
                   class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:shadow-md"
                   style="background-color: #0B1E3D;">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Return Vehicle
                </a>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        @* ── Left Column: Contract & Customer Info ── *@
        <div class="lg:col-span-2 space-y-6">
            @* Basic Info Section *@
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-50 bg-gray-50/50">
                    <h2 class="text-sm font-bold flex items-center gap-2" style="color: #0B1E3D;">
                        <svg class="h-4 w-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        Rental Information
                    </h2>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 text-sm">
                    <div>
                        <p class="text-gray-500 font-medium mb-1">Rental Period</p>
                        <div class="flex items-center gap-2">
                            <span class="font-semibold text-gray-900 text-base">@Model.RentalStart.ToString("MMM d, yyyy")</span>
                            <span class="text-gray-400">→</span>
                            <span class="font-semibold text-base @(isOverdue ? "text-red-600" : "text-gray-900")">
                                @Model.RentalEnd.ToString("MMM d, yyyy")
                            </span>
                        </div>
                        @if (isOverdue)
                        {
                            <span class="text-xs font-semibold text-red-600 bg-red-50 px-2 py-0.5 rounded mt-1 inline-block">Contract Overdue</span>
                        }
                    </div>
                    <div>
                        <p class="text-gray-500 font-medium mb-1">Duration & Rate</p>
                        <div class="flex flex-col">
                            <span class="font-semibold text-gray-900 text-base">
                                @Math.Max(1, (int)Math.Ceiling((Model.RentalEnd - Model.RentalStart).TotalDays)) Days
                            </span>
                            <span class="text-gray-600">@Model.DailyRate.ToString("C2") / day</span>
                        </div>
                    </div>
                    <div>
                        <p class="text-gray-500 font-medium mb-1">Processed By</p>
                        <p class="font-semibold text-gray-900">@Model.ProcessedByEmail</p>
                    </div>
                </div>
            </div>

            @* Customer Info Section *@
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-50 bg-gray-50/50">
                    <h2 class="text-sm font-bold flex items-center gap-2" style="color: #0B1E3D;">
                        <svg class="h-4 w-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Customer Information
                    </h2>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 text-sm">
                    <div>
                        <p class="text-gray-500 font-medium mb-1">Name</p>
                        <p class="text-lg font-bold text-gray-900">@Model.CustomerName</p>
                    </div>
                    <div>
                        <p class="text-gray-500 font-medium mb-1">Email</p>
                        <p class="font-semibold text-gray-900">@(Model.CustomerEmail ?? "N/A")</p>
                    </div>
                    <div>
                        <p class="text-gray-500 font-medium mb-1">Contact Number</p>
                        <p class="font-semibold text-gray-900">@Model.CustomerContact</p>
                    </div>
                    <div>
                        <p class="text-gray-500 font-medium mb-1">License Number</p>
                        <p class="font-semibold text-gray-900">@Model.CustomerLicense</p>
                    </div>
                </div>
            </div>

            @* Return Info Section (Only if completed) *@
            @if (Model.RentalStatus == RentalStatus.Completed || Model.ActualReturn.HasValue)
            {
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-50 bg-emerald-50/50">
                        <h2 class="text-sm font-bold flex items-center gap-2 text-emerald-800">
                            <svg class="h-4 w-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            Check-In Details
                        </h2>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 text-sm">
                        <div>
                            <p class="text-gray-500 font-medium mb-1">Actual Return</p>
                            <p class="font-bold text-gray-900 text-base">@Model.ActualReturn?.ToString("MMM d, yyyy h:mm tt")</p>
                        </div>
                        <div>
                            <p class="text-gray-500 font-medium mb-1">Return Mileage</p>
                            <p class="font-semibold text-gray-900">@(Model.ReturnMileage?.ToString("N0") ?? "N/A") km</p>
                        </div>
                        <div>
                            <p class="text-gray-500 font-medium mb-1">Fuel Level</p>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-gray-100 text-gray-700">@Model.ReturnFuelLevel</span>
                        </div>
                        <div class="md:col-span-2">
                            <p class="text-gray-500 font-medium mb-1">Damage Notes</p>
                            <div class="p-3 bg-gray-50 rounded-lg text-gray-700 min-h-[60px]">
                                @(string.IsNullOrWhiteSpace(Model.ReturnDamageNotes) ? "No damage reported." : Model.ReturnDamageNotes)
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Right Column: Vehicle & Financials ── *@
        <div class="space-y-6">
            @* Vehicle Section *@
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-50 bg-gray-50/50">
                    <h2 class="text-sm font-bold flex items-center gap-2" style="color: #0B1E3D;">
                        <svg class="h-4 w-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12M8 12h12M8 17h8"/></svg>
                        Vehicle
                    </h2>
                </div>
                <div class="p-0">
                    @if (!string.IsNullOrEmpty(Model.Vehicle?.ImagePath))
                    {
                        <img src="@Model.Vehicle.ImagePath" class="w-full h-48 object-cover border-b border-gray-50" alt="Vehicle Image" />
                    }
                    else
                    {
                        <div class="w-full h-48 bg-gray-100 flex items-center justify-center border-b border-gray-50">
                            <svg class="h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                    }
                    <div class="p-6 space-y-4 text-sm">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-bold text-lg text-gray-900">@Model.Vehicle?.PlateNumber</h3>
                                <p class="text-gray-500">@Model.Vehicle?.Make @Model.Vehicle?.Model (@Model.Vehicle?.Year)</p>
                            </div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-orange-100 text-orange-700">
                                @Model.Vehicle?.Category
                            </span>
                        </div>
                        <div class="pt-4 border-t border-gray-50 flex justify-between items-center">
                            <span class="text-gray-500 font-medium">Initial Mileage</span>
                            <span class="font-semibold text-gray-900">@(Model.Vehicle?.CurrentMileage.ToString("N0")) km</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Financial Status Section *@
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-50 bg-gray-50/50">
                    <h2 class="text-sm font-bold flex items-center gap-2" style="color: #0B1E3D;">
                        <svg class="h-4 w-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Financial Summary
                    </h2>
                </div>
                <div class="p-6 space-y-3 prose-sm max-w-none">
                    @{
                        var rentalBaseFee = Model.TotalFee > 0
                            ? Model.TotalFee
                            : Model.DailyRate * Math.Max(1, (int)Math.Ceiling((Model.RentalEnd - Model.RentalStart).TotalDays));
                    }
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-500">Rental Fee</span>
                        <span class="font-semibold text-gray-900">@rentalBaseFee.ToString("C2")</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-500">Security Deposit</span>
                        <span class="font-semibold text-gray-900">@Model.SecurityDeposit.ToString("C2")</span>
                    </div>
                    
                    @if (Model.RentalStatus == RentalStatus.Completed)
                    {
                        <div class="pt-2 border-t border-gray-50 space-y-2">
                            @if (Model.LateFee > 0) {
                                <div class="flex justify-between items-center text-sm text-red-600">
                                    <span>Late Fee</span>
                                    <span class="font-bold">@Model.LateFee.ToString("C2")</span>
                                </div>
                            }
                            @if (Model.DamageFee > 0) {
                                <div class="flex justify-between items-center text-sm text-red-600">
                                    <span>Damage Fee</span>
                                    <span class="font-bold">@Model.DamageFee.ToString("C2")</span>
                                </div>
                            }
                            @if (Model.FuelFee > 0) {
                                <div class="flex justify-between items-center text-sm text-red-600">
                                    <span>Fuel Fee</span>
                                    <span class="font-bold">@Model.FuelFee.ToString("C2")</span>
                                </div>
                            }
                        </div>
                        <div class="flex justify-between items-center pt-2 text-sm text-emerald-600 font-medium">
                            <span>Deposit Refund</span>
                            <span>@Model.DepositRefundAmount.ToString("C2")</span>
                        </div>
                    }

                    <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
                        <span class="text-base font-bold text-gray-900">Total Payable</span>
                        @{
                            // Active: rental + deposit (charged upfront); Completed: rental + extra fees only
                            var totalPayable = Model.RentalStatus == RentalStatus.Completed
                                ? rentalBaseFee + Model.LateFee + Model.DamageFee + Model.FuelFee
                                : rentalBaseFee + Model.SecurityDeposit;
                        }
                        <span class="text-xl font-black" style="color: #FF6B00;">
                            @totalPayable.ToString("C2")
                        </span>
                    </div>
                    
                    <div class="pt-2">
                        @{
                            var depositBadge = Model.DepositStatus switch
                            {
                                DepositStatus.Held              => "bg-blue-100 text-blue-700",
                                DepositStatus.FullyRefunded     => "bg-green-100 text-green-700",
                                DepositStatus.PartiallyRefunded => "bg-yellow-100 text-yellow-700",
                                DepositStatus.Forfeited         => "bg-red-100 text-red-700",
                                _                               => "bg-gray-100 text-gray-500"
                            };
                        }
                        <div class="flex justify-between items-center text-[10px] uppercase tracking-wider font-bold">
                            <span class="text-gray-400">Deposit Status</span>
                            <span class="px-2 py-0.5 rounded @depositBadge">@Model.DepositStatus</span>
                        </div>

                    @* Amount Due from Customer (when fees exceeded deposit) *@
                    @if (Model.RentalStatus == RentalStatus.Completed)
                    {
                        var customerBalance = Math.Max(0, (Model.LateFee + Model.DamageFee + Model.FuelFee) - Model.SecurityDeposit);
                        
                        if (customerBalance > 0)
                        {
                            var balancePayment = Model.Payments?.FirstOrDefault(p =>
                                p.PaymentStatus == PaymentStatus.Pending &&
                                !string.IsNullOrEmpty(p.PayMongoPaymentUrl));

                            <div class="pt-3 mt-2 border-t border-red-100">
                                <div class="flex justify-between items-center">
                                    <span class="text-sm font-bold text-red-600">Customer Balance Due</span>
                                    <span class="text-lg font-black text-red-600">@customerBalance.ToString("C2")</span>
                                </div>
                                <p class="text-xs text-red-500 mt-1">
                                    Fees exceeded security deposit — customer owes this amount
                                </p>
                                @if (balancePayment != null && !string.IsNullOrEmpty(balancePayment.PayMongoPaymentUrl))
                                {
                                    <a href="@balancePayment.PayMongoPaymentUrl" target="_blank"
                                       class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-white px-3 py-1.5 rounded-lg transition-all hover:shadow-md"
                                       style="background-color: #FF6B00;">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                        Payment Link
                                    </a>
                                }
                            </div>
                        }
                    }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Payment History ── *@
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-50 bg-gray-50/50 flex justify-between items-center">
            <h2 class="text-sm font-bold flex items-center gap-2" style="color: #0B1E3D;">
                <svg class="h-4 w-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
                Payment History
            </h2>
        </div>
        <div>
            <table class="w-full divide-y divide-gray-100 text-sm">
                <thead class="bg-gray-50/50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-3 text-left">Date</th>
                        <th class="px-6 py-3 text-left">Type</th>
                        <th class="px-6 py-3 text-left">Method</th>
                        <th class="px-6 py-3 text-left">Amount</th>
                        <th class="px-6 py-3 text-left">Status</th>
                        <th class="px-6 py-3 text-left">Notes</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (Model.Payments?.Any() == true)
                    {
                        foreach (var p in Model.Payments.OrderByDescending(p => p.CreatedAt))
                        {
                            var payBadge = p.PaymentStatus == PaymentStatus.Paid ? "bg-green-100 text-green-700" : "bg-amber-100 text-amber-700";
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-gray-600">@p.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800">@p.PaymentType</td>
                                <td class="px-6 py-4 whitespace-nowrap text-gray-600">@p.PaymentMethod</td>
                                <td class="px-6 py-4 whitespace-nowrap font-bold text-gray-900">@p.Amount.ToString("C2")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase @payBadge">
                                        @p.PaymentStatus
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-gray-500">@p.Notes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-400 italic">No payment records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
