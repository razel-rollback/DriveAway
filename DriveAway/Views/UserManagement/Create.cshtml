@model DriveAway.Models.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
    var fieldLabelClass = "block text-sm font-medium mb-2";
    var fieldLabelStyle = "color: #1E3A5F;";
    var textInputClass = "block w-full px-4 py-2.5 border rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors";
    var inputBorderStyle = "border-color: #E2E8F0;";
    var validationClass = "text-xs text-red-600 mt-1 block";
    var selectClass = "block w-full px-4 py-2.5 border rounded-lg appearance-none focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors bg-white";
}

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="mx-auto h-14 w-14 rounded-lg flex items-center justify-center mb-4"
                 style="background-color: #1E3A5F;">
                <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                </svg>
            </div>
            <h2 class="text-2xl font-semibold" style="color: #1E3A5F;">Create New User</h2>
            <p class="text-sm mt-1" style="color: #64748B;">Add a new user to the DriveAway system</p>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-lg border border-gray-100 p-8">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded mb-6"
                     role="alert"></div>

                <!-- Email Input -->
                <div class="mb-5">
                      <label asp-for="Email" class="@fieldLabelClass" style="@fieldLabelStyle">Email
                        Address</label>
                        <input asp-for="Email"
                           class="@textInputClass"
                           style="@inputBorderStyle" placeholder="user@example.com" />
                       <span asp-validation-for="Email" class="@validationClass"></span>
                    </div>

                    @{
                        var passwordFields = new List<dynamic>
                        {
                            new { For = "Password", Label = "Password", Id = "password-input", ToggleId = "toggle-password", EyeId = "eye-icon", EyeSlashId = "eye-slash-icon", Placeholder = "Enter password" },
                            new { For = "ConfirmPassword", Label = "Confirm Password", Id = "confirm-password-input", ToggleId = "toggle-confirm-password", EyeId = "confirm-eye-icon", EyeSlashId = "confirm-eye-slash-icon", Placeholder = "Confirm password" }
                        };
                    }

                    @foreach (var f in passwordFields)
                    {
                        <div class="mb-5">
                            <label asp-for="@f.For" class="@fieldLabelClass" style="@fieldLabelStyle">@f.Label</label>
                            <div class="relative">
                                <input asp-for="@f.For" type="password" id="@f.Id"
                                       class="@textInputClass pr-10"
                                       style="@inputBorderStyle" placeholder="@f.Placeholder" />
                                <button type="button" id="@f.ToggleId"
                                        class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500 hover:text-[#FF6B00] focus:outline-none focus:text-[#FF6B00]">
                                    <svg id="@f.EyeId" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                    <svg id="@f.EyeSlashId" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="@f.For" class="@validationClass"></span>
                        </div>
                    }

                    <!-- Role Selection -->
                    <div class="mb-6">
                        <label asp-for="SelectedRole" class="@fieldLabelClass" style="@fieldLabelStyle">Assign
                            Role</label>
                            <div class="relative">
                                <select asp-for="SelectedRole" asp-items="ViewBag.Roles" id="roleSelect"
                                        class="@selectClass"
                                        style="@inputBorderStyle color: #1E3A5F;">
                                    <option value="">-- Select Role --</option>
                                </select>
                                <div
                                    class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Branch Assignment -->
                        @if (ViewBag.IsAdminUser == true)
                        {
                            <div class="mb-6" id="branch-section">
                                <label class="@fieldLabelClass" style="@fieldLabelStyle">Assign Branch</label>
                                <input type="hidden" asp-for="BranchId" value="@ViewBag.AdminBranchId" />
                                <input type="text" class="block w-full px-4 py-2.5 border rounded-lg bg-gray-50 cursor-not-allowed"
                                       style="@inputBorderStyle color: #64748B;" value="@ViewBag.AdminBranchName" disabled />
                                <p class="text-xs mt-1" style="color: #64748B;">Auto-assigned to your branch</p>
                            </div>
                        }
                        else
                        {
                            <div class="mb-6" id="branch-section">
                                <label asp-for="BranchId" class="@fieldLabelClass" style="@fieldLabelStyle">Assign
                                    Branch</label>
                                    <div class="relative">
                                        <select asp-for="BranchId" asp-items="ViewBag.Branches"
                                                class="@selectClass"
                                                style="@inputBorderStyle color: #1E3A5F;">
                                            <option value="">-- No Branch --</option>
                                        </select>
                                        <div
                                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Actions -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                                <button type="submit"
                                        class="px-6 py-2.5 rounded-lg text-sm font-medium text-white transition-colors"
                                        style="background-color: #1E3A5F;" onmouseover="this.style.backgroundColor='#FF6B00'"
                                        onmouseout="this.style.backgroundColor='#1E3A5F'">
                                    Create User
                                </button>
                                <a asp-action="Index" class="text-sm font-medium transition-colors" style="color: #64748B;"
                                   onmouseover="this.style.color='#FF6B00'" onmouseout="this.style.color='#64748B'"
                                              onfocus="this.style.color='#FF6B00'" onblur="this.style.color='#64748B'">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @section Scripts {
                @{
                    await Html.RenderPartialAsync("_ValidationScriptsPartial");
                }
                <script>
                    // Hide branch selection for top-level roles
                    document.getElementById('roleSelect')?.addEventListener('change', function () {
                        var branchSection = document.getElementById('branch-section');
                        if (branchSection) {
                            var role = this.value;
                            if (role === 'Super Admin' || role === 'Business Owner') {
                                branchSection.style.display = 'none';
                            } else {
                                branchSection.style.display = 'block';
                            }
                        }
                    });

                    // Toggle password visibility for configured fields
                    (function () {
                        var fields = [
                            { inputId: 'password-input', toggleId: 'toggle-password', eyeId: 'eye-icon', eyeSlashId: 'eye-slash-icon' },
                            { inputId: 'confirm-password-input', toggleId: 'toggle-confirm-password', eyeId: 'confirm-eye-icon', eyeSlashId: 'confirm-eye-slash-icon' }
                        ];

                        fields.forEach(function (f) {
                            var toggle = document.getElementById(f.toggleId);
                            if (!toggle) return;
                            toggle.addEventListener('click', function () {
                                var input = document.getElementById(f.inputId);
                                var eye = document.getElementById(f.eyeId);
                                var eyeSlash = document.getElementById(f.eyeSlashId);
                                if (!input || !eye || !eyeSlash) return;
                                if (input.type === 'password') {
                                    input.type = 'text';
                                    eye.classList.add('hidden');
                                    eyeSlash.classList.remove('hidden');
                                } else {
                                    input.type = 'password';
                                    eye.classList.remove('hidden');
                                    eyeSlash.classList.add('hidden');
                                }
                            });
                        });
                    })();
                </script>
            }
