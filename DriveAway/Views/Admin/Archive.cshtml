@model DriveAway.Models.ArchiveViewModel
@{
    ViewData["Title"] = "Archive";
    var canModifyCategories = (bool)(ViewBag.CanModifyCategories ?? false);
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-2xl md:text-3xl font-semibold text-[#1E3A5F]">Archive</h1>
            <p class="text-sm text-gray-500 mt-1">View and restore archived users and categories</p>
        </div>

        <!-- Alert Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border-l-4 border-[#1E3A5F] text-[#1E3A5F] px-4 py-3 rounded-lg mb-6 flex items-center shadow-sm" role="alert">
                <svg class="h-5 w-5 mr-2 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="block sm:inline">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded-lg mb-6 flex items-center shadow-sm" role="alert">
                <svg class="h-5 w-5 mr-2 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="block sm:inline">@TempData["Error"]</span>
            </div>
        }

        <!-- Tabs -->
        <div class="mb-6 border-b border-gray-200">
            <nav class="-mb-px flex space-x-8" id="archiveTabs">
                <button type="button" data-tab="users"
                        class="archive-tab active-tab whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium transition-colors duration-200 border-[#1E3A5F] text-[#1E3A5F]">
                    <svg class="h-4 w-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    Archived Users
                    <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">@Model.ArchivedUsers.Count</span>
                </button>
                <button type="button" data-tab="categories"
                        class="archive-tab whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium transition-colors duration-200 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
                    <svg class="h-4 w-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l5 5a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-5-5A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                    Archived Categories
                    <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">@Model.ArchivedCategories.Count</span>
                </button>
            </nav>
        </div>

        <!-- Archived Users Tab -->
        <div id="tab-users" class="tab-content">
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Branch</th>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th scope="col" class="px-6 py-4 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var item in Model.ArchivedUsers)
                            {
                                <tr class="hover:bg-gray-50 transition-colors duration-150">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
                                                <span class="text-xs font-medium text-gray-500">
                                                    @item.Email.Substring(0, 1).ToUpper()
                                                </span>
                                            </div>
                                            <div class="ml-3">
                                                <div class="text-sm font-medium text-gray-500">@item.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (item.Roles != null && item.Roles.Any())
                                        {
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var role in item.Roles)
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                        @role
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (!string.IsNullOrEmpty(item.BranchName))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                                                @item.BranchName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 text-sm">—</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                            <svg class="h-2 w-2 mr-1 fill-current" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                                            Archived
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <form asp-controller="UserManagement" asp-action="Restore" asp-route-id="@item.Id" method="post" class="inline"
                                              onsubmit="return confirm('Are you sure you want to restore this user?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="text-[#1E3A5F] hover:text-green-600 transition-colors duration-200 flex items-center justify-end"
                                                    title="Restore user">
                                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                                </svg>
                                                <span class="ml-1">Restore</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.ArchivedUsers.Any())
                {
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-[#1E3A5F]">No archived users</h3>
                        <p class="mt-1 text-sm text-gray-500">Archived users will appear here.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Archived Categories Tab -->
        <div id="tab-categories" class="tab-content hidden">
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Daily Rate</th>
                                <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                @if (canModifyCategories)
                                {
                                    <th scope="col" class="px-6 py-4 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var item in Model.ArchivedCategories)
                            {
                                <tr class="hover:bg-gray-50 transition-colors duration-150">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
                                                <span class="text-xs font-medium text-gray-500">
                                                    @item.Category.Substring(0, 1).ToUpper()
                                                </span>
                                            </div>
                                            <div class="ml-3">
                                                <div class="text-sm font-medium text-gray-500">@item.Category</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                            ₱@item.DailyRate.ToString("N2")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                            <svg class="h-2 w-2 mr-1 fill-current" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                                            Archived
                                        </span>
                                    </td>
                                    @if (canModifyCategories)
                                    {
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <form asp-controller="CategoryRates" asp-action="Restore" asp-route-id="@item.Id" method="post" class="inline"
                                                  onsubmit="return confirm('Are you sure you want to restore this category?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="text-[#1E3A5F] hover:text-green-600 transition-colors duration-200 flex items-center justify-end"
                                                        title="Restore category">
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                                    </svg>
                                                    <span class="ml-1">Restore</span>
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.ArchivedCategories.Any())
                {
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-[#1E3A5F]">No archived categories</h3>
                        <p class="mt-1 text-sm text-gray-500">Archived categories will appear here.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Footer Stats -->
        <div class="mt-4 text-xs text-gray-400 flex items-center justify-end">
            <span>Archived users: @Model.ArchivedUsers.Count</span>
            <span class="mx-2">·</span>
            <span>Archived categories: @Model.ArchivedCategories.Count</span>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabs = document.querySelectorAll('.archive-tab');
        const tabContents = document.querySelectorAll('.tab-content');

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                const target = tab.getAttribute('data-tab');

                // Update tab styles
                tabs.forEach(function (t) {
                    t.classList.remove('border-[#1E3A5F]', 'text-[#1E3A5F]');
                    t.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
                });
                tab.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
                tab.classList.add('border-[#1E3A5F]', 'text-[#1E3A5F]');

                // Show/hide content
                tabContents.forEach(function (content) {
                    content.classList.add('hidden');
                });
                document.getElementById('tab-' + target).classList.remove('hidden');
            });
        });
    });
</script>
