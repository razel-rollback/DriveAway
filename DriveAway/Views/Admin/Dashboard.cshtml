                            <div class="h-full bg-[#FF6B00] rounded-lg" style="width: 95%"></div>
                        </div>
                        <span class="text-xs font-medium text-[#1E3A5F] ml-3">25</span>
                    </div>
                    <div class="flex items-center">
                        <span class="text-xs text-gray-500 w-20">Sat</span>
                        <div class="flex-1 h-8 bg-gray-100 rounded-lg overflow-hidden">
