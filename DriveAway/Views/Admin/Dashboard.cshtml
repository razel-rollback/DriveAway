                            <span class="text-xs font-medium text-gray-600">Commercial</span>
                            <span class="text-xs font-medium text-[#1E3A5F]">7/10</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-[#1E3A5F] h-2 rounded-full" style="width: 70%"></div>
                        </div>
                        <span class="text-xs text-gray-400 mt-1">70% utilized</span>
                    </div>
