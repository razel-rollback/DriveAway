                        </div>
                        <div class="text-right">
                            <p class="text-xs font-medium text-gray-700">₱4,800</p>
                            <p class="text-xs text-gray-400">Yesterday, 11:15 AM</p>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="h-8 w-8 bg-[#1E3A5F]/10 rounded-lg flex items-center justify-center">
                                <span class="text-xs font-semibold text-[#1E3A5F]">HC</span>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-[#1E3A5F]">Honda Civic</p>
                                <p class="text-xs text-gray-400">GHI-3456 • Ana Garcia</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-medium text-gray-700">₱2,800</p>
                            <p class="text-xs text-gray-400">2 days ago</p>
