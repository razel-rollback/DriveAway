                <div class="flex items-end justify-between">
                    <span class="text-2xl font-bold text-[#1E3A5F]">156</span>
                    <span class="text-xs text-gray-400">New this month: 23</span>
                </div>
                <div class="mt-3 flex items-center text-xs text-gray-500">
                    <span class="font-medium text-[#1E3A5F]">89%</span>
                    <span class="ml-1">returning customers</span>
                </div>
            </div>

            <!-- Monthly Revenue Card -->
