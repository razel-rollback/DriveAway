                            <span class="inline-block w-3 h-3 bg-[#FF6B00] rounded-full mr-1"></span>
                            <span class="text-xs text-gray-600">Weekends</span>
                        </div>
                    </div>
                    <span class="text-xs text-gray-400">Total: 149 rentals</span>
                </div>
            </div>

            <!-- Vehicle Utilization -->
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-semibold text-[#1E3A5F]">Fleet Status</h2>
