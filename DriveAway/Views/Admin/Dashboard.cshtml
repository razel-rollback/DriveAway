@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-semibold text-[#1E3A5F]">Admin Dashboard</h1>
                <p class="text-sm text-gray-500 mt-1">Welcome back! Here's your business overview</p>
            </div>
            <div class="mt-4 sm:mt-0 flex items-center space-x-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#1E3A5F]/10 text-[#1E3A5F]">
                    <span class="inline-block w-1.5 h-1.5 bg-[#1E3A5F] rounded-full mr-1.5"></span>
                    Today: @DateTime.Now.ToString("MMM dd, yyyy")
                </span>
            </div>
        </div>

        <!-- Key Metrics Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Total Vehicles Card -->
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <div class="bg-[#1E3A5F]/10 rounded-lg p-2">
                        <svg class="h-6 w-6 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                        </svg>
                    </div>
                    <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full">+12%</span>
                </div>
                <h3 class="text-sm font-medium text-gray-500 mb-1">Total Vehicles</h3>
                <div class="flex items-end justify-between">
                    <span class="text-2xl font-bold text-[#1E3A5F]">48</span>
                    <span class="text-xs text-gray-400">12 available</span>
                </div>
                <div class="mt-3 w-full bg-gray-200 rounded-full h-1.5">
                    <div class="bg-[#FF6B00] h-1.5 rounded-full" style="width: 25%"></div>
                </div>
            </div>

            <!-- Active Rentals Card -->
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <div class="bg-[#1E3A5F]/10 rounded-lg p-2">
                        <svg class="h-6 w-6 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <span class="text-xs font-medium text-[#FF6B00] bg-[#FF6B00]/10 px-2 py-1 rounded-full">+8%</span>
                </div>
                <h3 class="text-sm font-medium text-gray-500 mb-1">Active Rentals</h3>
                <div class="flex items-end justify-between">
                    <span class="text-2xl font-bold text-[#1E3A5F]">24</span>
                    <span class="text-xs text-gray-400">Due today: 6</span>
                </div>
                <div class="mt-3 flex items-center text-xs text-gray-500">
                    <span class="inline-block w-2 h-2 bg-green-500 rounded-full mr-1"></span>
                    18 on time
                    <span class="inline-block w-2 h-2 bg-yellow-500 rounded-full mr-1 ml-3"></span>
                    6 due
                </div>
            </div>

            <!-- Total Customers Card -->
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <div class="bg-[#1E3A5F]/10 rounded-lg p-2">
                        <svg class="h-6 w-6 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
