                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-[#1E3A5F] h-2 rounded-full" style="width: 83%"></div>
                        </div>
                        <span class="text-xs text-gray-400 mt-1">83% utilized</span>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-medium text-gray-600">Luxury</span>
                            <span class="text-xs font-medium text-[#1E3A5F]">6/8</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-[#1E3A5F] h-2 rounded-full" style="width: 75%"></div>
                        </div>
