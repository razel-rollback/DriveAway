                    </div>
                    <span class="text-xs text-gray-400">77% currently rented</span>
                </div>
            </div>
        </div>

        <!-- Recent Rentals & Top Vehicles -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
