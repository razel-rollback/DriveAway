                        <svg class="h-6 w-6 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full">+23%</span>
                </div>
                <h3 class="text-sm font-medium text-gray-500 mb-1">Monthly Revenue</h3>
                <div class="flex items-end justify-between">
                    <span class="text-2xl font-bold text-[#1E3A5F]">₱456K</span>
                    <span class="text-xs text-gray-400">Target: ₱600K</span>
                </div>
                <div class="mt-3 w-full bg-gray-200 rounded-full h-1.5">
                    <div class="bg-[#1E3A5F] h-1.5 rounded-full" style="width: 76%"></div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
