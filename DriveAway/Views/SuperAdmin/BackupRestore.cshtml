@using DriveAway.Services
@{
    ViewData["Title"] = "Backup & Restore";
    var backups = ViewBag.Backups as List<BackupFileInfo> ?? new List<BackupFileInfo>();
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg = TempData["ErrorMessage"] as string;
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-semibold text-[#0B1E3D]">Backup & Restore</h1>
                <div class="flex items-center mt-1">
                    <p class="text-sm text-gray-500">Manage database backups and restore points</p>
                    <span class="mx-2 text-gray-300">•</span>
                    @if (ViewBag.LastRestoredBackup != null)
                    {
                        <span class="mx-2 text-gray-300">•</span>
                        <div class="flex items-center bg-amber-50 px-2 py-0.5 rounded border border-amber-100 shadow-sm">
                            <svg class="h-3 w-3 text-amber-600 mr-1.5" fill="none" stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span class="text-[10px] font-bold text-amber-700 uppercase tracking-wider">Active
                                Backup:</span>
                                <span class="ml-1.5 text-xs font-semibold text-[#0B1E3D]">@ViewBag.LastRestoredBackup</span>
                            </div>
                        }
                    else
                        {
                            <span class="mx-2 text-gray-300">•</span>
                            <div class="flex items-center bg-green-50 px-2 py-0.5 rounded border border-green-100">
                                <svg class="h-3 w-3 text-green-600 mr-1.5" fill="none" stroke="currentColor"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                                <span class="text-[10px] font-bold text-green-700 uppercase tracking-wider">Status:</span>
                                <span class="ml-1.5 text-xs font-semibold text-[#0B1E3D]">Live / No Restore</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="mt-4 sm:mt-0 flex items-center space-x-3">
                    <span
                        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#0B1E3D]/10 text-[#0B1E3D]">
                        <span class="inline-block w-1.5 h-1.5 bg-[#FF6B00] rounded-full mr-1.5"></span>
                        System Administration
                    </span>
                    <a asp-action="Dashboard"
                       class="inline-flex items-center px-3 py-1.5 text-xs font-medium text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                        <svg class="h-3.5 w-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Dashboard
                    </a>
                </div>
            </div>

            <!-- Toast Messages -->
            @if (!string.IsNullOrEmpty(successMsg))
            {
                <div id="successToast"
                     class="mb-6 flex items-center p-4 rounded-xl bg-green-50 border border-green-200 shadow-sm animate-fade-in">
                    <div class="bg-green-100 rounded-lg p-2 mr-3 flex-shrink-0">
                        <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <p class="text-sm font-medium text-green-800 flex-1">@successMsg</p>
                    <button onclick="this.parentElement.remove()" class="ml-3 text-green-400 hover:text-green-600"><svg
                        class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div id="errorToast"
                     class="mb-6 flex items-center p-4 rounded-xl bg-red-50 border border-red-200 shadow-sm animate-fade-in">
                    <div class="bg-red-100 rounded-lg p-2 mr-3 flex-shrink-0">
                        <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <p class="text-sm font-medium text-red-800 flex-1">@errorMsg</p>
                    <button onclick="this.parentElement.remove()" class="ml-3 text-red-400 hover:text-red-600"><svg
                        class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg></button>
                </div>
            }

            <!-- Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="bg-[#0B1E3D]/10 rounded-lg p-2.5">
                            <svg class="h-6 w-6 text-[#0B1E3D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4">
                                </path>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-2xl font-bold text-[#0B1E3D]">@backups.Count</h3>
                    <p class="text-sm font-medium text-gray-500">Total Backups</p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="bg-green-100 rounded-lg p-2.5">
                            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-2xl font-bold text-[#0B1E3D]">@(backups.Any() ? backups.First().CreatedAt.ToString("MMM dd, yyyy h:mm tt") : "—")</h3>
                    <p class="text-sm font-medium text-gray-500">Latest Backup</p>
                </div>
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="bg-[#FF6B00]/10 rounded-lg p-2.5">
                            <svg class="h-6 w-6 text-[#FF6B00]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12">
                                </path>
                            </svg>
                        </div>
                    </div>
                    @{
                        var totalSize = backups.Sum(b => b.SizeBytes);
                    }
                    <h3 class="text-2xl font-bold text-[#0B1E3D]">@FormatSize(totalSize)</h3>
                    <p class="text-sm font-medium text-gray-500">Total Storage Used</p>
                </div>
            </div>

            <!-- Create Backup Card -->
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-8">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div class="mb-4 sm:mb-0">
                        <h2 class="text-lg font-semibold text-[#0B1E3D]">Create New Backup</h2>
                        <p class="text-sm text-gray-500 mt-1">Create a full database backup. This may take a few moments
                            depending on database size.</p>
                        </div>
                        <button type="button" onclick="openModal('backupModal')"
                                class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-white bg-[#0B1E3D] rounded-lg hover:bg-[#152d52] transition-colors shadow-sm">
                            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Create Backup
                        </button>
                    </div>
                </div>

                <!-- Backups Table -->
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-5">
                        <h2 class="text-lg font-semibold text-[#0B1E3D]">Existing Backups</h2>
                        <span class="text-xs text-gray-400">@backups.Count backup(s) found</span>
                    </div>

                    @if (backups.Any())
                    {
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm">
                                <thead>
                                    <tr class="border-b border-gray-100">
                                        <th class="text-left py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                            Filename</th>
                                            <th class="text-left py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                Date Created</th>
                                                <th class="text-right py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                    Size</th>
                                                    <th
                                                        class="text-center py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                        Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var backup in backups)
                                                    {
                                                        <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                                                            <td class="py-3 px-4">
                                                                <div class="flex items-center">
                                                                    <div class="bg-slate-100 rounded-lg p-1.5 mr-3 flex-shrink-0">
                                                                        <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor"
                                                                             viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                  d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4">
                                                                            </path>
                                                                        </svg>
                                                                    </div>
                                                                    <span
                                                                    class="font-medium text-[#0B1E3D] text-xs sm:text-sm break-all">@backup.FileName</span>
                                                                </div>
                                                            </td>
                                                            <td class="py-3 px-4 text-gray-600">@backup.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                                                            <td class="py-3 px-4 text-right text-[#0B1E3D] font-medium">@FormatSize(backup.SizeBytes)
                                                            </td>
                                                            <td class="py-3 px-4">
                                                                <div class="flex items-center justify-center space-x-2">
                                                                    <button type="button" onclick="openRestoreModal('@backup.FileName')" title="Restore"
                                                                            class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-amber-700 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors border border-amber-200">
                                                                        <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor"
                                                                             viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                                                                            </path>
                                                                        </svg>
                                                                        Restore
                                                                    </button>
                                                                    <a asp-action="DownloadBackup" asp-route-fileName="@backup.FileName"
                                                                       title="Download"
                                                                       class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors border border-blue-200">
                                                                        <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor"
                                                                             viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4">
                                                                            </path>
                                                                        </svg>
                                                                        Download
                                                                    </a>
                                                                    <button type="button" onclick="openDeleteModal('@backup.FileName')" title="Delete"
                                                                            class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 transition-colors border border-red-200">
                                                                        <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor"
                                                                             viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                                            </path>
                                                                        </svg>
                                                                        Delete
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
            else
                                    {
                                        <div class="text-center py-12">
                                            <div class="bg-gray-100 rounded-full p-4 w-16 h-16 mx-auto mb-4 flex items-center justify-center">
                                                <svg class="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4">
                                                    </path>
                                                </svg>
                                            </div>
                                            <p class="text-sm text-gray-500 font-medium">No backups found</p>
                                            <p class="text-xs text-gray-400 mt-1">Create your first backup to get started</p>
                                        </div>
                                    }
                                </div>

                                <!-- Footer -->
                                <div class="text-center text-xs text-gray-400 mt-8">
                                    <p>Backups are stored on the server. Download important backups for off-site storage.</p>
                                </div>
                            </div>
                        </div>

                        <!-- ═══ Create Backup Confirmation Modal ═══ -->
                        <div id="backupModal" class="fixed inset-0 z-[9999] hidden" tabindex="0"
                             onkeypress="if(event.key === 'Escape'){ closeModal('backupModal'); }"
                             onkeydown="if(event.key === 'Escape'){ closeModal('backupModal'); }"
                             onkeyup="if(event.key === 'Escape'){ closeModal('backupModal'); }">
                            <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" tabindex="0" onclick="closeModal('backupModal')"
                                 onkeydown="if(event.key === 'Escape'){ closeModal('backupModal'); }"></div>
                            <div class="fixed inset-0 flex items-center justify-center p-4">
                                <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative transform transition-all">
                                    <div class="flex items-center mb-4">
                                        <div class="bg-[#0B1E3D]/10 rounded-xl p-3 mr-4">
                                            <svg class="h-6 w-6 text-[#0B1E3D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4">
                                                </path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3 class="text-lg font-semibold text-[#0B1E3D]">Create Database Backup</h3>
                                            <p class="text-sm text-gray-500">Confirm backup creation</p>
                                        </div>
                                    </div>
                                    <p class="text-sm text-gray-600 mb-6">Are you sure you want to create a full database backup for <strong
                                        class="text-[#0B1E3D]">@ViewBag.DatabaseName</strong>? This process may take a few moments depending
                                        on the database size.</p>
                                        <div class="flex items-center justify-end space-x-3">
                                            <button type="button" onclick="closeModal('backupModal')"
                                                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
                                            <form asp-action="CreateBackup" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="px-5 py-2 text-sm font-medium text-white bg-[#0B1E3D] rounded-lg hover:bg-[#152d52] transition-colors shadow-sm">
                                                    <svg class="h-4 w-4 mr-1.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7">
                                                        </path>
                                                    </svg>
                                                    Yes, Create Backup
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ═══ Restore Confirmation Modal ═══ -->
                            <div id="restoreModal" class="fixed inset-0 z-[9999] hidden" tabindex="0"
                                 onkeypress="if(event.key === 'Escape'){ closeModal('restoreModal'); }"
                                 onkeydown="if(event.key === 'Escape'){ closeModal('restoreModal'); }"
                                 onkeyup="if(event.key === 'Escape'){ closeModal('restoreModal'); }">
                                <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" tabindex="0" onclick="closeModal('restoreModal')"
                                     onkeydown="if(event.key === 'Escape'){ closeModal('restoreModal'); }"></div>
                                <div class="fixed inset-0 flex items-center justify-center p-4">
                                    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative transform transition-all">
                                        <div class="flex items-center mb-4">
                                            <div class="bg-red-100 rounded-xl p-3 mr-4">
                                                <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z">
                                                    </path>
                                                </svg>
                                            </div>
                                            <div>
                                                <h3 class="text-lg font-semibold text-red-700">Restore Database</h3>
                                                <p class="text-sm text-gray-500">This is a destructive operation</p>
                                            </div>
                                        </div>
                                        <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-4">
                                            <p class="text-sm text-red-800 font-medium">⚠ Warning: This will replace ALL current data in <strong
                                                class="underline">@ViewBag.DatabaseName</strong> with the selected backup. This action cannot be
                                                undone.</p>
                                            </div>
                                            <p class="text-sm text-gray-600 mb-2">Restoring from: <strong id="restoreFileName"
                                                                                                              class="text-[#0B1E3D]"></strong></p>
                                                <div class="flex items-center justify-end space-x-3 mt-6">
                                                    <button type="button" onclick="closeModal('restoreModal')"
                                                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
                                                    <form id="restoreForm" asp-action="RestoreBackup" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="fileName" id="restoreFileInput" />
                                                        <button type="submit"
                                                                class="px-5 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                                                            <svg class="h-4 w-4 mr-1.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                                                                </path>
                                                            </svg>
                                                            Yes, Restore Database
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ═══ Delete Confirmation Modal ═══ -->
                                    <div id="deleteModal" class="fixed inset-0 z-[9999] hidden" tabindex="0"
                                         onkeypress="if(event.key === 'Escape'){ closeModal('deleteModal'); }"
                                         onkeydown="if(event.key === 'Escape'){ closeModal('deleteModal'); }"
                                         onkeyup="if(event.key === 'Escape'){ closeModal('deleteModal'); }">
                                        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" tabindex="0" onclick="closeModal('deleteModal')"
                                             onkeydown="if(event.key === 'Escape'){ closeModal('deleteModal'); }"></div>
                                        <div class="fixed inset-0 flex items-center justify-center p-4">
                                            <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative transform transition-all">
                                                <div class="flex items-center mb-4">
                                                    <div class="bg-red-100 rounded-xl p-3 mr-4">
                                                        <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <h3 class="text-lg font-semibold text-[#0B1E3D]">Delete Backup</h3>
                                                        <p class="text-sm text-gray-500">Confirm deletion</p>
                                                    </div>
                                                </div>
                                                <p class="text-sm text-gray-600 mb-2">Are you sure you want to delete this backup file?</p>
                                                <p class="text-sm text-gray-600 mb-6">File: <strong id="deleteFileName" class="text-[#0B1E3D]"></strong></p>
                                                <div class="flex items-center justify-end space-x-3">
                                                    <button type="button" onclick="closeModal('deleteModal')"
                                                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
                                                    <form id="deleteForm" asp-action="DeleteBackup" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="fileName" id="deleteFileInput" />
                                                        <button type="submit"
                                                                class="px-5 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors shadow-sm">
                                                            <svg class="h-4 w-4 mr-1.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                                </path>
                                                            </svg>
                                                            Yes, Delete Backup
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

@functions {
    string FormatSize(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F2} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F2} MB";
        if (bytes >= 1_024) return $"{bytes / 1_024.0:F2} KB";
        return $"{bytes} bytes";
    }
}

@section Scripts {
    <script>
        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
        function openRestoreModal(fileName) {
            document.getElementById('restoreFileName').textContent = fileName;
            document.getElementById('restoreFileInput').value = fileName;
            openModal('restoreModal');
        }
        function openDeleteModal(fileName) {
            document.getElementById('deleteFileName').textContent = fileName;
            document.getElementById('deleteFileInput').value = fileName;
            openModal('deleteModal');
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeModal('backupModal'); closeModal('restoreModal'); closeModal('deleteModal'); } });
        // Auto-dismiss toasts after 6 seconds
        setTimeout(function () { var el = document.getElementById('successToast'); if (el) el.remove(); }, 6000);
        setTimeout(function () { var el = document.getElementById('errorToast'); if (el) el.remove(); }, 6000);
    </script>
}
