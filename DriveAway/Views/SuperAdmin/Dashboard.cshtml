                                                                                    datasets: [{
                                                                                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vehicleStatusCounts)),
                                                                                        backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#EF4444', '#6B7280'],
                                                                                        borderWidth: 0,
                                                                                        hoverOffset: 6
                                                                                    }]
                                                                                },
                                                                                options: {
                                                                                    responsive: true,
                                                                                    maintainAspectRatio: false,
                                                                                    cutout: '65%',
                                                                                    plugins: {
                                                                                        legend: { display: false },
                                                                                        tooltip: chartTooltip
                                                                                    }
                                                                                }
                                                                            });

                                                                            new Chart(document.getElementById('rentalsChart'), {
                                                                                type: 'bar',
                                                                                data: {
                                                                                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rentalsByMonth.Select(r => ((dynamic)r).Label))),
                                                                                    datasets: [{
                                                                                        label: 'Rentals',
                                                                                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rentalsByMonth.Select(r => ((dynamic)r).Count))),
                                                                                        backgroundColor: [
                                                                                            'rgba(11, 30, 61, 0.8)',
                                                                                            'rgba(30, 58, 95, 0.8)',
                                                                                            'rgba(255, 107, 0, 0.8)',
                                                                                            'rgba(11, 30, 61, 0.8)',
                                                                                            'rgba(30, 58, 95, 0.8)',
                                                                                            'rgba(255, 107, 0, 0.8)'
                                                                                        ],
                                                                                        borderRadius: 6,
                                                                                        borderSkipped: false,
                                                                                        maxBarThickness: 48
                                                                                    }]
                                                                                },
                                                                                options: createCartesianOptions({
                                                                                    y: {
                                                                                        beginAtZero: true,
                                                                                        ticks: { font: { size: 11 }, color: '#9CA3AF', stepSize: 1 },
                                                                                        grid: { color: 'rgba(0,0,0,0.04)' }
                                                                                    }
                                                                                })
                                                                            });

                                                                            // ─── User Roles (Polar Area Chart) ─────────────────────
                                                                            new Chart(document.getElementById('userRolesChart'), {
                                                                                type: 'polarArea',
                                                                                data: {
                                                                                    labels: ['Super Admins', 'Admins', 'Business Owners', 'Staff', 'Mechanics'],
                                                                                    datasets: [{
                                                                                        data: [@ViewBag.SuperAdmins, @ViewBag.Admins, @ViewBag.BusinessOwners, @ViewBag.Staff, @ViewBag.Mechanics],
                                                                                        backgroundColor: [
                                                                                            'rgba(11, 30, 61, 0.75)',
                                                                                            'rgba(30, 58, 95, 0.75)',
                                                                                            'rgba(255, 107, 0, 0.75)',
                                                                                            'rgba(59, 130, 246, 0.75)',
                                                                                            'rgba(245, 158, 11, 0.75)'
                                                                                        ],
                                                                                        borderWidth: 0
                                                                                    }]
                                                                                },
                                                                                options: {
                                                                                    responsive: true,
                                                                                    maintainAspectRatio: false,
                                                                                    plugins: {
                                                                                        legend: { display: false },
                                                                                        tooltip: chartTooltip
                                                                                    },
                                                                                    scales: {
                                                                                        r: {
                                                                                            ticks: { display: false },
                                                                                            grid: { color: 'rgba(0,0,0,0.04)' }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            });

                                                                            // ─── Custom Range Dropdown Toggle ──────────────────────
                                                                            const toggleBtn = document.getElementById('customRangeToggle');
                                                                            const dropdown = document.getElementById('customRangeDropdown');
                                                                            if (toggleBtn && dropdown) {
                                                                                toggleBtn.addEventListener('click', function (e) {
                                                                                    e.stopPropagation();
                                                                                    dropdown.classList.toggle('hidden');
                                                                                });
                                                                                document.addEventListener('click', function (e) {
                                                                                    if (!dropdown.contains(e.target) && e.target !== toggleBtn) {
                                                                                        dropdown.classList.add('hidden');
                                                                                    }
                                                                                });
                                                                            }
                                                                        </script>
                                                                    }