@using DriveAway.Models
@{
    ViewData["Title"] = "Super Admin Dashboard";

    var revenueByMonth = ViewBag.RevenueByMonth as List<object> ?? new List<object>();
    var rentalsByMonth = ViewBag.RentalsByMonth as List<object> ?? new List<object>();
    var vehicleStatusLabels = ViewBag.VehicleStatusLabels as string[] ?? Array.Empty<string>();
    var vehicleStatusCounts = ViewBag.VehicleStatusCounts as int[] ?? Array.Empty<int>();
    var branchData = ViewBag.BranchData as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var recentLogs = ViewBag.RecentAuditLogs as List<AuditLog> ?? new List<AuditLog>();

    var currentFilter = ViewBag.CurrentFilter as string ?? "month";
    var filterLabel = ViewBag.FilterLabel as string ?? "This Month";
    var filterStart = ViewBag.FilterStart as string ?? "";
    var filterEnd = ViewBag.FilterEnd as string ?? "";

    var primaryMetrics = new List<dynamic>
    {
        new
        {
            Title = "Total Users",
            ValueText = ViewBag.TotalUsers?.ToString() ?? "0",
            BadgeText = "Users",
            BadgeClass = "text-xs font-medium text-[#0B1E3D] bg-[#0B1E3D]/10 px-2 py-1 rounded-full",
            IconWrapperClass = "bg-[#0B1E3D]/10 rounded-lg p-2.5",
            IconClass = "h-6 w-6 text-[#0B1E3D]",
            IconPath = "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
            FooterText = $"{ViewBag.TotalRoles} roles configured"
        },
        new
        {
            Title = "Total Fleet",
            ValueText = ViewBag.TotalVehicles?.ToString() ?? "0",
            BadgeText = $"{ViewBag.AvailableVehicles} available",
            BadgeClass = "text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full",
            IconWrapperClass = "bg-[#1E3A5F]/10 rounded-lg p-2.5",
            IconClass = "h-6 w-6 text-[#1E3A5F]",
            IconPath = "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
            FooterText = $"₱{((decimal)ViewBag.TotalFleetValue).ToString("N0")} book value"
        },
        new
        {
            Title = "Active Rentals",
            ValueText = ViewBag.ActiveRentals?.ToString() ?? "0",
            BadgeText = (int)ViewBag.OverdueRentals > 0 ? $"{ViewBag.OverdueRentals} overdue" : "On track",
            BadgeClass = (int)ViewBag.OverdueRentals > 0
                ? "text-xs font-medium text-red-600 bg-red-50 px-2 py-1 rounded-full"
                : "text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full",
            IconWrapperClass = "bg-[#FF6B00]/10 rounded-lg p-2.5",
            IconClass = "h-6 w-6 text-[#FF6B00]",
            IconPath = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
            FooterText = $"@ViewBag.CompletedRentals completed total"
        },
        new
        {
            Title = "Revenue",
            ValueText = $"₱{((decimal)ViewBag.PeriodRevenue).ToString("N0")}",
            BadgeText = filterLabel,
            BadgeClass = "text-xs font-medium text-[#FF6B00] bg-[#FF6B00]/10 px-2 py-1 rounded-full",
            IconWrapperClass = "bg-green-100 rounded-lg p-2.5",
            IconClass = "h-6 w-6 text-green-600",
            IconPath = "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
            FooterText = $"₱{((decimal)ViewBag.TotalRevenue).ToString("N0")} lifetime"
        }
    };

    var secondaryMetrics = new List<dynamic>
    {
        new { Title = "Branches", ValueText = ViewBag.TotalBranches?.ToString() ?? "0", ValueClass = "text-lg font-bold text-[#0B1E3D]", IconWrapperClass = "bg-purple-100 rounded-lg p-2", IconClass = "h-5 w-5 text-purple-600", IconPath = "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
        new { Title = "Maintenance", ValueText = ViewBag.PendingMaintenance?.ToString() ?? "0", ValueClass = "text-lg font-bold text-[#0B1E3D]", IconWrapperClass = "bg-amber-100 rounded-lg p-2", IconClass = "h-5 w-5 text-amber-600", IconPath = "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" },
        new { Title = "Payments Collected", ValueText = $"₱{((decimal)ViewBag.TotalPaymentsCollected).ToString("N0")}", ValueClass = "text-lg font-bold text-[#0B1E3D]", IconWrapperClass = "bg-emerald-100 rounded-lg p-2", IconClass = "h-5 w-5 text-emerald-600", IconPath = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
        new { Title = "Pending Payments", ValueText = $"₱{((decimal)ViewBag.PendingPayments).ToString("N0")}", ValueClass = "text-lg font-bold text-[#0B1E3D]", IconWrapperClass = "bg-red-100 rounded-lg p-2", IconClass = "h-5 w-5 text-red-500", IconPath = "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" }
    };

    var nhtsaStatus = ViewBag.NhtsaApiStatus as string ?? "Unknown";
    var nhtsaBadge = nhtsaStatus == "Online" ? "bg-green-100 text-green-700" : nhtsaStatus == "Degraded" ? "bg-amber-100 text-amber-700" : "bg-red-100 text-red-700";
    var nhtsaDot = nhtsaStatus == "Online" ? "bg-green-500" : nhtsaStatus == "Degraded" ? "bg-amber-500" : "bg-red-500";
    var nhtsaIconWrapper = nhtsaStatus == "Online" ? "bg-green-100" : nhtsaStatus == "Degraded" ? "bg-amber-100" : "bg-red-100";
    var nhtsaIconClass = nhtsaStatus == "Online" ? "text-green-600" : nhtsaStatus == "Degraded" ? "text-amber-600" : "text-red-600";

    var pmStatus = ViewBag.PayMongoApiStatus as string ?? "Unknown";
    var pmBadge = pmStatus == "Online" ? "bg-green-100 text-green-700" : pmStatus == "Degraded" ? "bg-amber-100 text-amber-700" : "bg-red-100 text-red-700";
    var pmDot = pmStatus == "Online" ? "bg-green-500" : pmStatus == "Degraded" ? "bg-amber-500" : "bg-red-500";
    var pmIconWrapper = pmStatus == "Online" ? "bg-green-100" : pmStatus == "Degraded" ? "bg-amber-100" : "bg-red-100";
    var pmIconClass = pmStatus == "Online" ? "text-green-600" : pmStatus == "Degraded" ? "text-amber-600" : "text-red-600";

    var healthCards = new List<dynamic>
    {
        new { Title = "Active Sessions", Subtitle = "Last 30 min", ValueText = ViewBag.ActiveSessions?.ToString() ?? "0", ValueClass = "text-lg font-bold text-[#0B1E3D]", BadgeText = "", BadgeClass = "", DotClass = "", IconWrapperClass = "bg-indigo-100 rounded-lg p-2 flex-shrink-0", IconClass = "h-5 w-5 text-indigo-600", IconPath = "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z", Kind = "metric" },
        new { Title = "Database Size", Subtitle = "SQL Server", ValueText = $"@ViewBag.DatabaseSizeMb MB", ValueClass = "text-lg font-bold text-[#0B1E3D]", BadgeText = "", BadgeClass = "", DotClass = "", IconWrapperClass = "bg-slate-100 rounded-lg p-2 flex-shrink-0", IconClass = "h-5 w-5 text-slate-600", IconPath = "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4", Kind = "metric" },
        new { Title = "Web Server", Subtitle = "Up @ViewBag.ServerUptime", ValueText = "Online", ValueClass = "", BadgeText = "Online", BadgeClass = "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 mb-1", DotClass = "bg-green-500", IconWrapperClass = "bg-green-100 rounded-lg p-2 flex-shrink-0", IconClass = "h-5 w-5 text-green-600", IconPath = "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01", Kind = "status" },
        new { Title = "NHTSA API", Subtitle = "Vehicle data", ValueText = nhtsaStatus, ValueClass = "", BadgeText = nhtsaStatus, BadgeClass = nhtsaBadge, DotClass = nhtsaDot, IconWrapperClass = nhtsaIconWrapper, IconClass = nhtsaIconClass, IconPath = "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9", Kind = "status" },
        new { Title = "PayMongo API", Subtitle = "Payment gateway", ValueText = pmStatus, ValueClass = "", BadgeText = pmStatus, BadgeClass = pmBadge, DotClass = pmDot, IconWrapperClass = pmIconWrapper, IconClass = pmIconClass, IconPath = "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z", Kind = "status" }
    };

    var userRoleBreakdown = new List<dynamic>
    {
        new { Label = "Super Admins", Count = ViewBag.SuperAdmins ?? 0, DotClass = "bg-[#0B1E3D]" },
        new { Label = "Admins", Count = ViewBag.Admins ?? 0, DotClass = "bg-[#1E3A5F]" },
        new { Label = "Business Owners", Count = ViewBag.BusinessOwners ?? 0, DotClass = "bg-[#FF6B00]" },
        new { Label = "Staff", Count = ViewBag.Staff ?? 0, DotClass = "bg-blue-500" },
        new { Label = "Mechanics", Count = ViewBag.Mechanics ?? 0, DotClass = "bg-amber-500" }
    };

    var quickActions = new List<dynamic>
    {
        new { Controller = "UserManagement", Action = "Index", Label = "Users", IconPath = "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" },
        new { Controller = "RoleManagement", Action = "Index", Label = "Roles", IconPath = "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
        new { Controller = "BranchManagement", Action = "Index", Label = "Branches", IconPath = "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
        new { Controller = "AssetLifecycle", Action = "Index", Label = "Fleet", IconPath = "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" },
        new { Controller = "RentalOperations", Action = "Index", Label = "Rentals", IconPath = "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" },
        new { Controller = "AuditLog", Action = "Index", Label = "Audit Logs", IconPath = "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" }
    };

}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-semibold text-[#0B1E3D]">Super Admin Dashboard</h1>
                <p class="text-sm text-gray-500 mt-1">System-wide overview &amp; analytics</p>
            </div>
            <div class="mt-4 sm:mt-0 flex items-center space-x-3">
                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#0B1E3D]/10 text-[#0B1E3D]">
                    <span class="inline-block w-1.5 h-1.5 bg-[#FF6B00] rounded-full mr-1.5"></span>
                    Super Admin
                </span>
                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </span>
            </div>
        </div>

        <!-- ═══ Date Filter Bar ═══════════════════════════════════════════ -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex items-center gap-2">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z">
                        </path>
                    </svg>
                    <span class="text-sm font-medium text-gray-700">Filter:</span>
                    <span class="text-xs text-gray-500 bg-gray-100 px-2.5 py-1 rounded-full">@filterLabel</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <a asp-action="Dashboard" asp-route-filter="day"
                       class="px-4 py-2 text-xs font-medium rounded-lg transition-colors @(currentFilter == "day" ? "bg-[#0B1E3D] text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                        Day
                    </a>
                    <a asp-action="Dashboard" asp-route-filter="week"
                       class="px-4 py-2 text-xs font-medium rounded-lg transition-colors @(currentFilter == "week" ? "bg-[#0B1E3D] text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                        Week
                    </a>
                    <a asp-action="Dashboard" asp-route-filter="month"
                       class="px-4 py-2 text-xs font-medium rounded-lg transition-colors @(currentFilter == "month" ? "bg-[#0B1E3D] text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                        Month
                    </a>
                    <div class="relative">
                        <button id="customRangeToggle" type="button"
                                class="px-4 py-2 text-xs font-medium rounded-lg transition-colors flex items-center gap-1.5 @(currentFilter == "custom" ? "bg-[#0B1E3D] text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                </path>
                            </svg>
                            Custom
                        </button>
                        <div id="customRangeDropdown"
                             class="hidden absolute right-0 top-full mt-2 bg-white rounded-xl border border-gray-200 shadow-lg p-4 z-50 w-72">
                            <form asp-action="Dashboard" method="get" class="space-y-3">
                                <input type="hidden" name="filter" value="custom" />
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Start Date</label>
                                    <input type="date" name="startDate" value="@filterStart"
                                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#0B1E3D]/20 focus:border-[#0B1E3D] outline-none"
                                           required />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">End Date</label>
                                    <input type="date" name="endDate" value="@filterEnd"
                                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#0B1E3D]/20 focus:border-[#0B1E3D] outline-none"
                                           required />
                                </div>
                                <button type="submit"
                                        class="w-full py-2 text-xs font-medium text-white bg-[#FF6B00] rounded-lg hover:bg-[#e55f00] transition-colors">
                                    Apply Range
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ Key Metrics Row ═══════════════════════════════════════════ -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            @foreach (var metric in primaryMetrics)
            {
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="@metric.IconWrapperClass rounded-lg p-2.5">
                            <svg class="@metric.IconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@metric.IconPath"></path>
                            </svg>
                        </div>
                        <span class="@metric.BadgeClass">@metric.BadgeText</span>
                    </div>
                    <h3 class="text-2xl font-bold text-[#0B1E3D]">@metric.ValueText</h3>
                    <p class="text-sm font-medium text-gray-500 mb-1">@metric.Title</p>
                    <p class="text-xs text-gray-400 mt-2">@metric.FooterText</p>
                </div>
            }
        </div>

                <!-- ═══ Secondary Metrics ═════════════════════════════════════════ -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-8">
                    @foreach (var metric in secondaryMetrics)
                    {
                        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
                            <div class="flex items-center space-x-3">
                                <div class="@metric.IconWrapperClass rounded-lg p-2">
                                    <svg class="@metric.IconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@metric.IconPath"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-lg font-bold text-[#0B1E3D]">@metric.ValueText</p>
                                    <p class="text-xs text-gray-500">@metric.Title</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                        <!-- ═══ System Health ════════════════════════════════════════════ -->
                        <div class="mb-8">
                            <div class="flex items-center justify-between mb-4">
                                <h2 class="text-base font-semibold text-[#0B1E3D]">System Health</h2>
                                <span
                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700">
                                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                                    Server Online &middot; @ViewBag.ServerUptime uptime
                                </span>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">

                                <!-- Active Sessions -->
                                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
                                    <div class="flex items-center space-x-3">
                                        <div class="bg-indigo-100 rounded-lg p-2 flex-shrink-0">
                                            <svg class="h-5 w-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="text-lg font-bold text-[#0B1E3D]">@ViewBag.ActiveSessions</p>
                                            <p class="text-xs text-gray-500">Active Sessions</p>
                                            <p class="text-xs text-gray-400">Last 30 min</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Database Size -->
                                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
                                    <div class="flex items-center space-x-3">
                                        <div class="bg-slate-100 rounded-lg p-2 flex-shrink-0">
                                            <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="text-lg font-bold text-[#0B1E3D]">@ViewBag.DatabaseSizeMb <span
                                                class="text-sm font-normal text-gray-500">MB</span></p>
                                                <p class="text-xs text-gray-500">Database Size</p>
                                                <p class="text-xs text-gray-400">SQL Server</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Web Server Status -->
                                    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
                                        <div class="flex items-center space-x-3">
                                            <div class="bg-green-100 rounded-lg p-2 flex-shrink-0">
                                                <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                                                </svg>
                                            </div>
                                            <div>
                                                <span
                                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 mb-1">
                                                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                                                    Online
                                                </span>
                                                <p class="text-xs text-gray-500">Web Server</p>
                                                <p class="text-xs text-gray-400">Up @ViewBag.ServerUptime</p>
                                            </div>
                                        </div>
                                    </div>

                                    @foreach (var card in healthCards)
                                    {
                                        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
                                            <div class="flex items-center space-x-3">
                                                <div class="@card.IconWrapperClass rounded-lg p-2 flex-shrink-0">
                                                    <svg class="h-5 w-5 @card.IconClass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@card.IconPath"></path>
                                                    </svg>
                                                </div>
                                                <div>
                                                    @if (card.Kind == "status")
                                                    {
                                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium @card.BadgeClass mb-1">
                                                            <span class="w-1.5 h-1.5 @card.DotClass rounded-full"></span>
                                                            @card.BadgeText
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-lg font-bold text-[#0B1E3D]">@card.ValueText</p>
                                                    }
                                                    <p class="text-xs text-gray-500">@card.Title</p>
                                                    <p class="text-xs text-gray-400">@card.Subtitle</p>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>

                            <!-- ═══ Charts Row ════════════════════════════════════════════════ -->
                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                                <!-- Revenue Trend (Line Chart) -->
                                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 lg:col-span-2">
                                    <div class="flex items-center justify-between mb-4">
                                        <h2 class="text-lg font-semibold text-[#0B1E3D]">Revenue Trend</h2>
                                        <span class="text-xs text-gray-400">@filterLabel</span>
                                    </div>
                                    <div class="relative" style="height: 280px;">
                                        <canvas id="revenueChart"></canvas>
                                    </div>
                                </div>

                                <!-- Vehicle Status (Doughnut Chart) -->
                                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                                    <div class="flex items-center justify-between mb-4">
                                        <h2 class="text-lg font-semibold text-[#0B1E3D]">Fleet Status</h2>
                                        <span class="text-xs text-gray-400">Current</span>
                                    </div>
                                    <div class="relative flex items-center justify-center" style="height: 220px;">
                                        <canvas id="vehicleStatusChart"></canvas>
                                    </div>
                                    <div class="mt-4 grid grid-cols-2 gap-2">
                                        <div class="flex items-center text-xs">
                                            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 mr-2"></span>
                                            <span class="text-gray-600">Available <span
                                                class="font-semibold text-[#0B1E3D]">@ViewBag.AvailableVehicles</span></span>
                                            </div>
                                            <div class="flex items-center text-xs">
                                                <span class="inline-block w-2.5 h-2.5 rounded-full bg-blue-500 mr-2"></span>
                                                <span class="text-gray-600">Rented <span
                                                    class="font-semibold text-[#0B1E3D]">@ViewBag.RentedVehicles</span></span>
                                                </div>
                                                <div class="flex items-center text-xs">
                                                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500 mr-2"></span>
                                                    <span class="text-gray-600">Maintenance <span
                                                        class="font-semibold text-[#0B1E3D]">@ViewBag.UnderMaintenance</span></span>
                                                    </div>
                                                    <div class="flex items-center text-xs">
                                                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-500 mr-2"></span>
                                                        <span class="text-gray-600">Out of Service <span
                                                            class="font-semibold text-[#0B1E3D]">@ViewBag.OutOfService</span></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- ═══ Rentals Chart + User Distribution ═════════════════════════ -->
                                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                                                <!-- Rentals Per Month (Bar Chart) -->
                                                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 lg:col-span-2">
                                                    <div class="flex items-center justify-between mb-4">
                                                        <h2 class="text-lg font-semibold text-[#0B1E3D]">Rental Activity</h2>
                                                        <span class="text-xs text-gray-400">@filterLabel</span>
                                                    </div>
                                                    <div class="relative" style="height: 280px;">
                                                        <canvas id="rentalsChart"></canvas>
                                                    </div>
                                                </div>

                                                <!-- User Distribution (Polar Area Chart) -->
                                                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                                                    <div class="flex items-center justify-between mb-4">
                                                        <h2 class="text-lg font-semibold text-[#0B1E3D]">Users by Role</h2>
                                                        <span class="text-xs text-gray-400">@ViewBag.TotalUsers total</span>
                                                    </div>
                                                    <div class="relative flex items-center justify-center" style="height: 220px;">
                                                        <canvas id="userRolesChart"></canvas>
                                                    </div>
                                                    <div class="mt-4 space-y-2">
                                                        @foreach (var role in userRoleBreakdown)
                                                        {
                                                            <div class="flex items-center justify-between text-xs">
                                                                <div class="flex items-center">
                                                                    <span class="inline-block w-2.5 h-2.5 rounded-full @role.DotClass mr-2"></span>
                                                                    <span class="text-gray-600">@role.Label</span>
                                                                </div>
                                                                <span class="font-semibold text-[#0B1E3D]">@role.Count</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- ═══ Branch Performance Table ══════════════════════════════════ -->
                                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-8">
                                                <div class="flex items-center justify-between mb-5">
                                                    <h2 class="text-lg font-semibold text-[#0B1E3D]">Branch Performance</h2>
                                                    <a asp-controller="BranchManagement" asp-action="Index"
                                                       class="text-xs text-[#FF6B00] hover:text-[#0B1E3D] font-medium transition-colors">
                                                        Manage Branches →
                                                    </a>
                                                </div>
                                                <div class="overflow-x-auto">
                                                    <table class="min-w-full text-sm">
                                                        <thead>
                                                            <tr class="border-b border-gray-100">
                                                                <th class="text-left py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                                    Branch</th>
                                                                    <th class="text-left py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                                        City</th>
                                                                        <th
                                                                            class="text-center py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                                            Fleet Size</th>
                                                                            <th
                                                                                class="text-center py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                                                Active Rentals</th>
                                                                                <th class="text-right py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                                                    Fleet Value</th>
                                                                                    <th
                                                                                        class="text-center py-3 px-4 font-medium text-gray-500 text-xs uppercase tracking-wider">
                                                                                        Utilization</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var branch in branchData)
                                                                                    {
                                                                                        var utilization = (int)branch.FleetSize > 0
                                                                                            ? Math.Round((double)(int)branch.ActiveRentals / (int)branch.FleetSize * 100, 0)
                                                                                            : 0;
                                                                                        <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                                                                                            <td class="py-3 px-4 font-medium text-[#0B1E3D]">@branch.Name</td>
                                                                                            <td class="py-3 px-4 text-gray-600">@branch.City</td>
                                                                                            <td class="py-3 px-4 text-center text-[#0B1E3D] font-medium">@branch.FleetSize</td>
                                                                                            <td class="py-3 px-4 text-center">
                                                                                                <span
                                                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                                                                                                    @branch.ActiveRentals
                                                                                                </span>
                                                                                            </td>
                                                                                            <td class="py-3 px-4 text-right text-[#0B1E3D] font-medium">
                                                                                                ₱@(((decimal)branch.FleetValue).ToString("N0"))</td>
                                                                                                <td class="py-3 px-4">
                                                                                                    <div class="flex items-center justify-center space-x-2">
                                                                                                        <div class="w-16 bg-gray-200 rounded-full h-1.5">
                                                                                                            <div class="h-1.5 rounded-full @(utilization >= 70 ? "bg-green-500" : utilization >= 40 ? "bg-amber-500" : "bg-red-400")"
                                                                                                                 style="width: @(utilization)%"></div>
                                                                                                        </div>
                                                                                                        <span class="text-xs font-medium text-gray-600">@(utilization)%</span>
                                                                                                    </div>
                                                                                                </td>
                                                                                            </tr>
                                                                                        }
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </div>

                                                                        <!-- ═══ Maintenance Summary + Audit Log ═══════════════════════════ -->
                                                                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                                                                            <!-- Maintenance Overview -->
                                                                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                                                                                <div class="flex items-center justify-between mb-5">
                                                                                    <h2 class="text-lg font-semibold text-[#0B1E3D]">Maintenance Overview</h2>
                                                                                    <a asp-controller="Maintenance" asp-action="Jobs"
                                                                                       class="text-xs text-[#FF6B00] hover:text-[#0B1E3D] font-medium transition-colors">
                                                                                        View All →
                                                                                    </a>
                                                                                </div>
                                                                                <div class="space-y-4">
                                                                                    <div class="flex items-center justify-between p-3 bg-amber-50 rounded-lg">
                                                                                        <div class="flex items-center space-x-3">
                                                                                            <div class="bg-amber-100 rounded-lg p-2">
                                                                                                <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor"
                                                                                                     viewBox="0 0 24 24">
                                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                                                                </svg>
                                                                                            </div>
                                                                                            <div>
                                                                                                <p class="text-sm font-medium text-[#0B1E3D]">Pending Jobs</p>
                                                                                                <p class="text-xs text-gray-500">Awaiting assignment</p>
                                                                                            </div>
                                                                                        </div>
                                                                                        <span class="text-xl font-bold text-amber-600">@ViewBag.PendingMaintenance</span>
                                                                                    </div>
                                                                                    <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                                                                                        <div class="flex items-center space-x-3">
                                                                                            <div class="bg-blue-100 rounded-lg p-2">
                                                                                                <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor"
                                                                                                     viewBox="0 0 24 24">
                                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                                                                                                    </path>
                                                                                                </svg>
                                                                                            </div>
                                                                                            <div>
                                                                                                <p class="text-sm font-medium text-[#0B1E3D]">In Progress</p>
                                                                                                <p class="text-xs text-gray-500">Currently being repaired</p>
                                                                                            </div>
                                                                                        </div>
                                                                                        <span class="text-xl font-bold text-blue-600">@ViewBag.InProgressMaintenance</span>
                                                                                    </div>
                                                                                    <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                                                                                        <div class="flex items-center space-x-3">
                                                                                            <div class="bg-green-100 rounded-lg p-2">
                                                                                                <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor"
                                                                                                     viewBox="0 0 24 24">
                                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                                                                </svg>
                                                                                            </div>
                                                                                            <div>
                                                                                                <p class="text-sm font-medium text-[#0B1E3D]">Completed</p>
                                                                                                <p class="text-xs text-gray-500">All-time completed</p>
                                                                                            </div>
                                                                                        </div>
                                                                                        <span class="text-xl font-bold text-green-600">@ViewBag.CompletedMaintenance</span>
                                                                                    </div>
                                                                                    <div class="pt-3 border-t border-gray-100">
                                                                                        <div class="flex items-center justify-between">
                                                                                            <span class="text-xs text-gray-500">Total Maintenance Cost</span>
                                                                                            <span
                                                                                            class="text-sm font-bold text-[#0B1E3D]">₱@(((decimal)ViewBag.TotalMaintenanceCost).ToString("N0"))</span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <!-- Recent Audit Logs -->
                                                                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
                                                                                <div class="flex items-center justify-between mb-5">
                                                                                    <h2 class="text-lg font-semibold text-[#0B1E3D]">Recent Activity</h2>
                                                                                    <a asp-controller="AuditLog" asp-action="Index"
                                                                                       class="text-xs text-[#FF6B00] hover:text-[#0B1E3D] font-medium transition-colors">
                                                                                        View All →
                                                                                    </a>
                                                                                </div>
                                                                                <div class="space-y-3 max-h-[340px] overflow-y-auto pr-1">
                                                                                    @foreach (var log in recentLogs)
                                                                                    {
                                                                                        <div class="flex items-start space-x-3 p-2.5 rounded-lg hover:bg-gray-50 transition-colors">
                                                                                            <div class="mt-0.5 flex-shrink-0">
                                                                                                @if (log.Action.Contains("Create") || log.Action.Contains("Add") ||
                                                                                            log.Action.Contains("Register"))
                                                                                                {
                                                                                                    <div class="bg-green-100 rounded-full p-1.5">
                                                                                                        <svg class="h-3 w-3 text-green-600" fill="none" stroke="currentColor"
                                                                                                             viewBox="0 0 24 24">
                                                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                                  d="M12 4v16m8-8H4"></path>
                                                                                                        </svg>
                                                                                                    </div>
                                                                                                }
                                                                                                else if (log.Action.Contains("Update") || log.Action.Contains("Edit") ||
                                                                                            log.Action.Contains("Assign"))
                                                                                                {
                                                                                                    <div class="bg-blue-100 rounded-full p-1.5">
                                                                                                        <svg class="h-3 w-3 text-blue-600" fill="none" stroke="currentColor"
                                                                                                             viewBox="0 0 24 24">
                                                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                                                                            </path>
                                                                                                        </svg>
                                                                                                    </div>
                                                                                                }
                                                                                                else if (log.Action.Contains("Delete") || log.Action.Contains("Remove"))
                                                                                                {
                                                                                                    <div class="bg-red-100 rounded-full p-1.5">
                                                                                                        <svg class="h-3 w-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                                                                            </path>
                                                                                                        </svg>
                                                                                                    </div>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <div class="bg-gray-100 rounded-full p-1.5">
                                                                                                        <svg class="h-3 w-3 text-gray-600" fill="none" stroke="currentColor"
                                                                                                             viewBox="0 0 24 24">
                                                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                                                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                                                                        </svg>
                                                                                                    </div>
                                                                                                }
                                                                                            </div>
                                                                                            <div class="flex-1 min-w-0">
                                                                                                <p class="text-sm font-medium text-[#0B1E3D] truncate">@log.Action</p>
                                                                                                <p class="text-xs text-gray-500 truncate">@log.Module — @(log.UserEmail ?? "System")</p>
                                                                                                <p class="text-xs text-gray-400 mt-0.5">@log.Timestamp.ToString("MMM dd, yyyy h:mm tt")</p>
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                    @if (!recentLogs.Any())
                                                                                    {
                                                                                        <div class="text-center py-6">
                                                                                            <p class="text-sm text-gray-400">No recent activity</p>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- ═══ Quick Actions ═════════════════════════════════════════════ -->
                                                                        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 mb-8">
                                                                            <h2 class="text-lg font-semibold text-[#0B1E3D] mb-4">Quick Actions</h2>
                                                                            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                                                                                @foreach (var action in quickActions)
                                                                                {
                                                                                    <a asp-controller="@action.Controller" asp-action="@action.Action"
                                                                                       class="flex flex-col items-center p-4 bg-gray-50 rounded-lg hover:bg-[#0B1E3D]/5 transition-colors group">
                                                                                        <div class="h-10 w-10 bg-[#0B1E3D]/10 rounded-lg flex items-center justify-center mb-2 group-hover:bg-[#FF6B00]/10">
                                                                                            <svg class="h-5 w-5 text-[#0B1E3D] group-hover:text-[#FF6B00]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@action.IconPath"></path>
                                                                                            </svg>
                                                                                        </div>
                                                                                        <span class="text-xs font-medium text-[#0B1E3D] group-hover:text-[#FF6B00] text-center">@action.Label</span>
                                                                                    </a>
                                                                                }
                                                                                </div>
                                                                            </div>

                                                                            <!-- Footer -->
                                                                            <div class="text-center text-xs text-gray-400">
                                                                                <p>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy h:mm tt") • DriveAway Rental System</p>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    @section Scripts {
                                                                        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"
                                                                                integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC"
                                                                                crossorigin="anonymous"></script>
                                                                        <script>
                                                                            const navy = '#0B1E3D';
                                                                            const blue = '#1E3A5F';
                                                                            const orange = '#FF6B00';
                                                                            const chartTooltip = {
                                                                                backgroundColor: navy,
                                                                                titleFont: { size: 12 },
                                                                                bodyFont: { size: 12 },
                                                                                padding: 10,
                                                                                cornerRadius: 8
                                                                            };

                                                                            function createCartesianOptions(extraScales = {}) {
                                                                                return {
                                                                                    responsive: true,
                                                                                    maintainAspectRatio: false,
                                                                                    plugins: {
                                                                                        legend: { display: false },
                                                                                        tooltip: chartTooltip
                                                                                    },
                                                                                    scales: {
                                                                                        y: {
                                                                                            beginAtZero: true,
                                                                                            ticks: {
                                                                                                font: { size: 11 },
                                                                                                color: '#9CA3AF'
                                                                                            },
                                                                                            grid: { color: 'rgba(0,0,0,0.04)' }
                                                                                        },
                                                                                        x: {
                                                                                            ticks: { font: { size: 11 }, color: '#9CA3AF' },
                                                                                            grid: { display: false }
                                                                                        },
                                                                                        ...extraScales
                                                                                    }
                                                                                };
                                                                            }

                                                                            new Chart(document.getElementById('revenueChart'), {
                                                                                type: 'line',
                                                                                data: {
                                                                                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueByMonth.Select(r => ((dynamic)r).Label))),
                                                                                    datasets: [{
                                                                                        label: 'Revenue (₱)',
                                                                                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueByMonth.Select(r => ((dynamic)r).Revenue))),
                                                                                        borderColor: orange,
                                                                                        backgroundColor: 'rgba(255, 107, 0, 0.1)',
                                                                                        borderWidth: 2.5,
                                                                                        tension: 0.4,
                                                                                        fill: true,
                                                                                        pointBackgroundColor: orange,
                                                                                        pointBorderColor: '#fff',
                                                                                        pointBorderWidth: 2,
                                                                                        pointRadius: 5,
                                                                                        pointHoverRadius: 7
                                                                                    }]
                                                                                },
                                                                                options: createCartesianOptions({
                                                                                    y: {
                                                                                        beginAtZero: true,
                                                                                        ticks: {
                                                                                            callback: v => '₱' + (v >= 1000 ? (v / 1000).toFixed(0) + 'K' : v),
                                                                                            font: { size: 11 },
                                                                                            color: '#9CA3AF'
                                                                                        },
                                                                                        grid: { color: 'rgba(0,0,0,0.04)' }
                                                                                    }
                                                                                })
                                                                            });

                                                                            new Chart(document.getElementById('vehicleStatusChart'), {
                                                                                type: 'doughnut',
