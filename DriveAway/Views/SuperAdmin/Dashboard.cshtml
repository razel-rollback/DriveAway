@{
    ViewData["Title"] = "Super Admin Dashboard";
}

<div class="min-h-screen bg-gray-50">
    <!-- Welcome Header -->
    <div class="bg-[#1E3A5F] text-white rounded-xl p-8 mb-8 shadow-md">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">Welcome, Super Admin</h1>
                <p class="text-gray-200 text-lg">Manage your DriveAway rental system from this central dashboard</p>
            </div>
            <div class="hidden md:block">
                <div class="bg-[#FF6B00]/20 rounded-lg p-4">
                    <svg class="h-14 w-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Total Users Card -->
        <div class="bg-white rounded-lg border border-gray-100 p-6 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm mb-1">Total Users</p>
                    <p class="text-3xl font-bold text-[#1E3A5F]">@ViewBag.TotalUsers</p>
                </div>
                <div class="bg-[#1E3A5F]/10 rounded-lg p-3">
                    <svg class="h-7 w-7 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-3">
                <span class="text-xs text-[#FF6B00] font-medium">Registered users</span>
            </div>
        </div>

        <!-- Total Roles Card -->
        <div class="bg-white rounded-lg border border-gray-100 p-6 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm mb-1">Total Roles</p>
                    <p class="text-3xl font-bold text-[#1E3A5F]">@ViewBag.TotalRoles</p>
                </div>
                <div class="bg-[#1E3A5F]/10 rounded-lg p-3">
                    <svg class="h-7 w-7 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-3">
                <span class="text-xs text-[#FF6B00] font-medium">System roles</span>
            </div>
        </div>

        <!-- Super Admins Card -->
        <div class="bg-white rounded-lg border border-gray-100 p-6 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm mb-1">Super Admins</p>
                    <p class="text-3xl font-bold text-[#1E3A5F]">@ViewBag.SuperAdmins</p>
                </div>
                <div class="bg-[#1E3A5F]/10 rounded-lg p-3">
                    <svg class="h-7 w-7 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                    </svg>
                </div>
            </div>
            <div class="mt-3">
                <span class="text-xs text-[#FF6B00] font-medium">Administrators</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-lg border border-gray-100 p-8">
        <h2 class="text-xl font-semibold text-[#1E3A5F] mb-6">Quick Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Manage Roles -->
            <a asp-controller="RoleManagement" asp-action="Index"
               class="flex items-center p-4 bg-[#1E3A5F] text-white rounded-lg hover:bg-[#FF6B00] transition-colors group">
                <svg class="h-5 w-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <span class="font-medium">Manage Roles</span>
            </a>

            <!-- View Site -->
            <a asp-controller="Home" asp-action="Index"
               class="flex items-center p-4 bg-[#1E3A5F] text-white rounded-lg hover:bg-[#FF6B00] transition-colors group">
                <svg class="h-5 w-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                <span class="font-medium">View Site</span>
            </a>

            <!-- User Management -->
            <a asp-controller="UserManagement" asp-action="Index"
               class="flex items-center p-4 bg-[#1E3A5F] text-white rounded-lg hover:bg-[#FF6B00] transition-colors group">
                <svg class="h-5 w-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <span class="font-medium">User Management</span>
            </a>

            <!-- System Settings -->
            <a href="#"
               class="flex items-center p-4 bg-[#1E3A5F] text-white rounded-lg hover:bg-[#FF6B00] transition-colors group">
                <svg class="h-5 w-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="font-medium">Settings</span>
            </a>
        </div>
    </div>

    <!-- System Information -->
    <div class="bg-white rounded-lg border border-gray-100 p-8 mt-8">
        <h2 class="text-xl font-semibold text-[#1E3A5F] mb-6">System Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="border-l-4 pl-4" style="border-left-color: #1E3A5F;">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">Application</p>
                <p class="text-[#1E3A5F] font-semibold">DriveAway Rental System</p>
            </div>
            <div class="border-l-4 pl-4" style="border-left-color: #1E3A5F;">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">Version</p>
                <p class="text-[#1E3A5F] font-semibold">2.0.0</p>
            </div>
            <div class="border-l-4 pl-4" style="border-left-color: #1E3A5F;">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">Environment</p>
                <p class="text-[#1E3A5F] font-semibold">Production</p>
            </div>
            <div class="border-l-4 pl-4" style="border-left-color: #1E3A5F;">
                <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">Status</p>
                <p class="text-[#FF6B00] font-semibold flex items-center">
                    <span class="inline-block w-1.5 h-1.5 bg-[#FF6B00] rounded-full mr-2"></span>
                    Active
                </p>
            </div>
        </div>
    </div>

    <!-- Recent Activity (Optional) -->
    <div class="bg-white rounded-lg border border-gray-100 p-8 mt-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold text-[#1E3A5F]">Recent Activity</h2>
            <span class="text-xs text-[#FF6B00] font-medium">Last 24 hours</span>
        </div>
        <div class="space-y-4">
            <div class="flex items-center text-sm">
                <div class="w-2 h-2 bg-[#FF6B00] rounded-full mr-3"></div>
                <span class="text-gray-600">System is running normally</span>
                <span class="ml-auto text-gray-400 text-xs">Just now</span>
            </div>
            <div class="flex items-center text-sm">
                <div class="w-2 h-2 bg-[#1E3A5F] rounded-full mr-3"></div>
                <span class="text-gray-600">Dashboard accessed</span>
                <span class="ml-auto text-gray-400 text-xs">2 minutes ago</span>
            </div>
            <div class="flex items-center text-sm">
                <div class="w-2 h-2 bg-[#1E3A5F] rounded-full mr-3"></div>
                <span class="text-gray-600">User management updated</span>
                <span class="ml-auto text-gray-400 text-xs">15 minutes ago</span>
            </div>
        </div>
    </div>
</div>