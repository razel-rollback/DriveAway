@model IEnumerable<DriveAway.Models.Vehicle>
@using DriveAway.Models
@{
    ViewData["Title"] = "Vehicle Status Report";
}


<div class="space-y-6">

   

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 no-print">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Vehicle Status Report</h1>
            <p class="text-sm text-gray-500 mt-0.5">Current status of each vehicle in the fleet</p>
        </div>
        <partial name="_ExportButtons" model='new { ReportName = "Vehicle Status" }' />
    </div>

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        @{
            var statusGroups = new (string Label, VehicleStatus Status, string Color)[]
            {
                ("Available", VehicleStatus.Available, "text-green-600"),
                ("Rented", VehicleStatus.Rented, "text-blue-600"),
                ("Reserved", VehicleStatus.Reserved, "text-purple-600"),
                ("Under Maintenance", VehicleStatus.UnderMaintenance, "text-amber-600"),
                ("Out of Service", VehicleStatus.OutOfService, "text-red-600"),
                ("Retired", VehicleStatus.Retired, "text-gray-500"),
            };
        }
        @foreach (var sg in statusGroups)
        {
            var count = Model.Count(v => v.Status == sg.Status);
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium leading-snug">@sg.Label</p>
                <p class="text-2xl font-bold mt-1 @sg.Color">@count</p>
            </div>
        }
    </div>

    @* ── Table ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3 no-print">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Vehicle Statuses</h2>
            <select id="statusFilter"
                    class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                <option value="">All Statuses</option>
                <option value="available">Available</option>
                <option value="rented">Rented</option>
                <option value="reserved">Reserved</option>
                <option value="undermaintenance">Under Maintenance</option>
                <option value="outofservice">Out of Service</option>
                <option value="retired">Retired</option>
            </select>
            <input id="tableSearch" type="text" placeholder="Search plate, model, branch…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No vehicles found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm report-table">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">#</th>
                            <th class="px-5 py-3 text-left">Plate Number</th>
                            <th class="px-5 py-3 text-left">Make / Model</th>
                            <th class="px-5 py-3 text-left">Year</th>
                            <th class="px-5 py-3 text-left">Category</th>
                            <th class="px-5 py-3 text-left">Branch</th>
                            <th class="px-5 py-3 text-left">Mileage (km)</th>
                            <th class="px-5 py-3 text-left">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ var rowNum = 0; }
                        @foreach (var v in Model)
                        {
                            rowNum++;
                            var statusBadge = v.Status switch
                            {
                                VehicleStatus.Available => "bg-green-100 text-green-700",
                                VehicleStatus.Rented => "bg-blue-100 text-blue-700",
                                VehicleStatus.Reserved => "bg-purple-100 text-purple-700",
                                VehicleStatus.UnderMaintenance => "bg-amber-100 text-amber-700",
                                VehicleStatus.OutOfService => "bg-red-100 text-red-700",
                                VehicleStatus.Retired => "bg-gray-100 text-gray-500",
                                _ => "bg-gray-100 text-gray-500"
                            };

                            var statusText = v.Status switch
                            {
                                VehicleStatus.UnderMaintenance => "Under Maintenance",
                                VehicleStatus.OutOfService => "Out of Service",
                                _ => v.Status.ToString()
                            };

                            <tr class="hover:bg-gray-50 transition-colors report-row"
                                data-search="@($"{v.PlateNumber} {v.Make} {v.Model} {v.Category} {v.Branch?.Name}".ToLower())"
                                data-status="@v.Status.ToString().ToLower()">
                                <td class="px-5 py-3.5 text-gray-400">@rowNum</td>
                                <td class="px-5 py-3.5 font-semibold text-gray-800">@v.PlateNumber</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-medium text-gray-800">@v.Make @v.Model</span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@v.Year</td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Category ?? "—")</td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Branch?.Name ?? "—")</td>
                                <td class="px-5 py-3.5 text-gray-600">@v.CurrentMileage.ToString("N0")</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusBadge">
                                        @statusText
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No vehicles match your filter.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    function applyFilters() {
        const q = document.getElementById('tableSearch').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        let visible = 0;

        document.querySelectorAll('.report-row').forEach(row => {
            const matchSearch = row.dataset.search.includes(q);
            const matchStatus = !status || row.dataset.status === status;
            const show = matchSearch && matchStatus;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const noResults = document.getElementById('noResults');
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    document.getElementById('tableSearch')?.addEventListener('input', applyFilters);
    document.getElementById('statusFilter')?.addEventListener('change', applyFilters);
</script>
}
