@model IEnumerable<DriveAway.Models.Vehicle>
@using DriveAway.Models
@{
    ViewData["Title"] = "Asset Depreciation Report";
    var depData = (IEnumerable<dynamic>)ViewBag.DepreciationData;
}

<div class="space-y-6">

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Asset Depreciation Report</h1>
            <p class="text-sm text-gray-500 mt-0.5">Analyzes the decrease in vehicle value over time using straight-line depreciation</p>
        </div>
        <partial name="_ExportButtons" model='new { ReportName = "Asset Depreciation" }' />
    </div>

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Total Fleet Value</p>
            <p class="text-2xl font-bold mt-1 text-gray-800">₱@(((decimal)ViewBag.TotalPurchaseCost).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Current Book Value</p>
            <p class="text-2xl font-bold mt-1 text-green-600">₱@(((decimal)ViewBag.TotalBookValue).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Total Depreciation</p>
            <p class="text-2xl font-bold mt-1 text-red-600">₱@(((decimal)ViewBag.TotalDepreciation).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Avg Fleet Age</p>
            <p class="text-2xl font-bold mt-1 text-blue-600">@(((double)ViewBag.AvgAge).ToString("F1")) yrs</p>
        </div>
    </div>

    @* ── Table ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Depreciation Analysis</h2>
            <input id="tableSearch" type="text" placeholder="Search plate, model…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!depData.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No vehicles found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">#</th>
                            <th class="px-5 py-3 text-left">Vehicle</th>
                            <th class="px-5 py-3 text-left">Branch</th>
                            <th class="px-5 py-3 text-right">Purchase Cost</th>
                            <th class="px-5 py-3 text-right">Salvage Value</th>
                            <th class="px-5 py-3 text-left">Useful Life</th>
                            <th class="px-5 py-3 text-left">Age (yrs)</th>
                            <th class="px-5 py-3 text-right">Annual Dep.</th>
                            <th class="px-5 py-3 text-right">Total Dep.</th>
                            <th class="px-5 py-3 text-right">Book Value</th>
                            <th class="px-5 py-3 text-left">Dep. %</th>
                            <th class="px-5 py-3 text-left">Remaining Life</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ var rowNum = 0; }
                        @foreach (var d in depData)
                        {
                            rowNum++;
                            var v = (Vehicle)d.Vehicle;
                            var depPct = (decimal)d.DepreciationPct;

                            var barColor = depPct < 30 ? "bg-green-500"
                                : depPct < 60 ? "bg-amber-500"
                                : depPct < 90 ? "bg-orange-500"
                                : "bg-red-500";

                            <tr class="hover:bg-gray-50 transition-colors report-row"
                                data-search="@($"{v.PlateNumber} {v.Make} {v.Model} {v.Branch?.Name}".ToLower())">
                                <td class="px-5 py-3.5 text-gray-400">@rowNum</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-semibold text-gray-800">@v.PlateNumber</span>
                                    <span class="text-gray-500 text-xs block">@v.Year @v.Make @v.Model</span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Branch?.Name ?? "—")</td>
                                <td class="px-5 py-3.5 text-right text-gray-700">₱@v.PurchaseCost.ToString("N2")</td>
                                <td class="px-5 py-3.5 text-right text-gray-600">₱@v.SalvageValue.ToString("N2")</td>
                                <td class="px-5 py-3.5 text-gray-600">@v.UsefulLifeYears yrs</td>
                                <td class="px-5 py-3.5 text-gray-600">@d.AgeYears</td>
                                <td class="px-5 py-3.5 text-right text-gray-600">₱@(((decimal)d.AnnualDepreciation).ToString("N2"))</td>
                                <td class="px-5 py-3.5 text-right font-medium text-red-600">₱@(((decimal)d.TotalDepreciation).ToString("N2"))</td>
                                <td class="px-5 py-3.5 text-right font-medium text-green-700">₱@(((decimal)d.BookValue).ToString("N2"))</td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-2">
                                        <div class="w-16 bg-gray-200 rounded-full h-2">
                                            <div class="@barColor h-2 rounded-full" style="width: @(Math.Min(100, depPct))%"></div>
                                        </div>
                                        <span class="text-xs text-gray-600">@depPct%</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@d.RemainingLife yrs</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No vehicles match your search.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('tableSearch')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        let visible = 0;
        document.querySelectorAll('.report-row').forEach(row => {
            const show = row.dataset.search.includes(q);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        const nr = document.getElementById('noResults');
        if (nr) nr.classList.toggle('hidden', visible > 0);
    });
</script>
}
