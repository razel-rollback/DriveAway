@model IEnumerable<DriveAway.Models.Vehicle>
@using DriveAway.Models
@{
    ViewData["Title"] = "Maintenance Cost Analysis";
    var costData = (IEnumerable<dynamic>)ViewBag.CostData;
}

<div class="space-y-6">

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Maintenance Cost Analysis</h1>
            <p class="text-sm text-gray-500 mt-0.5">Analyzes total maintenance expenses per vehicle to identify high-cost assets</p>
        </div>
    </div>

    @* ── Date Filter ── *@
    <partial name="_DateFilter" />

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Total Fleet Maintenance</p>
            <p class="text-2xl font-bold mt-1 text-gray-800">₱@(((decimal)ViewBag.FleetTotalCost).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Repair Labor Cost</p>
            <p class="text-2xl font-bold mt-1 text-blue-600">₱@(((decimal)ViewBag.FleetRepairCost).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Parts Cost</p>
            <p class="text-2xl font-bold mt-1 text-amber-600">₱@(((decimal)ViewBag.FleetPartsCost).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">High-Cost Assets (&gt;10%)</p>
            <p class="text-2xl font-bold mt-1 text-red-600">@ViewBag.HighCostCount</p>
        </div>
    </div>

    @* ── Table ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Cost per Vehicle</h2>
            <input id="tableSearch" type="text" placeholder="Search plate, model…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!costData.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No vehicles found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">#</th>
                            <th class="px-5 py-3 text-left">Vehicle</th>
                            <th class="px-5 py-3 text-left">Branch</th>
                            <th class="px-5 py-3 text-right">Purchase Cost</th>
                            <th class="px-5 py-3 text-center">Total Jobs</th>
                            <th class="px-5 py-3 text-center">Completed</th>
                            <th class="px-5 py-3 text-right">Repair Cost</th>
                            <th class="px-5 py-3 text-right">Parts Cost</th>
                            <th class="px-5 py-3 text-right">Total Cost</th>
                            <th class="px-5 py-3 text-left">Cost % of Value</th>
                            <th class="px-5 py-3 text-left">Risk</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ var rowNum = 0; }
                        @foreach (var c in costData)
                        {
                            rowNum++;
                            var v = (Vehicle)c.Vehicle;
                            var pct = (decimal)c.CostPercentOfValue;
                            var totalCost = (decimal)c.TotalCost;

                            var barColor = pct < 5 ? "bg-green-500"
                                : pct < 10 ? "bg-amber-500"
                                : pct < 20 ? "bg-orange-500"
                                : "bg-red-500";

                            var riskBadge = pct < 5 ? "bg-green-100 text-green-700"
                                : pct < 10 ? "bg-amber-100 text-amber-700"
                                : pct < 20 ? "bg-orange-100 text-orange-700"
                                : "bg-red-100 text-red-700";

                            var riskLabel = pct < 5 ? "Low"
                                : pct < 10 ? "Moderate"
                                : pct < 20 ? "High"
                                : "Critical";

                            <tr class="hover:bg-gray-50 transition-colors report-row @(pct > 10 ? "bg-red-50/30" : "")"
                                data-search="@($"{v.PlateNumber} {v.Make} {v.Model} {v.Branch?.Name}".ToLower())">
                                <td class="px-5 py-3.5 text-gray-400">@rowNum</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-semibold text-gray-800">@v.PlateNumber</span>
                                    <span class="text-gray-500 text-xs block">@v.Year @v.Make @v.Model</span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Branch?.Name ?? "—")</td>
                                <td class="px-5 py-3.5 text-right text-gray-600">₱@v.PurchaseCost.ToString("N2")</td>
                                <td class="px-5 py-3.5 text-center font-medium text-gray-800">@c.TotalJobs</td>
                                <td class="px-5 py-3.5 text-center text-green-600">@c.CompletedJobs</td>
                                <td class="px-5 py-3.5 text-right text-gray-700">₱@(((decimal)c.RepairCost).ToString("N2"))</td>
                                <td class="px-5 py-3.5 text-right text-gray-700">₱@(((decimal)c.PartsCost).ToString("N2"))</td>
                                <td class="px-5 py-3.5 text-right font-semibold @(pct > 10 ? "text-red-600" : "text-gray-800")">₱@totalCost.ToString("N2")</td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-2">
                                        <div class="w-16 bg-gray-200 rounded-full h-2">
                                            <div class="@barColor h-2 rounded-full" style="width: @(Math.Min(100, pct))%"></div>
                                        </div>
                                        <span class="text-xs text-gray-600">@pct%</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (totalCost > 0)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @riskBadge">
                                            @riskLabel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No vehicles match your search.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('tableSearch')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        let visible = 0;
        document.querySelectorAll('.report-row').forEach(row => {
            const show = row.dataset.search.includes(q);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        const nr = document.getElementById('noResults');
        if (nr) nr.classList.toggle('hidden', visible > 0);
    });
</script>
}
