@using DriveAway.Models
@{
    ViewData["Title"] = "Payment Method Analysis";
    var byMethod = (IEnumerable<dynamic>)ViewBag.ByMethod;
    var byMethodType = (IEnumerable<dynamic>)ViewBag.ByMethodType;
    var monthlyTrend = (IEnumerable<dynamic>)ViewBag.MonthlyTrend;
    var totalAmount = (decimal)ViewBag.TotalAmount;
    var totalTransactions = (int)ViewBag.TotalTransactions;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Payment Method Analysis</h1>
            <p class="text-sm text-gray-500 mt-0.5">Distribution of payments between cash, online, and other methods</p>
        </div>
        <partial name="_ExportButtons" model='new { ReportName = "Payment Method Analysis" }' />
    </div>

    <partial name="_DateFilter" />

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Total Processed</p>
            <p class="text-2xl font-bold mt-1 text-gray-800">₱@totalAmount.ToString("N2")</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Transactions</p>
            <p class="text-2xl font-bold mt-1 text-blue-600">@totalTransactions</p>
        </div>
        @{
            var cashTotal = byMethod.Where(m => ((PaymentMethodType)m.Method) == PaymentMethodType.Cash).Sum((Func<dynamic, decimal>)(m => (decimal)m.Total));
            var onlineTotal = byMethod.Where(m => ((PaymentMethodType)m.Method) != PaymentMethodType.Cash).Sum((Func<dynamic, decimal>)(m => (decimal)m.Total));
        }
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Cash</p>
            <p class="text-2xl font-bold mt-1 text-green-600">₱@cashTotal.ToString("N2")</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Online / E-Wallet / Card</p>
            <p class="text-2xl font-bold mt-1 text-purple-600">₱@onlineTotal.ToString("N2")</p>
        </div>
    </div>

    @* ── Method Distribution ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">Payment Method Distribution</h2>
        </div>
        <div class="p-5">
            @if (byMethod.Any())
            {
                <div class="space-y-4">
                    @foreach (var m in byMethod)
                    {
                        var method = (PaymentMethodType)m.Method;
                        var amount = (decimal)m.Total;
                        var count = (int)m.Count;
                        var pct = totalAmount > 0 ? (amount / totalAmount) * 100 : 0;

                        var methodLabel = method switch
                        {
                            PaymentMethodType.Cash => "Cash",
                            PaymentMethodType.Online => "Online",
                            PaymentMethodType.CreditCard => "Credit Card",
                            PaymentMethodType.EWallet => "E-Wallet",
                            _ => method.ToString()
                        };
                        var barColor = method switch
                        {
                            PaymentMethodType.Cash => "bg-green-500",
                            PaymentMethodType.Online => "bg-blue-500",
                            PaymentMethodType.CreditCard => "bg-purple-500",
                            PaymentMethodType.EWallet => "bg-indigo-500",
                            _ => "bg-gray-400"
                        };
                        var dotColor = method switch
                        {
                            PaymentMethodType.Cash => "bg-green-500",
                            PaymentMethodType.Online => "bg-blue-500",
                            PaymentMethodType.CreditCard => "bg-purple-500",
                            PaymentMethodType.EWallet => "bg-indigo-500",
                            _ => "bg-gray-400"
                        };

                        <div>
                            <div class="flex justify-between items-center text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <div class="w-3 h-3 rounded-full @dotColor"></div>
                                    <span class="font-semibold text-gray-800">@methodLabel</span>
                                    <span class="text-xs text-gray-400">(@count transactions)</span>
                                </div>
                                <div class="text-right">
                                    <span class="font-bold text-gray-800">₱@amount.ToString("N2")</span>
                                    <span class="text-xs text-gray-400 ml-1">(@pct.ToString("F1")%)</span>
                                </div>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-3">
                                <div class="@barColor h-3 rounded-full transition-all duration-300" style="width: @pct%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-400 text-center py-6">No payment data.</p>
            }
        </div>
    </div>

    @* ── Breakdown by Method & Type ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">By Method & Payment Type</h2>
        </div>
        @if (byMethodType.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">Method</th>
                            <th class="px-5 py-3 text-left">Type</th>
                            <th class="px-5 py-3 text-center">Transactions</th>
                            <th class="px-5 py-3 text-right">Amount</th>
                            <th class="px-5 py-3 text-left">Share</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var mt in byMethodType)
                        {
                            var method = (PaymentMethodType)mt.Method;
                            var type = (PaymentType)mt.Type;
                            var amount = (decimal)mt.Total;
                            var pct = totalAmount > 0 ? (amount / totalAmount) * 100 : 0;

                            var methodLabel = method switch
                            {
                                PaymentMethodType.Cash => "Cash",
                                PaymentMethodType.Online => "Online",
                                PaymentMethodType.CreditCard => "Credit Card",
                                PaymentMethodType.EWallet => "E-Wallet",
                                _ => method.ToString()
                            };
                            var typeLabel = type switch
                            {
                                PaymentType.Rental => "Rental",
                                PaymentType.SecurityDeposit => "Deposit",
                                PaymentType.LateFee => "Late Fee",
                                PaymentType.DamageFee => "Damage Fee",
                                PaymentType.FuelFee => "Fuel Fee",
                                _ => type.ToString()
                            };
                            var typeBadge = type switch
                            {
                                PaymentType.Rental => "bg-blue-100 text-blue-700",
                                PaymentType.SecurityDeposit => "bg-purple-100 text-purple-700",
                                PaymentType.LateFee => "bg-red-100 text-red-700",
                                PaymentType.DamageFee => "bg-orange-100 text-orange-700",
                                PaymentType.FuelFee => "bg-amber-100 text-amber-700",
                                _ => "bg-gray-100 text-gray-600"
                            };

                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-5 py-3 font-medium text-gray-800">@methodLabel</td>
                                <td class="px-5 py-3">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @typeBadge">
                                        @typeLabel
                                    </span>
                                </td>
                                <td class="px-5 py-3 text-center text-gray-600">@mt.Count</td>
                                <td class="px-5 py-3 text-right font-bold text-gray-800">₱@amount.ToString("N2")</td>
                                <td class="px-5 py-3">
                                    <div class="flex items-center gap-2">
                                        <div class="w-12 bg-gray-200 rounded-full h-1.5">
                                            <div class="bg-gray-500 h-1.5 rounded-full" style="width: @pct%"></div>
                                        </div>
                                        <span class="text-xs text-gray-500">@pct.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-400 text-center py-10">No data.</p>
        }
    </div>

    @* ── Monthly Trend ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">Monthly Trend by Method</h2>
        </div>
        @if (monthlyTrend.Any())
        {
            var months = monthlyTrend
                .Select(t => (Year: (int)t.Year, Month: (int)t.Month))
                .Distinct()
                .OrderBy(m => m.Year).ThenBy(m => m.Month)
                .ToList();

            var methods = monthlyTrend
                .Select(t => (PaymentMethodType)t.Method)
                .Distinct()
                .ToList();

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">Month</th>
                            @foreach (var method in methods)
                            {
                                var label = method switch
                                {
                                    PaymentMethodType.Cash => "Cash",
                                    PaymentMethodType.Online => "Online",
                                    PaymentMethodType.CreditCard => "Card",
                                    PaymentMethodType.EWallet => "E-Wallet",
                                    _ => method.ToString()
                                };
                                <th class="px-5 py-3 text-right">@label</th>
                            }
                            <th class="px-5 py-3 text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var m in months)
                        {
                            var monthTotal = monthlyTrend
                                .Where(t => (int)t.Year == m.Year && (int)t.Month == m.Month)
                                .Sum((Func<dynamic, decimal>)(t => (decimal)t.Total));

                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-5 py-3 font-semibold text-gray-800">
                                    @(new DateTime(m.Year, m.Month, 1).ToString("MMM yyyy"))
                                </td>
                                @foreach (var method in methods)
                                {
                                    var val = monthlyTrend
                                        .Where(t => (int)t.Year == m.Year && (int)t.Month == m.Month && (PaymentMethodType)t.Method == method)
                                        .Sum((Func<dynamic, decimal>)(t => (decimal)t.Total));
                                    <td class="px-5 py-3 text-right text-gray-700 tabular-nums">
                                        @(val > 0 ? $"₱{val:N2}" : "—")
                                    </td>
                                }
                                <td class="px-5 py-3 text-right font-bold text-gray-800">₱@monthTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-400 text-center py-10">No monthly trend data.</p>
        }
    </div>
</div>
