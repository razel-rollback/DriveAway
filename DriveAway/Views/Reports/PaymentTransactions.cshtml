@model IEnumerable<DriveAway.Models.Payment>
@using DriveAway.Models
@{
    ViewData["Title"] = "Payment Transactions Report";
}



<div class="space-y-6">

    

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 no-print">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Payment Transactions Report</h1>
            <p class="text-sm text-gray-500 mt-0.5">All processed payments including cash, card, and e-wallet transactions</p>
        </div>
       
    </div>

    @* ── Date Filter ── *@
    <partial name="_DateFilter" />

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 no-print">
        @{
            var totalPayments = Model.Count();
            var cashPayments = Model.Where(p => p.PaymentMethod == PaymentMethodType.Cash).Sum(p => p.Amount);
            var onlinePayments = Model.Where(p => p.PaymentMethod == PaymentMethodType.Online).Sum(p => p.Amount);
            var paidTotal = Model.Where(p => p.PaymentStatus == PaymentStatus.Paid && p.PaymentType != PaymentType.DepositRefund).Sum(p => p.Amount);
            var pendingTotal = Model.Where(p => p.PaymentStatus == PaymentStatus.Pending).Sum(p => p.Amount);
        }
        @foreach (var (label, value, colorClass) in new (string, string, string)[] {
            ("Total Transactions", totalPayments.ToString(), "text-gray-800"),
            ("Cash Collected", $"₱{cashPayments:N2}", "text-green-600"),
            ("Online Collected", $"₱{onlinePayments:N2}", "text-blue-600"),
            ("Total Paid", $"₱{paidTotal:N2}", "text-emerald-600"),
            ("Pending", $"₱{pendingTotal:N2}", "text-amber-600"),
        })
        {
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium leading-snug">@label</p>
                <p class="text-2xl font-bold mt-1 @colorClass">@value</p>
            </div>
        }
    </div>

    @* ── Table ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3 no-print">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Payments</h2>
            <select id="methodFilter"
                    class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                <option value="">All Methods</option>
                <option value="cash">Cash</option>
                <option value="online">Online</option>
                <option value="creditcard">Credit Card</option>
                <option value="ewallet">E-Wallet</option>
            </select>
            <select id="statusFilter"
                    class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                <option value="">All Statuses</option>
                <option value="paid">Paid</option>
                <option value="pending">Pending</option>
            </select>
            <input id="tableSearch" type="text" placeholder="Search contract, notes…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No payment transactions found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm report-table">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">#</th>
                            <th class="px-5 py-3 text-left">Date</th>
                            <th class="px-5 py-3 text-left">Contract</th>
                            <th class="px-5 py-3 text-left">Vehicle</th>
                            <th class="px-5 py-3 text-left">Customer</th>
                            <th class="px-5 py-3 text-left">Type</th>
                            <th class="px-5 py-3 text-left">Method</th>
                            <th class="px-5 py-3 text-left">Amount</th>
                            <th class="px-5 py-3 text-left">Status</th>
                            <th class="px-5 py-3 text-left">Notes</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ var rowNum = 0; }
                        @foreach (var p in Model)
                        {
                            rowNum++;
                            var payStatusBadge = p.PaymentStatus switch
                            {
                                PaymentStatus.Paid => "bg-green-100 text-green-700",
                                PaymentStatus.Pending => "bg-amber-100 text-amber-700",
                                _ => "bg-gray-100 text-gray-500"
                            };

                            var typeBadge = p.PaymentType switch
                            {
                                PaymentType.Rental => "bg-blue-100 text-blue-700",
                                PaymentType.SecurityDeposit => "bg-purple-100 text-purple-700",
                                PaymentType.LateFee => "bg-red-100 text-red-700",
                                PaymentType.DamageFee => "bg-red-100 text-red-700",
                                PaymentType.FuelFee => "bg-amber-100 text-amber-700",
                                PaymentType.DepositRefund => "bg-green-100 text-green-700",
                                _ => "bg-gray-100 text-gray-500"
                            };

                            var typeText = p.PaymentType switch
                            {
                                PaymentType.SecurityDeposit => "Deposit",
                                PaymentType.LateFee => "Late Fee",
                                PaymentType.DamageFee => "Damage Fee",
                                PaymentType.FuelFee => "Fuel Fee",
                                PaymentType.DepositRefund => "Refund",
                                _ => p.PaymentType.ToString()
                            };

                            var methodText = p.PaymentMethod switch
                            {
                                PaymentMethodType.CreditCard => "Credit Card",
                                PaymentMethodType.EWallet => "E-Wallet",
                                _ => p.PaymentMethod.ToString()
                            };

                            <tr class="hover:bg-gray-50 transition-colors report-row"
                                data-search="@($"{p.RentalContract?.ContractNumber} {p.RentalContract?.CustomerName} {p.RentalContract?.Vehicle?.PlateNumber} {p.Notes}".ToLower())"
                                data-status="@p.PaymentStatus.ToString().ToLower()"
                                data-method="@p.PaymentMethod.ToString().ToLower()">
                                <td class="px-5 py-3.5 text-gray-400">@rowNum</td>
                                <td class="px-5 py-3.5 text-gray-600">@p.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td class="px-5 py-3.5 font-semibold text-gray-800">
                                    @(p.RentalContract?.ContractNumber ?? "—")
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (p.RentalContract?.Vehicle != null)
                                    {
                                        <span class="font-medium text-gray-800">@p.RentalContract.Vehicle.PlateNumber</span>
                                        <span class="text-gray-500 text-xs block">@p.RentalContract.Vehicle.Make @p.RentalContract.Vehicle.Model</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">
                                    @(p.RentalContract?.CustomerName ?? "—")
                                </td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @typeBadge">
                                        @typeText
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@methodText</td>
                                <td class="px-5 py-3.5 font-medium text-gray-800">₱@p.Amount.ToString("N2")</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @payStatusBadge">
                                        @p.PaymentStatus
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-500 text-xs max-w-xs truncate" title="@p.Notes">
                                    @(p.Notes ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No payments match your filter.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    function applyFilters() {
        const q = document.getElementById('tableSearch').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        const method = document.getElementById('methodFilter').value.toLowerCase();
        let visible = 0;

        document.querySelectorAll('.report-row').forEach(row => {
            const matchSearch = row.dataset.search.includes(q);
            const matchStatus = !status || row.dataset.status === status;
            const matchMethod = !method || row.dataset.method === method;
            const show = matchSearch && matchStatus && matchMethod;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const noResults = document.getElementById('noResults');
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    document.getElementById('tableSearch')?.addEventListener('input', applyFilters);
    document.getElementById('statusFilter')?.addEventListener('change', applyFilters);
    document.getElementById('methodFilter')?.addEventListener('change', applyFilters);
</script>
}
