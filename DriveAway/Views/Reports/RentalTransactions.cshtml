@model IEnumerable<DriveAway.Models.RentalContract>
@using DriveAway.Models
@{
    ViewData["Title"] = "Rental Transaction Report";
}



<div class="space-y-6">

    

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 no-print">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Rental Transaction Report</h1>
            <p class="text-sm text-gray-500 mt-0.5">All rental transactions with customer, vehicle, and payment details</p>
        </div>
        <partial name="_ExportButtons" model='new { ReportName = "Rental Transactions" }' />
    </div>

    @* ── Date Filter ── *@
    <partial name="_DateFilter" />

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 no-print">
        @{
            var totalContracts = Model.Count();
            var activeContracts = Model.Count(c => c.RentalStatus == RentalStatus.Active);
            var completedContracts = Model.Count(c => c.RentalStatus == RentalStatus.Completed);
            var totalRevenue = Model.Sum(c => c.FinalFee ?? c.TotalFee);
        }
        @foreach (var (label, value, colorClass) in new (string, string, string)[] {
            ("Total Transactions", totalContracts.ToString(), "text-gray-800"),
            ("Active", activeContracts.ToString(), "text-blue-600"),
            ("Completed", completedContracts.ToString(), "text-green-600"),
            ("Total Revenue", $"₱{totalRevenue:N2}", "text-emerald-600"),
        })
        {
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
                <p class="text-xs text-gray-500 font-medium leading-snug">@label</p>
                <p class="text-2xl font-bold mt-1 @colorClass">@value</p>
            </div>
        }
    </div>

    @* ── Table ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3 no-print">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Transactions</h2>
            <select id="statusFilter"
                    class="text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D] bg-white">
                <option value="">All Statuses</option>
                <option value="active">Active</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
            </select>
            <input id="tableSearch" type="text" placeholder="Search contract, customer, plate…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No rental transactions found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm report-table">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">#</th>
                            <th class="px-5 py-3 text-left">Contract #</th>
                            <th class="px-5 py-3 text-left">Customer</th>
                            <th class="px-5 py-3 text-left">Vehicle</th>
                            <th class="px-5 py-3 text-left">Check-Out</th>
                            <th class="px-5 py-3 text-left">Return Date</th>
                            <th class="px-5 py-3 text-left">Daily Rate</th>
                            <th class="px-5 py-3 text-left">Total Fee</th>
                            <th class="px-5 py-3 text-left">Payment Method</th>
                            <th class="px-5 py-3 text-left">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ var rowNum = 0; }
                        @foreach (var c in Model)
                        {
                            rowNum++;
                            var statusBadge = c.RentalStatus switch
                            {
                                RentalStatus.Active => "bg-blue-100 text-blue-700",
                                RentalStatus.Completed => "bg-green-100 text-green-700",
                                RentalStatus.Cancelled => "bg-gray-100 text-gray-500",
                                _ => "bg-gray-100 text-gray-500"
                            };

                            var rentalPayment = c.Payments?.FirstOrDefault(p => p.PaymentType == PaymentType.Rental);
                            var paymentMethodText = rentalPayment?.PaymentMethod switch
                            {
                                PaymentMethodType.Cash => "Cash",
                                PaymentMethodType.Online => "Online",
                                PaymentMethodType.CreditCard => "Credit Card",
                                PaymentMethodType.EWallet => "E-Wallet",
                                _ => "—"
                            };

                            <tr class="hover:bg-gray-50 transition-colors report-row"
                                data-search="@($"{c.ContractNumber} {c.CustomerName} {c.Vehicle?.PlateNumber} {c.Vehicle?.Make} {c.Vehicle?.Model}".ToLower())"
                                data-status="@c.RentalStatus.ToString().ToLower()">
                                <td class="px-5 py-3.5 text-gray-400">@rowNum</td>
                                <td class="px-5 py-3.5 font-semibold text-gray-800">@c.ContractNumber</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-medium text-gray-800">@c.CustomerName</span>
                                    <span class="text-gray-500 text-xs block">@c.CustomerContact</span>
                                </td>
                                <td class="px-5 py-3.5">
                                    @if (c.Vehicle != null)
                                    {
                                        <span class="font-medium text-gray-800">@c.Vehicle.PlateNumber</span>
                                        <span class="text-gray-500 text-xs block">@c.Vehicle.Make @c.Vehicle.Model</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@c.RentalStart.ToString("MMM d, yyyy")</td>
                                <td class="px-5 py-3.5 text-gray-600">
                                    @if (c.ActualReturn.HasValue)
                                    {
                                        @c.ActualReturn.Value.ToString("MMM d, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 italic">@c.RentalEnd.ToString("MMM d, yyyy") (expected)</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">₱@c.DailyRate.ToString("N2")</td>
                                <td class="px-5 py-3.5 font-medium text-gray-800">₱@((c.FinalFee ?? c.TotalFee).ToString("N2"))</td>
                                <td class="px-5 py-3.5 text-gray-600">@paymentMethodText</td>
                                <td class="px-5 py-3.5">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusBadge">
                                        @c.RentalStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No transactions match your filter.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    function applyFilters() {
        const q = document.getElementById('tableSearch').value.toLowerCase();
        const status = document.getElementById('statusFilter').value.toLowerCase();
        let visible = 0;

        document.querySelectorAll('.report-row').forEach(row => {
            const matchSearch = row.dataset.search.includes(q);
            const matchStatus = !status || row.dataset.status === status;
            const show = matchSearch && matchStatus;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const noResults = document.getElementById('noResults');
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    document.getElementById('tableSearch')?.addEventListener('input', applyFilters);
    document.getElementById('statusFilter')?.addEventListener('change', applyFilters);
</script>
}
