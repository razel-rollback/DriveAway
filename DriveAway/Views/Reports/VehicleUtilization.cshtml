@model IEnumerable<DriveAway.Models.Vehicle>
@using DriveAway.Models
@{
    ViewData["Title"] = "Vehicle Utilization Report";
    var utilData = (IEnumerable<dynamic>)ViewBag.UtilizationData;
}

<div class="space-y-6">

    @* ── Header ── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Vehicle Utilization Report</h1>
            <p class="text-sm text-gray-500 mt-0.5">Measures how frequently each vehicle is rented and calculates utilization rate</p>
        </div>
        <partial name="_ExportButtons" model='new { ReportName = "Vehicle Utilization" }' />
    </div>

    @* ── Date Filter ── *@
    <partial name="_DateFilter" />

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Fleet Size</p>
            <p class="text-2xl font-bold mt-1 text-gray-800">@Model.Count()</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Total Rentals</p>
            <p class="text-2xl font-bold mt-1 text-blue-600">@ViewBag.TotalRentals</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Avg Utilization</p>
            <p class="text-2xl font-bold mt-1 text-emerald-600">@ViewBag.AvgUtilization%</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium leading-snug">Total Revenue</p>
            <p class="text-2xl font-bold mt-1 text-green-600">₱@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</p>
        </div>
    </div>

    @* ── Table ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center gap-3">
            <h2 class="text-sm font-semibold flex-1" style="color: #0B1E3D;">Utilization Analysis</h2>
            <input id="tableSearch" type="text" placeholder="Search plate, model…"
                   class="text-sm border border-gray-200 rounded-lg px-3 py-2 w-full sm:w-56 focus:outline-none focus:ring-1 focus:ring-[#0B1E3D]" />
        </div>

        @if (!utilData.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-gray-400">
                <p class="text-sm">No vehicles found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">#</th>
                            <th class="px-5 py-3 text-left">Vehicle</th>
                            <th class="px-5 py-3 text-left">Branch</th>
                            <th class="px-5 py-3 text-left">Category</th>
                            <th class="px-5 py-3 text-center">Total Rentals</th>
                            <th class="px-5 py-3 text-center">Active</th>
                            <th class="px-5 py-3 text-center">Completed</th>
                            <th class="px-5 py-3 text-center">Rental Days</th>
                            <th class="px-5 py-3 text-center">Available Days</th>
                            <th class="px-5 py-3 text-left">Utilization</th>
                            <th class="px-5 py-3 text-right">Revenue</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ var rowNum = 0; }
                        @foreach (var u in utilData.OrderByDescending((Func<dynamic, object>)(x => (double)x.UtilizationRate)))
                        {
                            rowNum++;
                            var v = (Vehicle)u.Vehicle;
                            var rate = (double)u.UtilizationRate;

                            var barColor = rate >= 70 ? "bg-green-500"
                                : rate >= 40 ? "bg-amber-500"
                                : rate >= 20 ? "bg-orange-500"
                                : "bg-red-400";

                            var rateLabel = rate >= 70 ? "High"
                                : rate >= 40 ? "Medium"
                                : rate >= 20 ? "Low"
                                : "Very Low";

                            <tr class="hover:bg-gray-50 transition-colors report-row"
                                data-search="@($"{v.PlateNumber} {v.Make} {v.Model} {v.Category} {v.Branch?.Name}".ToLower())">
                                <td class="px-5 py-3.5 text-gray-400">@rowNum</td>
                                <td class="px-5 py-3.5">
                                    <span class="font-semibold text-gray-800">@v.PlateNumber</span>
                                    <span class="text-gray-500 text-xs block">@v.Year @v.Make @v.Model</span>
                                </td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Branch?.Name ?? "—")</td>
                                <td class="px-5 py-3.5 text-gray-600">@(v.Category ?? "—")</td>
                                <td class="px-5 py-3.5 text-center font-medium text-gray-800">@u.TotalRentals</td>
                                <td class="px-5 py-3.5 text-center text-blue-600">@u.ActiveRentals</td>
                                <td class="px-5 py-3.5 text-center text-green-600">@u.CompletedRentals</td>
                                <td class="px-5 py-3.5 text-center text-gray-700">@u.TotalRentalDays</td>
                                <td class="px-5 py-3.5 text-center text-gray-500">@u.AvailableDays</td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-2">
                                        <div class="w-20 bg-gray-200 rounded-full h-2">
                                            <div class="@barColor h-2 rounded-full" style="width: @rate%"></div>
                                        </div>
                                        <span class="text-xs font-medium text-gray-700">@rate%</span>
                                    </div>
                                    <span class="text-[10px] text-gray-400">@rateLabel</span>
                                </td>
                                <td class="px-5 py-3.5 text-right font-medium text-gray-800">₱@(((decimal)u.TotalRevenue).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noResults" class="hidden py-10 text-center text-sm text-gray-400">No vehicles match your search.</div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('tableSearch')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        let visible = 0;
        document.querySelectorAll('.report-row').forEach(row => {
            const show = row.dataset.search.includes(q);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        const nr = document.getElementById('noResults');
        if (nr) nr.classList.toggle('hidden', visible > 0);
    });
</script>
}
