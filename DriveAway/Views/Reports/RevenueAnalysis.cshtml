@using DriveAway.Models
@{
    ViewData["Title"] = "Revenue Analysis Report";
    var dailyRevenue = (IEnumerable<dynamic>)ViewBag.DailyRevenue;
    var monthlyRevenue = (IEnumerable<dynamic>)ViewBag.MonthlyRevenue;
    var revenueByType = (IEnumerable<dynamic>)ViewBag.RevenueByType;
    var peakDay = ViewBag.PeakDay;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold" style="color: #0B1E3D;">Revenue Analysis Report</h1>
            <p class="text-sm text-gray-500 mt-0.5">Total revenue generated over time — daily, monthly, and by type</p>
        </div>
    </div>

    <partial name="_DateFilter" />

    @* ── Summary Cards ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Total Revenue</p>
            <p class="text-2xl font-bold mt-1 text-green-600">₱@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Transactions</p>
            <p class="text-2xl font-bold mt-1 text-gray-800">@ViewBag.TransactionCount</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Avg per Transaction</p>
            <p class="text-2xl font-bold mt-1 text-blue-600">₱@(((decimal)ViewBag.AvgTransaction).ToString("N2"))</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm px-4 py-3">
            <p class="text-xs text-gray-500 font-medium">Peak Day</p>
            @if (peakDay != null)
            {
                <p class="text-lg font-bold mt-1 text-amber-600">₱@(((decimal)peakDay.Total).ToString("N2"))</p>
                <p class="text-[10px] text-gray-400">@(((DateTime)peakDay.Date).ToString("MMM d, yyyy"))</p>
            }
            else
            {
                <p class="text-2xl font-bold mt-1 text-gray-400">—</p>
            }
        </div>
    </div>

    @* ── Revenue by Type ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">Revenue by Type</h2>
        </div>
        <div class="p-5">
            @if (revenueByType.Any())
            {
                var grandTotal = (decimal)ViewBag.TotalRevenue;
                <div class="space-y-3">
                    @foreach (var r in revenueByType)
                    {
                        var pct = grandTotal > 0 ? ((decimal)r.Total / grandTotal) * 100 : 0;
                        var typeLabel = ((PaymentType)r.Type) switch
                        {
                            PaymentType.Rental => "Rental Fees",
                            PaymentType.LateFee => "Late Fees",
                            PaymentType.DamageFee => "Damage Fees",
                            PaymentType.FuelFee => "Fuel Fees",
                            _ => r.Type.ToString()
                        };
                        var barColor = ((PaymentType)r.Type) switch
                        {
                            PaymentType.Rental => "bg-blue-500",
                            PaymentType.LateFee => "bg-red-500",
                            PaymentType.DamageFee => "bg-orange-500",
                            PaymentType.FuelFee => "bg-amber-500",
                            _ => "bg-gray-400"
                        };
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="font-medium text-gray-700">@typeLabel</span>
                                <span class="text-gray-600">₱@(((decimal)r.Total).ToString("N2")) <span class="text-gray-400">(@pct.ToString("F1")%)</span></span>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-2.5">
                                <div class="@barColor h-2.5 rounded-full" style="width: @pct%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-400 text-center py-6">No revenue data available.</p>
            }
        </div>
    </div>

    @* ── Monthly Revenue ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">Monthly Revenue</h2>
        </div>
        @if (monthlyRevenue.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-5 py-3 text-left">Month</th>
                            <th class="px-5 py-3 text-center">Transactions</th>
                            <th class="px-5 py-3 text-right">Revenue</th>
                            <th class="px-5 py-3 text-left">Bar</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{
                            var maxMonthly = monthlyRevenue.Max((Func<dynamic, decimal>)(m => (decimal)m.Total));
                        }
                        @foreach (var m in monthlyRevenue)
                        {
                            var barW = maxMonthly > 0 ? ((decimal)m.Total / maxMonthly) * 100 : 0;
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-5 py-3.5 font-semibold text-gray-800">
                                    @(new DateTime((int)m.Year, (int)m.Month, 1).ToString("MMM yyyy"))
                                </td>
                                <td class="px-5 py-3.5 text-center text-gray-600">@m.Count</td>
                                <td class="px-5 py-3.5 text-right font-bold text-gray-800">₱@(((decimal)m.Total).ToString("N2"))</td>
                                <td class="px-5 py-3.5">
                                    <div class="w-32 bg-gray-100 rounded-full h-2">
                                        <div class="bg-green-500 h-2 rounded-full" style="width: @barW%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-400 text-center py-10">No monthly data.</p>
        }
    </div>

    @* ── Daily Revenue ── *@
    <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-sm font-semibold" style="color: #0B1E3D;">Daily Revenue</h2>
            <span class="text-xs text-gray-400">@dailyRevenue.Count() day(s)</span>
        </div>
        @if (dailyRevenue.Any())
        {
            <div class="overflow-x-auto max-h-[400px] overflow-y-auto">
                <table class="min-w-full divide-y divide-gray-100 text-sm">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider sticky top-0">
                        <tr>
                            <th class="px-5 py-3 text-left">Date</th>
                            <th class="px-5 py-3 text-center">Transactions</th>
                            <th class="px-5 py-3 text-right">Revenue</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var d in dailyRevenue.Reverse())
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-5 py-3 font-medium text-gray-800">@(((DateTime)d.Date).ToString("ddd, MMM d, yyyy"))</td>
                                <td class="px-5 py-3 text-center text-gray-600">@d.Count</td>
                                <td class="px-5 py-3 text-right font-bold text-gray-800">₱@(((decimal)d.Total).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-400 text-center py-10">No daily data.</p>
        }
    </div>
</div>
