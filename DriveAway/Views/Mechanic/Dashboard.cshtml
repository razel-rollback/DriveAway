@using DriveAway.Models
@{
    ViewData["Title"] = "Mechanic Dashboard";
    var jobs = (List<MaintenanceJob>)Model;
    var activeJobs = jobs.Where(j => j.JobStatus != MaintenanceJobStatus.Completed).ToList();
    var completedJobs = jobs.Where(j => j.JobStatus == MaintenanceJobStatus.Completed).ToList();

    string SeverityBadge(DamageSeverity s) => s switch
    {
        DamageSeverity.Minor => "bg-amber-100 text-amber-700",
        DamageSeverity.Major => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-gray-500"
    };

    string StatusBadge(MaintenanceJobStatus s) => s switch
    {
        MaintenanceJobStatus.Assigned => "bg-blue-100 text-blue-700",
        MaintenanceJobStatus.InProgress => "bg-purple-100 text-purple-700",
        MaintenanceJobStatus.Completed => "bg-green-100 text-green-700",
        _ => "bg-gray-100 text-gray-500"
    };
}

@model List<MaintenanceJob>

<div class="space-y-6">
    <!-- Header -->
    <div class="rounded-xl p-8 shadow-md text-white" style="background: linear-gradient(135deg, #0B1E3D 0%, #1E3A5F 60%, #2a4a72 100%);">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">Mechanic Dashboard</h1>
                <p class="text-gray-300 text-lg">Your assigned repair jobs</p>
                <div class="mt-4 flex items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white/15 text-white/90">
                        <span class="inline-block w-1.5 h-1.5 bg-[#FF6B00] rounded-full mr-1.5 animate-pulse"></span>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </span>
                </div>
            </div>
            <div class="hidden md:block">
                <div class="bg-[#FF6B00]/20 rounded-xl p-5">
                    <svg class="h-14 w-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 text-sm px-4 py-3 rounded-lg">
            <svg class="h-5 w-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            @TempData["Success"]
        </div>
    }

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Total Jobs</p>
            <p class="text-3xl font-bold text-gray-800">@ViewBag.Total</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Assigned</p>
            <p class="text-3xl font-bold text-blue-600">@ViewBag.Assigned</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">In Progress</p>
            <p class="text-3xl font-bold text-purple-600">@ViewBag.InProgress</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Completed</p>
            <p class="text-3xl font-bold text-green-600">@ViewBag.Completed</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
        <h2 class="text-lg font-semibold text-[#0B1E3D] mb-4">Quick Actions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a asp-action="Dashboard"
               class="flex items-center gap-4 p-5 rounded-xl border-2 border-[#FF6B00]/20 bg-[#FF6B00]/5 hover:bg-[#FF6B00] hover:text-white hover:border-[#FF6B00] transition-all duration-200 group">
                <div class="h-12 w-12 rounded-lg bg-[#FF6B00]/15 group-hover:bg-white/20 flex items-center justify-center flex-shrink-0 transition-colors">
                    <svg class="h-6 w-6 text-[#FF6B00] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-[#0B1E3D] group-hover:text-white transition-colors">My Active Jobs</p>
                    <p class="text-xs text-gray-500 group-hover:text-white/80 transition-colors">View assigned & in-progress</p>
                </div>
            </a>
            <a asp-action="History"
               class="flex items-center gap-4 p-5 rounded-xl border-2 border-[#0B1E3D]/10 bg-[#0B1E3D]/5 hover:bg-[#0B1E3D] hover:text-white hover:border-[#0B1E3D] transition-all duration-200 group">
                <div class="h-12 w-12 rounded-lg bg-[#0B1E3D]/10 group-hover:bg-white/20 flex items-center justify-center flex-shrink-0 transition-colors">
                    <svg class="h-6 w-6 text-[#0B1E3D] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-[#0B1E3D] group-hover:text-white transition-colors">Repair History</p>
                    <p class="text-xs text-gray-500 group-hover:text-white/80 transition-colors">View completed jobs</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Active Jobs -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
        <h2 class="text-lg font-semibold text-[#0B1E3D] mb-4">Active Jobs</h2>

        @if (!activeJobs.Any())
        {
            <div class="text-center py-10">
                <svg class="h-10 w-10 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-sm text-gray-400">No active jobs assigned to you</p>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var job in activeJobs)
                {
                    <div class="flex items-center justify-between p-4 rounded-lg border border-gray-100 hover:border-[#FF6B00]/30 hover:bg-[#FF6B00]/5 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="h-10 w-10 rounded-lg flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
                                 style="background-color: @(job.DamageSeverity == DamageSeverity.Major ? "#ef4444" : "#f59e0b");">
                                @job.Vehicle.Make?.Substring(0, Math.Min(2, job.Vehicle.Make.Length)).ToUpper()
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-[#0B1E3D]">
                                    @job.Vehicle.PlateNumber — @job.Vehicle.Year @job.Vehicle.Make @job.Vehicle.Model
                                    <span class="ml-1.5 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium @SeverityBadge(job.DamageSeverity)">@job.DamageSeverity</span>
                                    <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium @StatusBadge(job.JobStatus)">@job.JobStatus</span>
                                </p>
                                <p class="text-xs text-gray-500">@(job.DamageDescription ?? "No description") @if (job.Vehicle.Branch != null) { <text>• @job.Vehicle.Branch.Name</text> }</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (job.JobStatus == MaintenanceJobStatus.Assigned)
                            {
                                <form asp-action="StartRepair" method="post">
                                    <input type="hidden" name="id" value="@job.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-white transition-colors" style="background-color: #7c3aed;">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                                        Start Repair
                                    </button>
                                </form>
                            }
                            else if (job.JobStatus == MaintenanceJobStatus.InProgress)
                            {
                                <a asp-action="CompleteRepair" asp-route-id="@job.Id"
                                   class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-white transition-colors" style="background-color: #0B1E3D;">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    Complete
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
