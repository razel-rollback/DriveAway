@model DriveAway.Models.CategoryRate

@{
    ViewData["Title"] = "Edit Category";
}

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="mx-auto h-14 w-14 rounded-lg flex items-center justify-center mb-4" style="background-color: #1E3A5F;">
                <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </div>
            <h2 class="text-2xl font-semibold" style="color: #1E3A5F;">Edit Category</h2>
            <p class="text-sm mt-1" style="color: #64748B;">Update category details and daily rate</p>
        </div>

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm" style="display:none"></div>

        <!-- Form Card -->
        <div class="bg-white rounded-lg border border-gray-100 p-8">
            <form asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="space-y-6">
                    <!-- Category Name -->
                    <div>
                        <label asp-for="Category" class="block text-sm font-medium mb-2" style="color: #1E3A5F;">Category Name</label>
                        <input asp-for="Category"
                               class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00] transition-colors"
                               placeholder="e.g. SUV, Sedan, Truck" />
                        <span asp-validation-for="Category" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Daily Rate -->
                    <div>
                        <label asp-for="DailyRate" class="block text-sm font-medium mb-2" style="color: #1E3A5F;">Daily Rate (₱)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 text-sm">₱</span>
                            <input asp-for="DailyRate" type="number" step="0.01" min="0.01"
                                   class="w-full pl-7 pr-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF6B00]/30 focus:border-[#FF6B00] transition-colors"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="DailyRate" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-between mt-8 pt-6 border-t border-gray-100">
                    <a asp-action="Index"
                       class="text-sm font-medium transition-colors"
                       style="color: #64748B;"
                       onmouseover="this.style.color='#1E3A5F'"
                       onmouseout="this.style.color='#64748B'">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-lg text-sm font-medium text-white transition-colors"
                            style="background-color: #1E3A5F;"
                            onmouseover="this.style.backgroundColor='#FF6B00'"
                            onmouseout="this.style.backgroundColor='#1E3A5F'">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
