@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DriveAway</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DriveAway.styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="sticky top-0 z-50">
        <nav class="shadow" style="background-color: #182F52;">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="flex h-16 items-center justify-between">
                    <a class="text-xl sm:text-2xl font-bold text-white transition-colors" asp-area="" asp-controller="Home" asp-action="Index" onmouseover="this.style.color='#FF6B00'" onmouseout="this.style.color='white'">
                        DriveAway
                    </a>

                    <!-- Desktop nav -->
                    <div class="hidden md:flex md:items-center md:gap-2">
                        <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="Home" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Home</a>
                        <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="Home" asp-action="Privacy" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Privacy</a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Super Admin"))
                            {
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="SuperAdmin" asp-action="Dashboard" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Dashboard</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="UserManagement" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">User Management</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="RoleManagement" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Role Management</a>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="Admin" asp-action="Dashboard" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Dashboard</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="UserManagement" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">User Management</a>
                                
                                <div class="relative group">
                                    <button class="text-white transition-colors font-medium px-3 py-2 rounded inline-flex items-center" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">
                                        Asset Lifecycle
                                        <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </button>
                                    <div class="absolute left-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden group-hover:block z-50">
                                        <div class="py-1" role="menu" aria-orientation="vertical" aria-labelledby="options-menu">
                                            <a asp-controller="AssetLifecycle" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Overview</a>
                                            <a asp-controller="AssetLifecycle" asp-action="Acquisition" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Acquisition</a>
                                            <a asp-controller="AssetLifecycle" asp-action="Registration" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Registration</a>
                                            <a asp-controller="AssetLifecycle" asp-action="Disposal" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Disposal</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <partial name="_LoginPartial" />
                    </div>

                    <!-- Mobile menu button -->
                    <button id="mobileMenuButton" type="button" class="md:hidden inline-flex items-center justify-center rounded p-2 text-white focus:outline-none focus:ring-2 transition-colors" style="--tw-ring-color: #FF6B00;" onmouseover="this.style.backgroundColor='#FF6B00'" onmouseout="this.style.backgroundColor='transparent'" aria-controls="mobileMenu" aria-expanded="false" aria-label="Open main menu">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>

                <!-- Mobile nav panel -->
                <div id="mobileMenu" class="md:hidden hidden pb-4">
                    <div class="flex flex-col gap-1 pt-2">
                        <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="Home" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Home</a>
                        <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="Home" asp-action="Privacy" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Privacy</a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Super Admin"))
                            {
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="SuperAdmin" asp-action="Dashboard" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Dashboard</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="UserManagement" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">User Management</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="RoleManagement" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Role Management</a>
                            }
                            else if(User.IsInRole("Admin"))
                            {
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="Admin" asp-action="Dashboard" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Dashboard</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="UserManagement" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">User Management</a>
                                <a class="text-white transition-colors font-medium px-3 py-2 rounded" asp-area="" asp-controller="AssetLifecycle" asp-action="Index" style="opacity: 0.9;" onmouseover="this.style.backgroundColor='#FF6B00'; this.style.opacity='1';" onmouseout="this.style.backgroundColor='transparent'; this.style.opacity='0.9';">Asset Lifecycle</a>
                            }
                        }

                        <div class="pb-4">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t bg-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 text-sm text-gray-600 flex items-center justify-between">
            <div>&copy; 2026 - DriveAway</div>
            <a class="font-medium transition-colors" style="color: #FF6B00;" onmouseover="this.style.color='#0B1E3D'" onmouseout="this.style.color='#FF6B00'" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script>
        (function () {
            const btn = document.getElementById('mobileMenuButton');
            const menu = document.getElementById('mobileMenu');
            if (!btn || !menu) return;

            btn.addEventListener('click', function () {
                const isHidden = menu.classList.contains('hidden');
                menu.classList.toggle('hidden');
                btn.setAttribute('aria-expanded', String(isHidden));
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
