@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DriveAway</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DriveAway.styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="sticky top-0 z-50">
        <nav class="shadow-lg backdrop-blur-md bg-[#0B1E3D]/95 border-b border-[#FF6B00]/10">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="flex h-16 items-center justify-between">
                    <!-- Logo -->
                    <a class="flex items-center gap-2 group" asp-area="" asp-controller="Home" asp-action="Index">
                         <span class="text-2xl font-extrabold text-white tracking-tight group-hover:text-[#FF6B00] transition-all duration-300">
                            DriveAway
                        </span>
                    </a>

                    <!-- Desktop nav -->
                    <div class="hidden md:flex md:items-center md:gap-1">
                        <a class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Super Admin"))
                            {
                                <a class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm" asp-controller="SuperAdmin" asp-action="Dashboard">Dashboard</a>
                                <a class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm" asp-controller="UserManagement" asp-action="Index">Users</a>
                                <a class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm" asp-controller="RoleManagement" asp-action="Index">Roles</a>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <a class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>

                                <!-- Asset Inventory Dropdown -->
                                <div class="relative">
                                    <button id="assetInventoryButton" type="button" aria-haspopup="true" aria-expanded="false" class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 focus:text-[#FF6B00] focus:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm inline-flex items-center">
                                        Asset Inventory
                                        <svg class="ml-1.5 h-4 w-4 opacity-70 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </button>
                                    <div id="assetInventoryMenu" class="absolute left-0 mt-2 w-56 hidden transform origin-top-left z-[1000]">
                                        <div class="rounded-lg shadow-xl ring-1 ring-black ring-opacity-5 overflow-hidden bg-white">
                                            <div class="py-1">
                                                <a asp-controller="AssetLifecycle" asp-action="Registration" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Asset Registration</a>
                                                <a asp-controller="AssetLifecycle" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Lifecycle Tracking</a>
                                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Asset Status Monitoring</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Rental Operations (Link) -->
                                <a href="#" class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm">Rental Operations</a>

                                <!-- Maintenance Tracker Dropdown -->
                                <div class="relative group">
                                    <button class="text-gray-100 group-hover:text-[#FF6B00] group-hover:bg-white/10 group-focus-within:text-[#FF6B00] group-focus-within:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm inline-flex items-center">
                                        Maintenance
                                        <svg class="ml-1.5 h-4 w-4 opacity-70 group-hover:rotate-180 group-focus-within:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </button>
                                    <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform origin-top-left z-[1000]">
                                         <div class="rounded-lg shadow-xl ring-1 ring-black ring-opacity-5 overflow-hidden bg-white">
                                            <div class="py-1">
                                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Maintenance Mgmt</a>
                                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Work Orders</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Finance & Accounting Dropdown -->
                                <div class="relative group">
                                    <button class="text-gray-100 group-hover:text-[#FF6B00] group-hover:bg-white/10 group-focus-within:text-[#FF6B00] group-focus-within:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm inline-flex items-center">
                                        Finance
                                        <svg class="ml-1.5 h-4 w-4 opacity-70 group-hover:rotate-180 group-focus-within:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </button>
                                    <div class="absolute right-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform origin-top-right z-[1000]">
                                         <div class="rounded-lg shadow-xl ring-1 ring-black ring-opacity-5 overflow-hidden bg-white">
                                            <div class="py-1">
                                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Asset Depreciation</a>
                                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Cost Analysis</a>
                                                <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#FF6B00] border-l-2 border-transparent hover:border-[#FF6B00] transition-colors">Financial Reporting</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <a href="#" class="text-gray-100 hover:text-[#FF6B00] hover:bg-white/10 transition-all duration-200 font-medium px-3 py-2 rounded-md text-sm">Reports</a>
                            }
                        }

                        <partial name="_LoginPartial" />
                    </div>

                    <!-- Mobile menu button -->
                    <button id="mobileMenuButton" type="button" class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-gray-200 hover:text-[#FF6B00] hover:bg-white/10 focus:outline-none transition-colors">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>

                <!-- Mobile nav panel -->
                <div id="mobileMenu" class="md:hidden hidden border-t border-gray-700/50 pb-4">
                    <div class="flex flex-col space-y-1 pt-2">
                        <a class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Super Admin"))
                            {
                                <a class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium" asp-controller="SuperAdmin" asp-action="Dashboard">Dashboard</a>
                                <a class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium" asp-controller="UserManagement" asp-action="Index">User Management</a>
                                <a class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium" asp-controller="RoleManagement" asp-action="Index">Role Management</a>
                            }
                            else if(User.IsInRole("Admin"))
                            {
                                <a class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                                <div class="px-3 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Asset Inventory</div>
                                <a asp-controller="AssetLifecycle" asp-action="Registration" class="block pl-6 pr-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-white/10">Registration</a>
                                <a asp-controller="AssetLifecycle" asp-action="Index" class="block pl-6 pr-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-white/10">Lifecycle</a>

                                <a href="#" class="text-gray-200 hover:bg-[#FF6B00] hover:text-white block px-3 py-2 rounded-md text-base font-medium">Rental Operations</a>
                                
                                <div class="px-3 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Maintenance</div>
                                <a href="#" class="block pl-6 pr-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-white/10">Maintenance Mgmt</a>

                                <div class="px-3 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">Finance</div>
                                <a href="#" class="block pl-6 pr-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-white/10">Depreciation</a>
                            }
                        }

                        <div class="pt-2 border-t border-gray-700/50">
                             <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t bg-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 text-sm text-gray-600 flex items-center justify-between">
            <div>&copy; 2026 - DriveAway</div>
            <a class="font-medium transition-colors" style="color: #FF6B00;" onmouseover="this.style.color='#0B1E3D'" onmouseout="this.style.color='#FF6B00'" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script>
        (function () {
            const btn = document.getElementById('mobileMenuButton');
            const menu = document.getElementById('mobileMenu');
            if (!btn || !menu) return;

            btn.addEventListener('click', function () {
                const isHidden = menu.classList.contains('hidden');
                menu.classList.toggle('hidden');
                btn.setAttribute('aria-expanded', String(isHidden));
            });
        })();

        (function () {
            const button = document.getElementById('assetInventoryButton');
            const menu = document.getElementById('assetInventoryMenu');
            if (!button || !menu) return;

            const setOpen = (open) => {
                menu.classList.toggle('hidden', !open);
                button.setAttribute('aria-expanded', String(open));

                const icon = button.querySelector('svg');
                if (icon) icon.classList.toggle('rotate-180', open);
            };

            button.addEventListener('click', (e) => {
                e.preventDefault();
                setOpen(menu.classList.contains('hidden'));
            });

            // Close when clicking outside
            document.addEventListener('click', (e) => {
                if (button.contains(e.target) || menu.contains(e.target)) return;
                setOpen(false);
            });

            // Close on Escape
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') setOpen(false);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
