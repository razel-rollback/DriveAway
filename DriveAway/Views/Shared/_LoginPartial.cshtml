@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="flex flex-col md:flex-row md:items-center md:space-x-4 mt-2 md:mt-0">
        <a class="text-white hover:text-blue-100 transition-colors font-medium py-2 px-3" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            Hello @User.Identity?.Name!
        </a>
        <form class="inline-block" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="text-white hover:text-blue-100 transition-colors font-medium py-2 px-4 rounded hover:bg-blue-700 bg-blue-800">
                Logout
            </button>
        </form>
    </div>
}
else
{
    <div class="flex flex-col md:flex-row md:items-center md:space-x-4 mt-2 md:mt-0">
        <a class="text-white hover:text-blue-100 transition-colors font-medium py-2 px-3 rounded hover:bg-blue-700" asp-area="Identity" asp-page="/Account/Register">
            Register
        </a>
        <a class="text-white hover:text-blue-100 transition-colors font-medium py-2 px-3 rounded hover:bg-blue-700" asp-area="Identity" asp-page="/Account/Login">
            Login
        </a>
    </div>
}
