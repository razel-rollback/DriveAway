@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Management";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header with Create Button -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-semibold text-[#1E3A5F]">Role Management</h1>
                <p class="text-sm text-gray-500 mt-1">Manage user roles and permissions</p>
            </div>
            <button onclick="document.getElementById('createRoleModal').classList.remove('hidden')"
                    class="inline-flex items-center justify-center mt-4 sm:mt-0 bg-[#1E3A5F] hover:bg-[#FF6B00] text-white font-medium py-2.5 px-5 rounded-lg transition-colors duration-200 shadow-sm">
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Create New Role
            </button>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border-l-4 border-[#1E3A5F] text-[#1E3A5F] px-4 py-3 rounded-lg mb-6 flex items-center shadow-sm" role="alert">
                <svg class="h-5 w-5 mr-2 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="block sm:inline">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded-lg mb-6 flex items-center shadow-sm" role="alert">
                <svg class="h-5 w-5 mr-2 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="block sm:inline">@TempData["Error"]</span>
            </div>
        }

        <!-- Roles Table Card -->
        <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <div class="flex items-center">
                                    <svg class="h-4 w-4 mr-1 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                    </svg>
                                    Role Name
                                </div>
                            </th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <div class="flex items-center">
                                    <svg class="h-4 w-4 mr-1 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path>
                                    </svg>
                                    Role ID
                                </div>
                            </th>
                            <th scope="col" class="px-6 py-4 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var role in Model)
                            {
                                <tr class="hover:bg-gray-50 transition-colors duration-150">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 h-10 w-10 bg-[#1E3A5F]/10 rounded-lg flex items-center justify-center">
                                                <svg class="h-5 w-5 text-[#1E3A5F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                                </svg>
                                            </div>
                                            <div class="ml-4">
                                                <div class="text-sm font-medium text-[#1E3A5F]">@role.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="text-xs text-gray-500 font-mono bg-gray-100 px-2 py-1 rounded">@role.Id</span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <div class="flex items-center justify-end space-x-3">
                                            @* Only Super Admin is protected from edit/delete. *@
                                            @if (role.Name != "Super Admin")
                                            {
                                                <!-- Edit Button -->
                                                <button onclick="openEditModal('@role.Id', '@role.Name')"
                                                        class="text-[#1E3A5F] hover:text-[#FF6B00] transition-colors duration-200 flex items-center"
                                                        title="Edit role">
                                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                         </svg>
                                                    <span class="ml-1">Edit</span>
                                                </button>

                                                <!-- Delete Button -->
                                                <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this role?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="text-gray-400 hover:text-red-600 transition-colors duration-200 flex items-center" title="Delete role">
                                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                        </svg>
                                                        <span class="ml-1">Delete</span>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                    System Role
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-8 text-center">
                                    <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                    </svg>
                                    <p class="text-lg font-medium text-[#1E3A5F]">No roles found</p>
                                    <p class="text-sm text-gray-500 mt-1">Create your first role to get started</p>
                                    <div class="mt-6">
                                        <button onclick="document.getElementById('createRoleModal').classList.remove('hidden')"
                                                class="inline-flex items-center px-4 py-2 bg-[#1E3A5F] hover:bg-[#FF6B00] text-white text-sm font-medium rounded-lg transition-colors duration-200">
                                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                            </svg>
                                            Create New Role
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Table Footer -->
            @if (Model != null && Model.Any())
            {
                <div class="bg-gray-50 px-6 py-3 border-t border-gray-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-500">Total roles: @Model.Count()</span>
                        <span class="text-xs text-gray-400">Protected roles cannot be edited or deleted</span>
                    </div>
                </div>
            }
        </div>

        <!-- Back to Dashboard -->
        <div class="mt-6">
            <a asp-controller="SuperAdmin" asp-action="Dashboard"
               class="inline-flex items-center text-[#1E3A5F] hover:text-[#FF6B00] font-medium transition-colors duration-200">
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Dashboard
            </a>
        </div>
    </div>
</div>

<!-- Create Role Modal -->
<div id="createRoleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4 border border-gray-100">
        <div class="flex justify-between items-center mb-5">
            <h2 class="text-xl font-semibold text-[#1E3A5F]">Create New Role</h2>
            <button onclick="document.getElementById('createRoleModal').classList.add('hidden')"
                    class="text-gray-400 hover:text-[#FF6B00] transition-colors">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-5">
                <label for="roleName" class="block text-sm font-medium text-gray-700 mb-2">Role Name</label>
                <input type="text"
                       id="roleName"
                       name="roleName"
                       required
                       class="block w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] transition-colors bg-gray-50/50 focus:bg-white text-gray-900"
                       placeholder="Enter role name (e.g., Manager, Editor)" />
            </div>
            <div class="flex space-x-3">
                <button type="submit"
                        class="flex-1 bg-[#1E3A5F] hover:bg-[#FF6B00] text-white px-6 py-2.5 rounded-lg transition-colors duration-200 font-medium">
                    Create Role
                </button>
                <button type="button"
                        onclick="document.getElementById('createRoleModal').classList.add('hidden')"
                        class="flex-1 bg-gray-100 text-gray-700 px-6 py-2.5 rounded-lg hover:bg-gray-200 transition-colors duration-200 font-medium">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Role Modal -->
<div id="editRoleModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4 border border-gray-100">
        <div class="flex justify-between items-center mb-5">
            <h2 class="text-xl font-semibold text-[#1E3A5F]">Edit Role</h2>
            <button onclick="document.getElementById('editRoleModal').classList.add('hidden')"
                    class="text-gray-400 hover:text-[#FF6B00] transition-colors">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editRoleId" name="id" />
            <div class="mb-5">
                <label for="editRoleName" class="block text-sm font-medium text-gray-700 mb-2">Role Name</label>
                <input type="text"
                       id="editRoleName"
                       name="roleName"
                       required
                       class="block w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-1 focus:ring-[#1E3A5F] focus:border-[#1E3A5F]"
                       placeholder="Enter role name" />
            </div>
            <button type="submit" class="bg-[#1E3A5F] hover:bg-[#FF6B00] text-white px-6 py-2.5 rounded-lg">
                Update Role
            </button>
        </form>
    </div>
</div>

<script>
    function openEditModal(roleId, roleName) {
        document.getElementById('editRoleId').value = roleId;
        document.getElementById('editRoleName').value = roleName;
        document.getElementById('editRoleModal').classList.remove('hidden');
    }

    // Close modals when clicking outside
    window.onclick = function(event) {
        var createModal = document.getElementById('createRoleModal');
        var editModal = document.getElementById('editRoleModal');

        if (event.target == createModal) {
            createModal.classList.add('hidden');
        }
        if (event.target == editModal) {
            editModal.classList.add('hidden');
        }
    }
</script>