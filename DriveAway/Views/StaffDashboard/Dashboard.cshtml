@using DriveAway.Models
@{
    ViewData["Title"] = "Staff Dashboard";
    var recentContracts = (List<RentalContract>?)ViewBag.RecentContracts ?? new List<RentalContract>();
}

<div class="space-y-8">

    @* ── Welcome Header ── *@
    <div class="rounded-xl p-8 shadow-md text-white" style="background: linear-gradient(135deg, #0B1E3D 0%, #1E3A5F 60%, #2a4a72 100%);">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">Rental Staff Dashboard</h1>
                <p class="text-gray-300 text-lg">Manage vehicle check-outs and returns from here</p>
                <div class="mt-4 flex items-center gap-3">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white/15 text-white/90">
                        <span class="inline-block w-1.5 h-1.5 bg-[#FF6B00] rounded-full mr-1.5 animate-pulse"></span>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </span>
                </div>
            </div>
            <div class="hidden md:block">
                <div class="bg-[#FF6B00]/20 rounded-xl p-5">
                    <svg class="h-14 w-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    @* ── KPI Cards ── *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">

        @* Available Vehicles *@
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="bg-green-50 rounded-lg p-2.5">
                    <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
            </div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Available</p>
            <p class="text-3xl font-bold text-green-600">@ViewBag.AvailableVehicles</p>
            <p class="text-xs text-gray-400 mt-1">Vehicles ready to rent</p>
        </div>

        @* Active Rentals *@
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="bg-blue-50 rounded-lg p-2.5">
                    <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Active Rentals</p>
            <p class="text-3xl font-bold text-blue-600">@ViewBag.ActiveRentals</p>
            <p class="text-xs text-gray-400 mt-1">Currently rented out</p>
        </div>

        @* Completed Today *@
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="bg-emerald-50 rounded-lg p-2.5">
                    <svg class="h-5 w-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Completed Today</p>
            <p class="text-3xl font-bold text-emerald-600">@ViewBag.CompletedToday</p>
            <p class="text-xs text-gray-400 mt-1">Returned today</p>
        </div>

        @* Overdue *@
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="bg-red-50 rounded-lg p-2.5">
                    <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.832c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                </div>
            </div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Overdue</p>
            <p class="text-3xl font-bold text-red-600">@ViewBag.Overdue</p>
            <p class="text-xs text-gray-400 mt-1">Past return date</p>
        </div>

        @* Monthly Revenue *@
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="bg-[#FF6B00]/10 rounded-lg p-2.5">
                    <svg class="h-5 w-5 text-[#FF6B00]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Monthly Revenue</p>
            <p class="text-3xl font-bold text-[#FF6B00]">₱@(((decimal)ViewBag.MonthlyRevenue).ToString("N0"))</p>
            <p class="text-xs text-gray-400 mt-1">@DateTime.Now.ToString("MMMM yyyy")</p>
        </div>
    </div>

    @* ── Quick Actions ── *@
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
        <h2 class="text-lg font-semibold text-[#0B1E3D] mb-5">Quick Actions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

            @* Rent Vehicle *@
            <a asp-controller="RentalOperations" asp-action="CheckOut"
               class="flex items-center gap-4 p-5 rounded-xl border-2 border-[#FF6B00]/20 bg-[#FF6B00]/5 hover:bg-[#FF6B00] hover:text-white hover:border-[#FF6B00] transition-all duration-200 group">
                <div class="h-12 w-12 rounded-lg bg-[#FF6B00]/15 group-hover:bg-white/20 flex items-center justify-center flex-shrink-0 transition-colors">
                    <svg class="h-6 w-6 text-[#FF6B00] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-[#0B1E3D] group-hover:text-white transition-colors">Rent Vehicle</p>
                    <p class="text-xs text-gray-500 group-hover:text-white/80 transition-colors">Process a new check-out</p>
                </div>
            </a>

            @* View All Contracts *@
            <a asp-controller="RentalOperations" asp-action="Index"
               class="flex items-center gap-4 p-5 rounded-xl border-2 border-[#0B1E3D]/10 bg-[#0B1E3D]/5 hover:bg-[#0B1E3D] hover:text-white hover:border-[#0B1E3D] transition-all duration-200 group">
                <div class="h-12 w-12 rounded-lg bg-[#0B1E3D]/10 group-hover:bg-white/20 flex items-center justify-center flex-shrink-0 transition-colors">
                    <svg class="h-6 w-6 text-[#0B1E3D] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-[#0B1E3D] group-hover:text-white transition-colors">All Contracts</p>
                    <p class="text-xs text-gray-500 group-hover:text-white/80 transition-colors">View &amp; manage contracts</p>
                </div>
            </a>

            @* Process Return *@
            <a asp-controller="RentalOperations" asp-action="Index"
               class="flex items-center gap-4 p-5 rounded-xl border-2 border-emerald-500/15 bg-emerald-50/50 hover:bg-emerald-600 hover:text-white hover:border-emerald-600 transition-all duration-200 group">
                <div class="h-12 w-12 rounded-lg bg-emerald-100 group-hover:bg-white/20 flex items-center justify-center flex-shrink-0 transition-colors">
                    <svg class="h-6 w-6 text-emerald-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-[#0B1E3D] group-hover:text-white transition-colors">Process Return</p>
                    <p class="text-xs text-gray-500 group-hover:text-white/80 transition-colors">Check-in a vehicle</p>
                </div>
            </a>
        </div>
    </div>

    @* ── Active Rentals List ── *@
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-lg font-semibold text-[#0B1E3D]">Active Rentals</h2>
            <a asp-controller="RentalOperations" asp-action="Index"
               class="text-xs font-medium text-[#FF6B00] hover:text-[#0B1E3D] transition-colors">View All →</a>
        </div>

        @if (!recentContracts.Any())
        {
            <div class="text-center py-10">
                <svg class="h-10 w-10 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <p class="text-sm text-gray-400">No active rentals right now</p>
                <a asp-controller="RentalOperations" asp-action="CheckOut" class="mt-2 inline-block text-sm font-semibold" style="color: #FF6B00;">Rent a vehicle →</a>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var c in recentContracts)
                {
                    var isOverdue = c.RentalEnd.Date < DateTime.UtcNow.Date;
                    <div class="flex items-center justify-between p-4 rounded-lg border border-gray-100 hover:border-[#FF6B00]/30 hover:bg-[#FF6B00]/5 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="h-10 w-10 rounded-lg flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
                                 style="background-color: @(isOverdue ? "#ef4444" : "#0B1E3D");">
                                @(c.Vehicle != null ? c.Vehicle.Make?.Substring(0, Math.Min(2, c.Vehicle.Make.Length)).ToUpper() : "—")
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-[#0B1E3D]">
                                    @c.ContractNumber
                                    @if (isOverdue)
                                    {
                                        <span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-red-100 text-red-700">OVERDUE</span>
                                    }
                                </p>
                                <p class="text-xs text-gray-500">
                                    @(c.Vehicle != null ? $"{c.Vehicle.PlateNumber} — {c.Vehicle.Make} {c.Vehicle.Model}" : "—")
                                    &bull; @c.CustomerName
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="text-right hidden sm:block">
                                <p class="text-xs font-medium text-gray-700">Due @c.RentalEnd.ToString("MMM d, yyyy")</p>
                                <p class="text-xs text-gray-400">₱@((c.FinalFee ?? c.TotalFee).ToString("N2"))</p>
                            </div>
                            <a asp-controller="RentalOperations" asp-action="CheckIn" asp-route-id="@c.Id"
                               class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:opacity-90"
                               style="background-color: #0B1E3D;">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                Return
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>
